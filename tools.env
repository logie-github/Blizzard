# Programs the importers run on the phone, built for arm64 by scripts/build-tools.sh into
# app/tools/jniLibs (git-ignored), where Android lets the app run them.
#
# blizzard-legacy-dl (MIT): fetches Diablo II, Lord of Destruction and StarCraft from Blizzard's
# own legacy servers and builds the game folders from the payloads' install scripts, with
# patches/blizzard-legacy-dl applied (names looked up through the app, Android having no
# /etc/resolv.conf; a position-independent build). Built with Zig, static (musl).
BLDL_REPO=https://github.com/jaenster/blizzard-legacy-dl
BLDL_COMMIT=19faf24f742ef7189b1add13a1aed42e91b8381c
# Its one dependency (build.zig.zon), cloned by the script and used from disk.
LIBD2_REPO=https://github.com/jaenster/libd2
LIBD2_COMMIT=89db01dffcead00f860e46a5d3497e85e65ac666
ZIG_URL=https://ziglang.org/download/0.17.0/zig-x86_64-linux-0.17.0.tar.xz
ZIG_SHA256=1cbe9df9f27e6b78d14ccbca43b6703a404ef79ef1c463de901d7f088d4e2026
# innoextract, which unpacks GOG's offline installers (Diablo + Hellfire): crazy-max's fork at
# v1.13.0 (Inno Setup up to 7.0), as YeaBwoi's Warcraft app builds it, with Boost, liblzma, zlib
# and bzip2 built for Android, each archive checked against its SHA-256.
TOOLS_NDK=24.0.8215888
INNOEXTRACT_REPO=https://github.com/crazy-max/innoextract
INNOEXTRACT_COMMIT=21e1fd97083baf2c1ce41afb547ae6d273f4fcfb
BOOST_URL=https://archives.boost.io/release/1.84.0/source/boost_1_84_0.tar.bz2
BOOST_SHA256=cc4b893acf645c9d4b698e9a0f08ca8846aa5d6c68275c14c3e7949c24109454
XZ_URL=https://github.com/tukaani-project/xz/releases/download/v5.6.3/xz-5.6.3.tar.gz
XZ_SHA256=b1d45295d3f71f25a4c9101bd7c8d16cb56348bbef3bbc738da0351e17c73317
ZLIB_URL=https://zlib.net/fossils/zlib-1.3.1.tar.gz
ZLIB_SHA256=9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23
BZIP2_URL=https://sourceware.org/pub/bzip2/bzip2-1.0.8.tar.gz
BZIP2_SHA256=ab5a03176ee106d3f0fa90e381da478ddae405918153cca248e682cd0c4a2269
