# The Forever realm on the phone: TrinityCore's community "forever" branch (advocaite/TrinityCore, GPL-2.0; not an
# official TrinityCore branch), which runs TrinityCore master against the WoW Forever client with a vanilla world
# (converted from VMaNGOS). Built for Linux arm64 (musl, Alpine) by scripts/compile-trinity-forever.sh with the app's
# patches (forever/patches/), packed by scripts/package-trinity-forever.sh. Nothing is shared with the Wrath realm.
ALPINE_VERSION=3.22
TRINITY_REPO=https://github.com/advocaite/TrinityCore
TRINITY_COMMIT=2ae1313e9f89ba34103fee1400dc3d4222efd8c4
# The branch's world and hotfixes databases (its release; the CI job finds the files in it).
TRINITY_DB_REPO=advocaite/TrinityCore
TRINITY_DB_TAG=forever-tdb-2026-10-14
# The client build the branch's realms (70-73) accept after its updates.
CLIENT_BUILD=70790
# The realm id the Classic client accepts (worldserver.conf RealmID).
REALM_ID=70
