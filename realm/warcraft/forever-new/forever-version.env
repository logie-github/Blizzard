# WoW Forever (Karrz's PlayerbotV2 build of TrinityCore), built new for the phone. Nothing here comes from
# earlier Forever work in this repository: the sources are Karrz's current projects, pinned.
ALPINE_VERSION=3.22
# The FULL branch (module loader and core wiring included), never the partial copy in the bots repository.
CORE_REPO=https://github.com/Karrz1/TrinityCore.git
CORE_BRANCH=forever-bots
CORE_COMMIT=51b5ae0971fadf2e96a16b4730e986cc33e29adb
# Karrz's release the data and add-on below belong to.
UPSTREAM_VERSION=0.1.36.1
UPSTREAM_BASE=https://github.com/Karrz1/Karrz-playerbots-wow-forever/releases/download/v0.1.36.1
ADDON_ASSET=ForeverBots-addon-0.1.36.1.zip
ADDON_SHA256=0c1756fc48bd7e9af2b074c16a65d8367c06b3b1c99e216855027b7d78c1769e
CLIENT_BUILDS_ASSET=client-builds.txt
CLIENT_BUILDS_SHA256=0b43980708438fb2644cd1c71d2c08916eb209d746809042e03e8bc35de511d3
# The Windows repack is NOT run. Two of its files are DATA the source tree doesn't hold (the world and hotfix
# databases, ~950 MB as SQL); the app reads just those two entries out of the zip with range requests.
REPACK_ASSET=WoW-Forever-Bots-0.1.36.1.zip
REPACK_SHA256=64aba9c0205a8eff775b5e93e2db0983c67b60569c1b3bd99aa566b976e69fb5
REPACK_WORLD_ENTRY=sql/world.sql
REPACK_WORLD_SIZE=613883583
REPACK_WORLD_SHA256=3ea1b8d138bb097f7003e5b41d9bf2136a9e1bcd224bbb96ec7daeb52a2ed5a2
REPACK_HOTFIXES_ENTRY=sql/hotfixes.sql
REPACK_HOTFIXES_SIZE=339516733
REPACK_HOTFIXES_SHA256=492bf4e7034832012afe282eeafc3a074a7caac79f5e20b798ae745005cb8fa7
# The server package's own release (made by .github/workflows/build-forever-native.yml; it does not exist until that runs).
RELEASE_TAG=forever-android-server
PACKAGE_ASSET=forever-android-arm64.tar.xz
MANIFEST_ASSET=forever-android-arm64.json
# Bumped when the package layout or the app's expectations of it change.
PACKAGE_FORMAT=1
