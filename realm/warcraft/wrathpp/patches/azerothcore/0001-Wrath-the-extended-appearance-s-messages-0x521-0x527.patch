From 9213e3f8ff364a497c8bcdde9c83c7f7257e3991 Mon Sep 17 00:00:00 2001
From: World of Warcraft <warcraft@users.noreply.github.com>
Date: Tue, 10 Nov 2026 17:49:34 +0000
Subject: [PATCH] Wrath++: the extended appearance's messages (0x521-0x527),
 routed to a module

Only the Wrath++ server build (realm/warcraft/wrathpp) applies this: the stock client and the
other realms' servers never see these numbers. The core routes the client's messages to the
handler the Wrath++ customization module sets; without one they are dropped.
---
 src/server/game/Handlers/WrathppHandler.cpp   | 38 +++++++++++++++++++
 src/server/game/Server/Protocol/Opcodes.cpp   |  7 ++++
 src/server/game/Server/Protocol/Opcodes.h     | 12 +++++-
 .../game/Server/Protocol/WrathppProtocol.h    | 23 +++++++++++
 src/server/game/Server/WorldSession.h         |  3 ++
 5 files changed, 82 insertions(+), 1 deletion(-)
 create mode 100644 src/server/game/Handlers/WrathppHandler.cpp
 create mode 100644 src/server/game/Server/Protocol/WrathppProtocol.h

diff --git a/src/server/game/Handlers/WrathppHandler.cpp b/src/server/game/Handlers/WrathppHandler.cpp
new file mode 100644
index 0000000000..9418404de4
--- /dev/null
+++ b/src/server/game/Handlers/WrathppHandler.cpp
@@ -0,0 +1,38 @@
+/*
+ * Wrath++: the extended appearance's client messages, handed to the module's handler
+ * (WrathppProtocol.h).
+ */
+
+#include "WrathppProtocol.h"
+#include "Log.h"
+#include "WorldPacket.h"
+#include "WorldSession.h"
+#include <atomic>
+
+namespace
+{
+    std::atomic<Wrathpp::PacketHandler> s_handler{nullptr};
+}
+
+void Wrathpp::SetPacketHandler(PacketHandler handler)
+{
+    s_handler.store(handler);
+}
+
+Wrathpp::PacketHandler Wrathpp::GetPacketHandler()
+{
+    return s_handler.load();
+}
+
+void WorldSession::HandleWrathppOpcode(WorldPacket& recvData)
+{
+    if (Wrathpp::PacketHandler handler = Wrathpp::GetPacketHandler())
+    {
+        handler(this, recvData);
+        return;
+    }
+
+    LOG_DEBUG("network.opcode", "Wrath++ message {} from {} with no Wrath++ module: dropped",
+        GetOpcodeNameForLogging(static_cast<OpcodeClient>(recvData.GetOpcode())), GetPlayerInfo());
+    recvData.rfinish();
+}
diff --git a/src/server/game/Server/Protocol/Opcodes.cpp b/src/server/game/Server/Protocol/Opcodes.cpp
index 8a44613589..5b9dcccb26 100644
--- a/src/server/game/Server/Protocol/Opcodes.cpp
+++ b/src/server/game/Server/Protocol/Opcodes.cpp
@@ -1441,6 +1441,13 @@ void OpcodeTable::Initialize()
     /*0x51E*/ DEFINE_SERVER_OPCODE_HANDLER(SMSG_MULTIPLE_MOVES, STATUS_NEVER);
     /*0x51F*/ DEFINE_HANDLER(TC9_CMSG_PREPARE_FOR_REDIRECT,                                         STATUS_AUTHED,     PROCESS_THREADUNSAFE,   &WorldSession::HandleTC9PrepareForRedirect);
     /*0x520*/ DEFINE_SERVER_OPCODE_HANDLER(TC9_SMSG_READY_FOR_REDIRECT, STATUS_NEVER);
+    /*0x521*/ DEFINE_SERVER_OPCODE_HANDLER(SMSG_WRATHPP_HELLO, STATUS_NEVER);
+    /*0x522*/ DEFINE_HANDLER(CMSG_WRATHPP_HELLO,                                                    STATUS_AUTHED,     PROCESS_THREADUNSAFE,   &WorldSession::HandleWrathppOpcode);
+    /*0x523*/ DEFINE_SERVER_OPCODE_HANDLER(SMSG_WRATHPP_REGISTRY, STATUS_NEVER);
+    /*0x524*/ DEFINE_HANDLER(CMSG_WRATHPP_SET_APPEARANCE,                                           STATUS_AUTHED,     PROCESS_THREADUNSAFE,   &WorldSession::HandleWrathppOpcode);
+    /*0x525*/ DEFINE_SERVER_OPCODE_HANDLER(SMSG_WRATHPP_APPEARANCE, STATUS_NEVER);
+    /*0x526*/ DEFINE_SERVER_OPCODE_HANDLER(SMSG_WRATHPP_RESULT, STATUS_NEVER);
+    /*0x527*/ DEFINE_HANDLER(CMSG_WRATHPP_QUERY,                                                    STATUS_AUTHED,     PROCESS_THREADUNSAFE,   &WorldSession::HandleWrathppOpcode);
 
 #undef DEFINE_HANDLER
 #undef DEFINE_SERVER_OPCODE_HANDLER
diff --git a/src/server/game/Server/Protocol/Opcodes.h b/src/server/game/Server/Protocol/Opcodes.h
index 0b34344c42..a56cc7f470 100644
--- a/src/server/game/Server/Protocol/Opcodes.h
+++ b/src/server/game/Server/Protocol/Opcodes.h
@@ -1340,7 +1340,17 @@ enum Opcodes : uint16
     SMSG_MULTIPLE_MOVES                             = 0x51E, // uncompressed version of SMSG_COMPRESSED_MOVES
     TC9_CMSG_PREPARE_FOR_REDIRECT                   = 0x51F,
     TC9_SMSG_READY_FOR_REDIRECT                     = 0x520,
-    NUM_MSG_TYPES                                   = 0x521
+    // Wrath++ (realm/warcraft/wrathpp, docs/wrathpp/PROTOCOL.md): the extended appearance's
+    // messages, numbered as WarcraftXL's net service gives a client mod its own (from 0x521).
+    // Only the Wrath++ server build has them; their bodies are the module's (WrathppProtocol.h).
+    SMSG_WRATHPP_HELLO                              = 0x521,
+    CMSG_WRATHPP_HELLO                              = 0x522,
+    SMSG_WRATHPP_REGISTRY                           = 0x523,
+    CMSG_WRATHPP_SET_APPEARANCE                     = 0x524,
+    SMSG_WRATHPP_APPEARANCE                         = 0x525,
+    SMSG_WRATHPP_RESULT                             = 0x526,
+    CMSG_WRATHPP_QUERY                              = 0x527,
+    NUM_MSG_TYPES                                   = 0x528
 };
 
 enum OpcodeMisc : uint16
diff --git a/src/server/game/Server/Protocol/WrathppProtocol.h b/src/server/game/Server/Protocol/WrathppProtocol.h
new file mode 100644
index 0000000000..11bd03c4cf
--- /dev/null
+++ b/src/server/game/Server/Protocol/WrathppProtocol.h
@@ -0,0 +1,23 @@
+/*
+ * Wrath++ (the Blizzard launcher's realm/warcraft/wrathpp): where the Wrath++ world server's
+ * customization module receives its client messages (CMSG_WRATHPP_*, Opcodes.h). The core only
+ * routes them; parsing, validation and persistence are the module's (mod-wrathpp-customization).
+ * With no handler set, as on every realm that doesn't run the module, they are dropped.
+ */
+
+#ifndef WRATHPP_PROTOCOL_H
+#define WRATHPP_PROTOCOL_H
+
+class WorldPacket;
+class WorldSession;
+
+namespace Wrathpp
+{
+    using PacketHandler = void (*)(WorldSession* session, WorldPacket& packet);
+
+    // Set once by the module as the world server starts (nullptr takes it away).
+    void SetPacketHandler(PacketHandler handler);
+    PacketHandler GetPacketHandler();
+}
+
+#endif
diff --git a/src/server/game/Server/WorldSession.h b/src/server/game/Server/WorldSession.h
index 68ef178b5a..d71f517b36 100644
--- a/src/server/game/Server/WorldSession.h
+++ b/src/server/game/Server/WorldSession.h
@@ -712,6 +712,9 @@ public:                                                 // opcodes handlers
     void SendSetPlayerDeclinedNamesResult(DeclinedNameResult result, ObjectGuid guid);
 
     void HandleTC9PrepareForRedirect(WorldPacket& recvData);
+    // Wrath++: the extended appearance's client messages, handed to the module that set a handler
+    // (WrathppProtocol.h); without one they are read and dropped.
+    void HandleWrathppOpcode(WorldPacket& recvData);
 
     // played time
     void HandlePlayedTime(WorldPackets::Character::PlayedTimeClient& packet);
