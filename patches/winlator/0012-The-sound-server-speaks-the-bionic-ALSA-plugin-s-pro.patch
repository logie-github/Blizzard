From dc3c5c400fdfe0c81655ca004a119084ff75d9d3 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 15 Nov 2026 14:41:32 +0000
Subject: [PATCH] The sound server speaks the bionic ALSA plugin's protocol in
 a bionic session

---
 .../java/com/winlator/XServerDisplayActivity.java   |  1 +
 .../java/com/winlator/alsaserver/ALSAClient.java    |  6 ++++++
 .../com/winlator/alsaserver/ALSARequestHandler.java | 13 +++++++++++++
 3 files changed, 20 insertions(+)

diff --git a/app/src/main/java/com/winlator/XServerDisplayActivity.java b/app/src/main/java/com/winlator/XServerDisplayActivity.java
index 4fa5c82..4227634 100644
--- a/app/src/main/java/com/winlator/XServerDisplayActivity.java
+++ b/app/src/main/java/com/winlator/XServerDisplayActivity.java
@@ -513,6 +513,7 @@ public class XServerDisplayActivity extends AppCompatActivity implements Navigat
             if (box64Version != null) guestProgramLauncherComponent.setBox64Version(box64Version);
         }
 
+        com.winlator.alsaserver.ALSAClient.bionicClients = getIntent().getStringExtra("bionic_command") != null;
         environment = new XEnvironment(this, rootFS);
         environment.addComponent(new SysVSharedMemoryComponent(xServer, UnixSocketConfig.create(rootPath, UnixSocketConfig.SYSVSHM_SERVER_PATH)));
         environment.addComponent(new XServerComponent(xServer, UnixSocketConfig.create(rootPath, UnixSocketConfig.XSERVER_PATH)));
diff --git a/app/src/main/java/com/winlator/alsaserver/ALSAClient.java b/app/src/main/java/com/winlator/alsaserver/ALSAClient.java
index 160bb8f..2c3454c 100644
--- a/app/src/main/java/com/winlator/alsaserver/ALSAClient.java
+++ b/app/src/main/java/com/winlator/alsaserver/ALSAClient.java
@@ -16,6 +16,12 @@ import java.nio.ByteOrder;
 public class ALSAClient {
     public static final boolean USE_SHARED_MEMORY = true;
     public static final byte BUFFER_OFFSET = 4;
+    /**
+     * The session's sound clients are an Android-native (bionic) Wine's: its ALSA plugin (GameNative's android_aserver) writes
+     * the samples at the start of the shared buffer and expects no answer to a write; the glibc one leaves four bytes for the
+     * pointer and waits for a byte. Set by the session before its components start.
+     */
+    public static volatile boolean bionicClients = false;
     public enum DataType {
         U8(1), S16LE(2), S16BE(2), FLOATLE(4), FLOATBE(4);
         public final byte byteCount;
diff --git a/app/src/main/java/com/winlator/alsaserver/ALSARequestHandler.java b/app/src/main/java/com/winlator/alsaserver/ALSARequestHandler.java
index 3aa41ea..de79e9b 100644
--- a/app/src/main/java/com/winlator/alsaserver/ALSARequestHandler.java
+++ b/app/src/main/java/com/winlator/alsaserver/ALSARequestHandler.java
@@ -50,6 +50,19 @@ public class ALSARequestHandler implements RequestHandler {
                 break;
             case RequestCodes.WRITE:
                 ByteBuffer sharedBuffer = alsaClient.getSharedBuffer();
+                if (ALSAClient.bionicClients) {
+                    // GameNative's protocol (its ALSARequestHandler, the branch that isn't glibc): no header, no answer.
+                    if (sharedBuffer != null) {
+                        if (requestLength < 0 || requestLength > sharedBuffer.capacity()) break;
+                        sharedBuffer.position(0).limit(requestLength);
+                        alsaClient.writeDataToTrack(sharedBuffer);
+                    }
+                    else {
+                        if (inputStream.available() < requestLength) return false;
+                        alsaClient.writeDataToTrack(inputStream.readByteBuffer(requestLength));
+                    }
+                    break;
+                }
                 if (sharedBuffer != null) {
                     copySharedBuffer(alsaClient, requestLength, outputStream);
                     alsaClient.writeDataToTrack(alsaClient.getAuxBuffer());
-- 
2.43.0

