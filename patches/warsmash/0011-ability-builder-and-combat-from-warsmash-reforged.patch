+public class ABCallbackArgumentAbility extends ABAbilityCallback {
+
+	private ABStringCallback name;
+
+	@Override
+	public CAbility callback(final CSimulation game, final CUnit caster, final Map<String, Object> localStore,
+			final int castId) {
+		final String keyS = name.callback(game, caster, localStore, castId);
+		ABCallback cbck = (ABCallback) localStore.get(ABLocalStoreKeys.combineArgumentKey(keyS));
+		if (cbck != null && cbck instanceof ABAbilityCallback) {
+			return ((ABAbilityCallback) cbck).callback(game, caster, localStore, castId);
+		} else {
+			Log.error("Trying to run ReuseAbilityCallback, but key is missing or callback was the wrong type: " + keyS);
+		}
+		return null;
+	}
+
