+						if (hits < maxHits && collisions.get(enumUnit.getHandleId(), 0) < maxHitsPerTarget
+								&& enumUnit.canReach(loc, collisionRadius) && canHitTarget(game, enumUnit)) {
+							unitCount.incrementAndGet();
+						}
+						return false;
+					}
+				});
