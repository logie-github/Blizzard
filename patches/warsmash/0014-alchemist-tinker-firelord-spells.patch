+
+/**
+ * Acid Bomb (Alchemist, ANab): a bottle thrown at a unit; every enemy in the area where it breaks loses Data C armor
+ * and the target takes Data D damage a second, the others Data E, every Data F seconds, for the spell's duration.
+ * Blizzard launcher, written for this engine.
+ */
+public class CAbilityAcidBomb extends CAbilityTargetSpellBase {
+	private float areaOfEffect;
+	private float armorPenalty;
+	private float primaryDamage;
+	private float secondaryDamage;
+	private float damageInterval;
+	private float projectileSpeed;
+	private boolean projectileHoming;
+	private War3ID buffId;
+
+	public CAbilityAcidBomb(final int handleId, final War3ID alias) {
+		super(handleId, alias);
+	}
+
+	@Override
+	public void populateData(final GameObject worldEditorAbility, final int level) {
+		this.areaOfEffect = worldEditorAbility.getFieldAsFloat(AbilityFields.AREA_OF_EFFECT + level, 0);
+		this.armorPenalty = worldEditorAbility.getFieldAsFloat(AbilityFields.DATA_C + level, 0);
+		this.primaryDamage = worldEditorAbility.getFieldAsFloat(AbilityFields.DATA_D + level, 0);
+		this.secondaryDamage = worldEditorAbility.getFieldAsFloat(AbilityFields.DATA_E + level, 0);
+		this.damageInterval = worldEditorAbility.getFieldAsFloat(AbilityFields.DATA_F + level, 0);
+		this.projectileSpeed = worldEditorAbility.getFieldAsFloat(AbilityFields.PROJECTILE_SPEED, 0);
+		this.projectileHoming = worldEditorAbility.getFieldAsBoolean(AbilityFields.PROJECTILE_HOMING_ENABLED, 0);
+		this.buffId = AbstractCAbilityTypeDefinition.getBuffId(worldEditorAbility, level);
+	}
+
+	@Override
+	public int getBaseOrderId() {
+		return OrderIds.acidbomb;
+	}
+
+	@Override
+	public boolean doEffect(final CSimulation simulation, final CUnit caster, final AbilityTarget target) {
+		final CUnit targetUnit = target.visit(AbilityTargetVisitor.UNIT);
+		if (targetUnit == null) {
+			return false;
+		}
+		final float speed = this.projectileSpeed > 0 ? this.projectileSpeed : 900;
+		simulation.createProjectile(caster, getAlias(), caster.getX(), caster.getY(),
+				(float) caster.angleTo(targetUnit), speed, this.projectileHoming || (this.projectileSpeed <= 0),
+				targetUnit, new CAbilityProjectileListener() {
+					@Override
+					public void onLaunch(final CSimulation game, final CProjectile projectile,
+							final AbilityTarget target) {
+					}
+
+					@Override
+					public void onHit(final CSimulation game, final CProjectile projectile,
+							final AbilityTarget target) {
+						final List<CUnit> hit = new ArrayList<>();
+						game.getWorldCollision().enumUnitsInRange(targetUnit.getX(), targetUnit.getY(),
+								CAbilityAcidBomb.this.areaOfEffect, (unit) -> {
+									if (!unit.isDead() && unit.canBeTargetedBy(game, caster, getTargetsAllowed())) {
+										hit.add(unit);
+									}
+									return false;
+								});
+						if (!hit.contains(targetUnit) && !targetUnit.isDead()) {
+							hit.add(targetUnit);
+						}
+						for (final CUnit unit : hit) {
+							for (final CAbility ability : new ArrayList<>(unit.getAbilities())) {
+								if ((ability instanceof CBuffAcidBomb) && ability.getAlias().equals(CAbilityAcidBomb.this.buffId)) {
+									unit.remove(game, ability);
+								}
+							}
+							unit.add(game, new CBuffAcidBomb(game.getHandleIdAllocator().createId(),
+									CAbilityAcidBomb.this.buffId, getDurationForTarget(unit), caster,
+									CAbilityAcidBomb.this.armorPenalty,
+									unit == targetUnit ? CAbilityAcidBomb.this.primaryDamage
+											: CAbilityAcidBomb.this.secondaryDamage,
+									CAbilityAcidBomb.this.damageInterval));
+						}
+					}
+				});
+		return false;
+	}
+}
