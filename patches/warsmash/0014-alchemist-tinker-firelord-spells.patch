+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.skills.util.CBuffTimed;
+
+/** Acid Bomb's corrosion: armor lowered and damage every interval while it lasts. */
+public class CBuffAcidBomb extends CBuffTimed {
+	private final CUnit caster;
+	private final float armorPenalty;
+	private final float damagePerSecond;
+	private final float interval;
+	private int nextDamageTick;
+
+	public CBuffAcidBomb(final int handleId, final War3ID alias, final float duration, final CUnit caster,
+			final float armorPenalty, final float damagePerSecond, final float interval) {
+		super(handleId, alias, alias, duration);
+		this.caster = caster;
+		this.armorPenalty = armorPenalty;
+		this.damagePerSecond = damagePerSecond;
+		this.interval = Math.max(WarsmashConstants.SIMULATION_STEP_TIME, interval);
+	}
+
+	@Override
+	protected void onBuffAdd(final CSimulation game, final CUnit unit) {
+		unit.setTemporaryDefenseBonus(unit.getTemporaryDefenseBonus() - this.armorPenalty);
+		this.nextDamageTick = game.getGameTurnTick() + ticks(this.interval);
+	}
+
+	@Override
+	protected void onBuffRemove(final CSimulation game, final CUnit unit) {
+		unit.setTemporaryDefenseBonus(unit.getTemporaryDefenseBonus() + this.armorPenalty);
+	}
+
+	@Override
+	public void onTick(final CSimulation game, final CUnit unit) {
+		if (game.getGameTurnTick() >= this.nextDamageTick) {
+			this.nextDamageTick = game.getGameTurnTick() + ticks(this.interval);
+			if (this.damagePerSecond > 0) {
+				unit.damage(game, this.caster, false, true, CAttackType.SPELLS, CDamageType.ACID,
+						CWeaponSoundTypeJass.WHOKNOWS.name(), this.damagePerSecond * this.interval);
+			}
+		}
+		super.onTick(game, unit);
+	}
+
+	private static int ticks(final float seconds) {
+		return Math.max(1, (int) (seconds / WarsmashConstants.SIMULATION_STEP_TIME));
+	}
+
+	@Override
+	public boolean isTimedLifeBar() {
+		return false;
+	}
+
+	@Override
+	public boolean isMagic() {
+		return true;
+	}
+
+	@Override
+	public boolean isDispellable() {
+		return true;
+	}
+}
