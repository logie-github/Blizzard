+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.combat.attacks.listeners.CUnitAttackEffectListenerStacking;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.combat.attacks.listeners.CUnitAttackPreDamageListener;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.combat.attacks.listeners.CUnitAttackPreDamageListenerDamageModResult;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.combat.attacks.listeners.CUnitAttackPreDamageListenerPriority;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.combat.attacks.replacement.CUnitAttackSettings;
+
+/**
+ * Demolish (the Robo-Goblin's, ANde): attacks multiply their damage by Data B on buildings, Data C on units and Data D
+ * on heroes (0 leaves it), with a Data A percent chance. Blizzard launcher, written for this engine.
+ */
+public class CAbilityDemolish extends CAbilityPassiveSpellBase implements CUnitAttackPreDamageListener {
+	private float chance;
+	private float buildingFactor;
+	private float unitFactor;
+	private float heroFactor;
+
+	public CAbilityDemolish(final int handleId, final War3ID code, final War3ID alias) {
+		super(handleId, code, alias);
+	}
+
+	@Override
+	public void populateData(final GameObject worldEditorAbility, final int level) {
+		this.chance = worldEditorAbility.getFieldAsFloat(AbilityFields.DATA_A + level, 0);
+		this.buildingFactor = worldEditorAbility.getFieldAsFloat(AbilityFields.DATA_B + level, 0);
+		this.unitFactor = worldEditorAbility.getFieldAsFloat(AbilityFields.DATA_C + level, 0);
+		this.heroFactor = worldEditorAbility.getFieldAsFloat(AbilityFields.DATA_D + level, 0);
+	}
+
+	@Override
+	public void onAdd(final CSimulation game, final CUnit unit) {
+		unit.addPreDamageListener(CUnitAttackPreDamageListenerPriority.CRITBASH, this);
+	}
+
+	@Override
+	public void onRemove(final CSimulation game, final CUnit unit) {
+		unit.removePreDamageListener(CUnitAttackPreDamageListenerPriority.CRITBASH, this);
+	}
+
+	@Override
+	public CUnitAttackEffectListenerStacking onAttack(final CSimulation simulation, final CUnit attacker,
+			final AbilityTarget target, final AbilityPointTarget attackImpactLocation, final CUnitAttack attack,
+			final CUnitAttackSettings settings, final CUnitAttackPreDamageListenerDamageModResult damageResult) {
+		final CUnit targetUnit = target.visit(AbilityTargetVisitor.UNIT);
+		if (targetUnit != null) {
+			final float factor = targetUnit.isBuilding() ? this.buildingFactor
+					: targetUnit.isHero() ? this.heroFactor : this.unitFactor;
+			if ((factor > 0) && ((this.chance >= 100) || ((simulation.getSeededRandom().nextFloat() * 100) < this.chance))) {
+				damageResult.setDamageMultiplier(damageResult.getDamageMultiplier() * factor);
+			}
+		}
+		return new CUnitAttackEffectListenerStacking();
+	}
+}
