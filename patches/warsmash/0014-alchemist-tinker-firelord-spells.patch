+
+/**
+ * Healing Spray (Alchemist, ANhs): waves of mist over the area, each healing every unit there the spell may target
+ * by Data A, at most Data D in all per wave, Data F waves Data B seconds apart; buildings take Data E of it. Each
+ * wave is shown by Data C missiles landing in the area. Blizzard launcher, written for this engine (neither Warsmash
+ * nor Reforged had it).
+ */
+public class CAbilityHealingSpray extends CAbilityPointTargetSpellBase {
+	private float areaOfEffect;
+	private static final float MISSILE_ARRIVAL_DELAY = 1.0f;
+	private float healAmount;
+	private float waveInterval;
+	private int missilesPerWave;
+	private float maximumHealPerWave;
+	private float buildingFactor;
+	private int waveCount;
+
+	public CAbilityHealingSpray(final int handleId, final War3ID alias) {
+		super(handleId, alias);
+	}
+
+	@Override
+	public void populateData(final GameObject worldEditorAbility, final int level) {
+		this.areaOfEffect = worldEditorAbility.getFieldAsFloat(AbilityFields.AREA_OF_EFFECT + level, 0);
+		this.healAmount = worldEditorAbility.getFieldAsFloat(AbilityFields.DATA_A + level, 0);
+		this.waveInterval = worldEditorAbility.getFieldAsFloat(AbilityFields.DATA_B + level, 0);
+		this.missilesPerWave = worldEditorAbility.getFieldAsInteger(AbilityFields.DATA_C + level, 0);
+		this.maximumHealPerWave = worldEditorAbility.getFieldAsFloat(AbilityFields.DATA_D + level, 0);
+		this.buildingFactor = worldEditorAbility.getFieldAsFloat(AbilityFields.DATA_E + level, 0);
+		this.waveCount = worldEditorAbility.getFieldAsInteger(AbilityFields.DATA_F + level, 0);
+	}
+
+	@Override
+	public int getBaseOrderId() {
+		return OrderIds.healingspray;
+	}
+
+	@Override
+	public float getUIAreaOfEffect() {
+		return this.areaOfEffect;
+	}
+
+	@Override
+	public boolean doEffect(final CSimulation simulation, final CUnit caster, final AbilityTarget target) {
+		final float x = target.getX();
+		final float y = target.getY();
+		final float area = this.areaOfEffect;
+		final int waves = Math.max(1, this.waveCount);
+		final float interval = Math.max(WarsmashConstants.SIMULATION_STEP_TIME, this.waveInterval);
+		final float heal = this.healAmount;
+		final float maximum = this.maximumHealPerWave;
+		final float buildings = this.buildingFactor;
+		final int missiles = this.missilesPerWave;
+		final int[] wavesDone = { 0 };
+		launchMissiles(simulation, caster, x, y, area, missiles);
+		final CTimer waveTimer = new CTimer() {
+			@Override
+			public void onFire(final CSimulation game) {
+				final List<CUnit> healed = new ArrayList<>();
+				game.getWorldCollision().enumUnitsInRange(x, y, area, (unit) -> {
+					if (!unit.isDead() && unit.canBeTargetedBy(game, caster, getTargetsAllowed())) {
+						healed.add(unit);
+					}
+					return false;
+				});
+				float each = heal;
+				if ((maximum > 0) && ((each * healed.size()) > maximum)) {
+					each = maximum / healed.size();
+				}
+				for (final CUnit unit : healed) {
+					unit.heal(game, unit.isBuilding() ? each * buildings : each);
+				}
+				wavesDone[0]++;
+				if (wavesDone[0] >= waves) {
+					pause(game);
+				}
+				else {
+					launchMissiles(game, caster, x, y, area, missiles);
+				}
+			}
+		};
+		waveTimer.setRepeats(true);
+		waveTimer.setTimeoutTime(interval);
+		final CTimer firstWave = new CTimer() {
+			@Override
+			public void onFire(final CSimulation game) {
+				waveTimer.onFire(game);
+				if (wavesDone[0] < waves) {
+					waveTimer.start(game);
+				}
+			}
+		};
+		firstWave.setRepeats(false);
+		firstWave.setTimeoutTime(MISSILE_ARRIVAL_DELAY);
+		firstWave.start(simulation);
+		return false;
+	}
+
+	private void launchMissiles(final CSimulation simulation, final CUnit caster, final float x, final float y,
+			final float area, final int missiles) {
+		for (int i = 0; i < missiles; i++) {
+			final double angle = simulation.getSeededRandom().nextDouble() * StrictMath.PI * 2;
+			final double distance = simulation.getSeededRandom().nextDouble() * area;
+			final AbilityPointTarget land = new AbilityPointTarget((float) (x + (StrictMath.cos(angle) * distance)),
+					(float) (y + (StrictMath.sin(angle) * distance)));
+			float speed = (float) (caster.distance(land) / MISSILE_ARRIVAL_DELAY);
+			speed = Math.max(speed, simulation.getGameplayConstants().getMinUnitSpeed());
+			simulation.createProjectile(caster, getAlias(), caster.getX(), caster.getY(),
+					(float) caster.angleTo(land), speed, false, land, CAbilityProjectileListener.DO_NOTHING);
+		}
+	}
+}
