+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.combat.attacks.listeners.CUnitAttackPostDamageListener;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.combat.attacks.replacement.CUnitPriorityLoopData;
+
+/**
+ * Summon Lava Spawn (Firelord, ANlm): Data A Lava Spawns of the level's unit in front of the Firelord for the spell's
+ * duration. A spawn that has attacked Data C times, and lived at least Data B seconds since it was made or last split,
+ * splits: a new spawn beside it (Data D of its maximum life) with the parent's time left plus Data E seconds, up to
+ * Data F generations. Blizzard launcher, written for this engine.
+ */
+public class CAbilityLavaSpawn extends CAbilityNoTargetSpellBase {
+	private float areaOfEffect;
+	private War3ID summonUnitId;
+	private int summonCount;
+	private float splitDelay;
+	private int splitAttackCount;
+	private float splitLifeFactor;
+	private float splitDurationBonus;
+	private int generations;
+	private War3ID buffId;
+
+	public CAbilityLavaSpawn(final int handleId, final War3ID alias) {
+		super(handleId, alias);
+	}
+
+	@Override
+	public void populateData(final GameObject worldEditorAbility, final int level) {
+		this.areaOfEffect = worldEditorAbility.getFieldAsFloat(AbilityFields.AREA_OF_EFFECT + level, 0);
+		final String unitId = worldEditorAbility.getFieldAsString(AbilityFields.UNIT_ID + level, 0);
+		this.summonUnitId = unitId.length() == 4 ? War3ID.fromString(unitId) : War3ID.NONE;
+		this.summonCount = Math.max(1, worldEditorAbility.getFieldAsInteger(AbilityFields.DATA_A + level, 0));
+		this.splitDelay = worldEditorAbility.getFieldAsFloat(AbilityFields.DATA_B + level, 0);
+		this.splitAttackCount = worldEditorAbility.getFieldAsInteger(AbilityFields.DATA_C + level, 0);
+		this.splitLifeFactor = worldEditorAbility.getFieldAsFloat(AbilityFields.DATA_D + level, 0);
+		this.splitDurationBonus = worldEditorAbility.getFieldAsFloat(AbilityFields.DATA_E + level, 0);
+		this.generations = worldEditorAbility.getFieldAsInteger(AbilityFields.DATA_F + level, 0);
+		this.buffId = AbstractCAbilityTypeDefinition.getBuffId(worldEditorAbility, level);
+	}
+
+	@Override
+	public int getBaseOrderId() {
+		return OrderIds.lavamonster;
+	}
+
+	@Override
+	public boolean doEffect(final CSimulation simulation, final CUnit caster, final AbilityTarget target) {
+		final float facingRad = (float) StrictMath.toRadians(caster.getFacing());
+		final float distance = this.areaOfEffect > 0 ? this.areaOfEffect : 150;
+		final float x = caster.getX() + ((float) StrictMath.cos(facingRad) * distance);
+		final float y = caster.getY() + ((float) StrictMath.sin(facingRad) * distance);
+		for (int i = 0; i < this.summonCount; i++) {
+			spawn(simulation, caster.getPlayerIndex(), x, y, caster.getFacing(), getDuration(), 1, 1f);
+		}
+		return false;
+	}
+
+	private void spawn(final CSimulation simulation, final int playerIndex, final float x, final float y,
+			final float facing, final float duration, final int generation, final float lifeFactor) {
+		final CUnit spawn = simulation.createUnitSimple(this.summonUnitId, playerIndex, x, y, facing);
+		if (spawn == null) {
+			return;
+		}
+		spawn.addClassification(CUnitClassification.SUMMONED);
+		final CBuffTimedLife life = new CBuffTimedLife(simulation.getHandleIdAllocator().createId(), this.buffId,
+				duration, true);
+		spawn.add(simulation, life);
+		if (lifeFactor < 1f) {
+			spawn.setLife(simulation, Math.max(1, spawn.getMaximumLife() * lifeFactor));
+		}
+		simulation.createTemporarySpellEffectOnUnit(spawn, getAlias(), CEffectType.SPECIAL);
+		if ((this.generations > 0) && (generation >= this.generations)) {
+			return;
+		}
+		final int endTick = simulation.getGameTurnTick() + (int) (duration / WarsmashConstants.SIMULATION_STEP_TIME);
+		spawn.addPostDamageListener(new CUnitAttackPostDamageListener() {
+			private int attacks;
+			private int lastSplitTick = simulation.getGameTurnTick();
+			private boolean split;
+
+			@Override
+			public void onHit(final CSimulation game, final CUnit attacker, final AbilityTarget hitTarget,
+					final CUnitAttack attack, final float damage, final CUnitPriorityLoopData loop) {
+				if (this.split || attacker.isDead()) {
+					return;
+				}
+				this.attacks++;
+				final float alive = (game.getGameTurnTick() - this.lastSplitTick) * WarsmashConstants.SIMULATION_STEP_TIME;
+				if ((this.attacks >= Math.max(1, CAbilityLavaSpawn.this.splitAttackCount))
+						&& (alive >= CAbilityLavaSpawn.this.splitDelay)) {
+					this.split = true;
+					final float left = Math.max(0, (endTick - game.getGameTurnTick()) * WarsmashConstants.SIMULATION_STEP_TIME);
+					spawn(game, attacker.getPlayerIndex(), attacker.getX(), attacker.getY(), attacker.getFacing(),
+							left + CAbilityLavaSpawn.this.splitDurationBonus, generation + 1,
+							CAbilityLavaSpawn.this.splitLifeFactor > 0 ? CAbilityLavaSpawn.this.splitLifeFactor : 1f);
+				}
+			}
+
+			@Override
+			public int getPriority(final CSimulation game, final CUnit attacker, final AbilityTarget hitTarget,
+					final CUnitAttack attack) {
+				return 0;
+			}
+		});
+	}
+}
