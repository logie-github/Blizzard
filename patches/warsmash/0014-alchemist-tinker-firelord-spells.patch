+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.trigger.enumtypes.CWeaponSoundTypeJass;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.CAbility;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.generic.CLevelingAbility;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.skills.CAbilityPassiveSpellBase;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.types.CAbilityType;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.combat.attacks.CUnitAttack;
+
+/**
+ * Engineering Upgrade (Tinker, ANeg): Data A more movement speed (a fraction of the unit type's), Data B more attack
+ * damage, and the Tinker's other abilities swapped for their upgraded versions: each of Data C to F is a pair "old,new"
+ * of ability ids for the level (Pocket Factory, Cluster Rockets, Robo-Goblin, Demolish), the new one taking the old
+ * one's level. Blizzard launcher, written for this engine.
+ */
+public class CAbilityEngineeringUpgrade extends CAbilityPassiveSpellBase {
+	private float speedBonus;
+	private float damageBonus;
+	private final List<String[]> swaps = new ArrayList<>();
+	private CSimulation game;
+	private CUnit unit;
+	private int appliedSpeed;
+	private float appliedDamage;
+
+	public CAbilityEngineeringUpgrade(final int handleId, final War3ID code, final War3ID alias) {
+		super(handleId, code, alias);
+	}
+
+	@Override
+	public void populateData(final GameObject worldEditorAbility, final int level) {
+		this.speedBonus = worldEditorAbility.getFieldAsFloat(AbilityFields.DATA_A + level, 0);
+		this.damageBonus = worldEditorAbility.getFieldAsFloat(AbilityFields.DATA_B + level, 0);
+		this.swaps.clear();
+		for (final String field : new String[] { AbilityFields.DATA_C, AbilityFields.DATA_D, AbilityFields.DATA_E,
+				AbilityFields.DATA_F }) {
+			final List<String> pair = worldEditorAbility.getFieldAsList(field + level);
+			if ((pair != null) && (pair.size() == 2) && (pair.get(0).length() == 4) && (pair.get(1).length() == 4)) {
+				this.swaps.add(new String[] { pair.get(0), pair.get(1) });
+			}
+		}
+		if (this.unit != null) {
+			unapply();
+			apply();
+		}
+	}
+
+	@Override
+	public void onAdd(final CSimulation game, final CUnit unit) {
+		this.game = game;
+		this.unit = unit;
+		apply();
+	}
+
+	@Override
+	public void onRemove(final CSimulation game, final CUnit unit) {
+		unapply();
+		this.unit = null;
+	}
+
+	private void apply() {
+		this.appliedSpeed = StrictMath.round(this.unit.getUnitType().getSpeed() * this.speedBonus);
+		this.unit.setSpeed(this.unit.getSpeed() + this.appliedSpeed);
+		this.appliedDamage = this.damageBonus;
+		for (final CUnitAttack attack : this.unit.getUnitSpecificAttacks()) {
+			attack.setDamageBase(attack.getDamageBase() + (int) this.appliedDamage);
+		}
+		this.unit.notifyAttacksChanged();
+		for (final String[] swap : this.swaps) {
+			swapAbility(War3ID.fromString(swap[0]), War3ID.fromString(swap[1]));
+		}
+	}
+
+	private void unapply() {
+		this.unit.setSpeed(this.unit.getSpeed() - this.appliedSpeed);
+		for (final CUnitAttack attack : this.unit.getUnitSpecificAttacks()) {
+			attack.setDamageBase(attack.getDamageBase() - (int) this.appliedDamage);
+		}
+		this.unit.notifyAttacksChanged();
+		this.appliedSpeed = 0;
+		this.appliedDamage = 0;
+	}
+
+	private void swapAbility(final War3ID oldId, final War3ID newId) {
+		CAbility old = null;
+		for (final CAbility ability : this.unit.getAbilities()) {
+			if (ability.getAlias().equals(oldId)) {
+				old = ability;
+				break;
+			}
+		}
+		final CAbilityType<?> newType = this.game.getAbilityData().getAbilityType(newId);
+		if ((old == null) || (newType == null)) {
+			return;
+		}
+		final int level = old instanceof CLevelingAbility ? ((CLevelingAbility) old).getLevel() : 1;
+		this.unit.remove(this.game, old);
+		final CAbility upgraded = newType.createAbility(this.game.getHandleIdAllocator().createId());
+		this.unit.add(this.game, upgraded);
+		if ((upgraded instanceof CLevelingAbility) && (level > 1)) {
+			newType.setLevel(this.game, this.unit, (CLevelingAbility) upgraded, level);
+		}
+	}
+}
