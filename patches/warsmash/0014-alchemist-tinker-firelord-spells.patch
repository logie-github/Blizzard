+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.util.AbilityTargetCheckReceiver;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.util.CommandStringErrorKeys;
+
+/**
+ * Transmute (Alchemist, ANtm): kills the target unit at once and gives its gold cost times Data A (and lumber cost
+ * times Data B) to the caster's player; a creep above level Data C can't be transmuted. Blizzard launcher, written
+ * for this engine (the bounty, Data D, is not given).
+ */
+public class CAbilityTransmute extends CAbilityTargetSpellBase {
+	private float goldFactor;
+	private float lumberFactor;
+	private int maximumCreepLevel;
+
+	public CAbilityTransmute(final int handleId, final War3ID alias) {
+		super(handleId, alias);
+	}
+
+	@Override
+	public void populateData(final GameObject worldEditorAbility, final int level) {
+		this.goldFactor = worldEditorAbility.getFieldAsFloat(AbilityFields.DATA_A + level, 0);
+		this.lumberFactor = worldEditorAbility.getFieldAsFloat(AbilityFields.DATA_B + level, 0);
+		this.maximumCreepLevel = worldEditorAbility.getFieldAsInteger(AbilityFields.DATA_C + level, 0);
+	}
+
+	@Override
+	public int getBaseOrderId() {
+		return OrderIds.transmute;
+	}
+
+	@Override
+	protected void innerCheckCanTarget(final CSimulation game, final CUnit unit, final int orderId,
+			final CWidget target, final AbilityTargetCheckReceiver<CWidget> receiver) {
+		final CUnit targetUnit = target.visit(AbilityTargetVisitor.UNIT);
+		if ((targetUnit != null) && (this.maximumCreepLevel > 0) && game.isNeutralAggressive(targetUnit.getPlayerIndex())
+				&& (targetUnit.getUnitType().getLevel() > this.maximumCreepLevel)) {
+			receiver.targetCheckFailed(CommandStringErrorKeys.THAT_CREATURE_IS_TOO_POWERFUL);
+			return;
+		}
+		super.innerCheckCanTarget(game, unit, orderId, target, receiver);
+	}
+
+	@Override
+	public boolean doEffect(final CSimulation simulation, final CUnit caster, final AbilityTarget target) {
+		final CUnit targetUnit = target.visit(AbilityTargetVisitor.UNIT);
+		if ((targetUnit == null) || targetUnit.isDead()) {
+			return false;
+		}
+		final int gold = StrictMath.round(targetUnit.getUnitType().getGoldCost() * this.goldFactor);
+		final int lumber = StrictMath.round(targetUnit.getUnitType().getLumberCost() * this.lumberFactor);
+		simulation.createTemporarySpellEffectOnUnit(targetUnit, getAlias(), CEffectType.TARGET);
+		targetUnit.kill(simulation);
+		simulation.getPlayer(caster.getPlayerIndex()).addGold(gold);
+		if (lumber > 0) {
+			simulation.getPlayer(caster.getPlayerIndex()).addLumber(lumber);
+		}
+		return false;
+	}
+}
