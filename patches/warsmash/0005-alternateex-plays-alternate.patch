+
+	/**
+	 * Blizzard launcher: "alternateex" (the Prophet's raven in the Prologue, the druids' and the demon hunters' other forms)
+	 * plays the model's Alternate sequences, as the original does, where the model has none tagged AlternateEx (Medivh's
+	 * raven is "Stand Alternate", "Walk Alternate"...). Asking for AlternateEx alone matched no sequence, so the unit stood in
+	 * its first form.
+	 */
+	private static SecondaryTag alternateFor(final MdxComplexInstance instance, final SecondaryTag tag) {
+		if ((tag != SecondaryTag.ALTERNATEEX) || !(instance.model instanceof MdxModel)) {
+			return tag;
+		}
+		for (final Sequence sequence : ((MdxModel) instance.model).getSequences()) {
+			if (sequence.getSecondaryTags().contains(SecondaryTag.ALTERNATEEX)) {
+				return tag;
+			}
+		}
+		return SecondaryTag.ALTERNATE;
+	}
