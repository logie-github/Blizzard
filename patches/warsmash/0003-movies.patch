diff --git a/core/src/com/etheller/warsmash/util/MovieHost.java b/core/src/com/etheller/warsmash/util/MovieHost.java
new file mode 100644
index 0000000..b27af86
--- /dev/null
+++ b/core/src/com/etheller/warsmash/util/MovieHost.java
@@ -0,0 +1,160 @@
+package com.etheller.warsmash.util;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+
+import com.badlogic.gdx.Gdx;
+import com.etheller.warsmash.datasources.DataSource;
+
+/**
+ * Warcraft III's movies (Blizzard launcher). The game's pre-rendered movies (Movies\&lt;name&gt;.mpq) are played by the
+ * host over the engine, which has no player of its own: the host sets {@link #player}, and without one nothing plays.
+ * They play where the original plays them: the introduction at the game's first start, a campaign's opening the first
+ * time it is entered (for each profile), its ending once its last mission is won (the map's PlayCinematic, played when
+ * the game ends), and any of them from the campaign's mission list. The game's end (EndGame, ChangeLevel, a dialog's
+ * quit button) comes through here too, since the ending plays before the menu or the next level.
+ */
+public final class MovieHost {
+	/** The host's movie player. */
+	public interface Player {
+		/**
+		 * Plays the movies one after another ({@code names} as the game names them, "HumanEd"; {@code captions} the
+		 * text of their caption files where those are shown, else null), then runs {@code done}, on any thread. The
+		 * engine's rendering and sound wait meanwhile.
+		 */
+		void play(String[] names, String[] captions, Runnable done);
+
+		/** Whether a once-only movie ({@code key}: the introduction, a profile's campaign opening) was played. */
+		boolean seen(String key);
+
+		void markSeen(String key);
+	}
+
+	/** How the game being played ends: set by the map screen while it is up. */
+	public interface GameEnd {
+		/** The game ends: its movies, then the menu, then {@code nextLevel} when it isn't null (ChangeLevel). */
+		void end(String nextLevel);
+	}
+
+	/** The introduction, at the game's first start (the original's "seenintromovie"). */
+	public static final String INTRO = "TutorialIn";
+	public static final String INTRO_KEY = "intro";
+
+	/** Captioned whatever the subtitles: the original always shows these (Archimonde speaks Eredun in the Undead ending). */
+	private static final String[] ALWAYS_CAPTIONED = { "UndeadEd" };
+
+	public static volatile Player player;
+	public static volatile GameEnd gameEnd;
+	private static volatile boolean playing;
+
+	private static final List<String> queued = new ArrayList<>();
+
+	private MovieHost() {
+	}
+
+	/** PlayCinematic: the movie plays when the game ends, before the menu or the next level. */
+	public static synchronized void queue(final String name) {
+		if ((name != null) && !name.isEmpty() && !queued.contains(name)) {
+			queued.add(name);
+		}
+	}
+
+	public static synchronized String[] takeQueued() {
+		final String[] names = queued.toArray(new String[0]);
+		queued.clear();
+		return names;
+	}
+
+	public static synchronized void clearQueued() {
+		queued.clear();
+	}
+
+	/** Whether a movie is up (the menu's music waits). */
+	public static boolean isPlaying() {
+		return playing;
+	}
+
+	/**
+	 * Whether a once-only movie is due: true the first time for {@code key} (it counts as played from then on), false
+	 * after and without a player.
+	 */
+	public static boolean firstTime(final String key) {
+		final Player p = player;
+		if ((p == null) || p.seen(key)) {
+			return false;
+		}
+		p.markSeen(key);
+		return true;
+	}
+
+	/** EndGame and ChangeLevel: the game ends, its movies first. Nothing happens without a map screen up. */
+	public static void endGame(final String nextLevel) {
+		final GameEnd end = gameEnd;
+		if (end != null) {
+			end.end(nextLevel);
+		}
+	}
+
+	/**
+	 * Plays {@code names} (with their captions from {@code source} where the original always shows them), then runs
+	 * {@code then} on the engine's thread; {@code then} runs at once (posted) without a player or names.
+	 */
+	public static void play(final DataSource source, final Runnable then, final String... names) {
+		final Player p = player;
+		if ((p == null) || (names == null) || (names.length == 0)) {
+			if (then != null) {
+				Gdx.app.postRunnable(then);
+			}
+			return;
+		}
+		final String[] captions = new String[names.length];
+		for (int i = 0; i < names.length; i++) {
+			captions[i] = alwaysCaptioned(names[i]) ? captions(source, names[i]) : null;
+		}
+		playing = true;
+		p.play(names, captions, new Runnable() {
+			@Override
+			public void run() {
+				playing = false;
+				if (then != null) {
+					Gdx.app.postRunnable(then);
+				}
+			}
+		});
+	}
+
+	private static boolean alwaysCaptioned(final String name) {
+		for (final String captioned : ALWAYS_CAPTIONED) {
+			if (captioned.equalsIgnoreCase(name)) {
+				return true;
+			}
+		}
+		return false;
+	}
+
+	/** The game's captions for a movie (UI\Captions\&lt;name&gt;.txt), null where it has none. */
+	private static String captions(final DataSource source, final String name) {
+		final String path = "UI\\Captions\\" + name + ".txt";
+		try {
+			if ((source == null) || !source.has(path)) {
+				return null;
+			}
+			try (InputStream in = source.getResourceAsStream(path)) {
+				final ByteArrayOutputStream out = new ByteArrayOutputStream();
+				final byte[] buffer = new byte[4096];
+				int n;
+				while ((n = in.read(buffer)) > 0) {
+					out.write(buffer, 0, n);
+				}
+				return new String(out.toByteArray(), StandardCharsets.UTF_8);
+			}
+		}
+		catch (final IOException e) {
+			return null;
+		}
+	}
+}
