+import com.etheller.warsmash.parsers.fdf.frames.SimpleFrame;
+import com.etheller.warsmash.parsers.fdf.frames.StringFrame;
+import com.etheller.warsmash.parsers.fdf.frames.UIFrame;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.leaderboard.CLeaderboard;
+
+/**
+ * Blizzard launcher: the leaderboard panel at the top right (Leaderboard.fdf): the local player's leaderboard while
+ * the script displays it, its title and one line per item, label on the left and value on the right.
+ */
+public class MeleeLeaderboard {
+	private static final float TOP_MARGIN = -0.03f;
+	private static final float RIGHT_MARGIN = -0.005f;
+	private static final float ROW_HEIGHT = 0.012f;
+	private static final float BASE_HEIGHT = 0.035f;
+	private static final float SIDE_INSET = 0.012f;
+
+	private final GameUI rootFrame;
+	private final Viewport uiViewport;
+	private final SimpleFrame container;
+	private final UIFrame board;
+	private final StringFrame title;
+	private final UIFrame list;
+	private final List<StringFrame[]> rows = new ArrayList<>();
+	private CLeaderboard shown;
+	private int shownVersion = -1;
+
+	public MeleeLeaderboard(final GameUI rootFrame, final Viewport uiViewport) {
+		this.rootFrame = rootFrame;
+		this.uiViewport = uiViewport;
+		this.container = (SimpleFrame) rootFrame.createSimpleFrame("SmashLeaderboard", rootFrame, 0);
+		this.container.addAnchor(new AnchorDefinition(FramePoint.TOPRIGHT, GameUI.convertX(uiViewport, RIGHT_MARGIN),
+				GameUI.convertY(uiViewport, TOP_MARGIN)));
+		this.board = rootFrame.createFrame("Leaderboard", this.container, 0, 0);
+		this.board.addSetPoint(new SetPoint(FramePoint.TOPRIGHT, this.container, FramePoint.TOPRIGHT, 0, 0));
+		this.container.add(this.board);
+		this.container.setWidth(this.board.getAssignedWidth());
+		this.title = (StringFrame) rootFrame.getFrameByName("LeaderboardTitle", 0);
+		this.list = rootFrame.getFrameByName("LeaderboardListContainer", 0);
+		this.container.setVisible(false);
+	}
+
+	public boolean isVisible() {
+		return this.container.isVisible();
+	}
+
+	public String getTitleText() {
+		return this.title.getText();
+	}
+
+	public List<String> getLines() {
+		final List<String> lines = new ArrayList<>();
+		for (final StringFrame[] row : this.rows) {
+			if (row[0].isVisible()) {
+				lines.add(row[0].getText() + " " + row[1].getText());
+			}
+		}
+		return lines;
+	}
+
+	/** Shows the given leaderboard (the local player's), or hides the panel for null or one not displayed. */
+	public void update(final CLeaderboard leaderboard) {
+		final CLeaderboard wanted = ((leaderboard != null) && leaderboard.isDisplayed()) ? leaderboard : null;
+		if ((wanted == this.shown) && ((wanted == null) || (wanted.getVersion() == this.shownVersion))) {
+			return;
+		}
+		this.shown = wanted;
+		if (wanted == null) {
+			this.container.setVisible(false);
+			return;
+		}
+		this.shownVersion = wanted.getVersion();
+		this.rootFrame.setText(this.title, wanted.isShowLabel() ? wanted.getLabel() : "");
+		this.title.setColor(color(wanted.getLabelColor()));
+		final List<CLeaderboard.Item> items = wanted.getItems();
+		final int count = Math.min(items.size(), Math.max(wanted.getSizeByItemCount(), items.size()));
+		while (this.rows.size() < count) {
+			this.rows.add(createRow(this.rows.size()));
+		}
+		for (int i = 0; i < this.rows.size(); i++) {
+			final StringFrame[] row = this.rows.get(i);
+			if (i < count) {
+				final CLeaderboard.Item item = items.get(i);
+				this.rootFrame.setText(row[0], (wanted.isShowNames() && item.showLabel) ? item.label : "");
+				this.rootFrame.setText(row[1],
+						(wanted.isShowValues() && item.showValue) ? Integer.toString(item.value) : "");
+				row[0].setColor(color(item.labelColor != 0 ? item.labelColor : wanted.getLabelColor()));
+				row[1].setColor(color(item.valueColor != 0 ? item.valueColor : wanted.getValueColor()));
+				row[0].setVisible(true);
+				row[1].setVisible(true);
+			}
+			else {
+				row[0].setVisible(false);
+				row[1].setVisible(false);
+			}
+		}
+		final float height = GameUI.convertY(this.uiViewport, BASE_HEIGHT + (count * ROW_HEIGHT));
+		this.board.setHeight(height);
+		this.container.setHeight(height);
+		this.container.setVisible(true);
+		this.container.positionBounds(this.rootFrame, this.uiViewport);
+	}
+
+	private StringFrame[] createRow(final int index) {
+		final StringFrame label = new StringFrame("SmashLeaderboardLabel" + index, this.container, Color.WHITE,
+				TextJustify.LEFT, TextJustify.MIDDLE, this.title.getFrameFont(), "", null, null);
+		final StringFrame value = new StringFrame("SmashLeaderboardValue" + index, this.container, Color.WHITE,
+				TextJustify.RIGHT, TextJustify.MIDDLE, this.title.getFrameFont(), "", null, null);
+		final float y = GameUI.convertY(this.uiViewport, -index * ROW_HEIGHT);
+		final float rowHeight = GameUI.convertY(this.uiViewport, ROW_HEIGHT);
+		label.addSetPoint(new SetPoint(FramePoint.TOPLEFT, this.list, FramePoint.TOPLEFT,
+				GameUI.convertX(this.uiViewport, SIDE_INSET), y));
+		label.setWidth(this.board.getAssignedWidth() * 0.7f);
+		label.setHeight(rowHeight);
+		value.addSetPoint(new SetPoint(FramePoint.TOPRIGHT, this.list, FramePoint.TOPRIGHT,
+				GameUI.convertX(this.uiViewport, -SIDE_INSET), y));
+		value.setWidth(this.board.getAssignedWidth() * 0.3f);
+		value.setHeight(rowHeight);
+		this.container.add(label);
+		this.container.add(value);
+		return new StringFrame[] { label, value };
+	}
+
+	private static Color color(final int argb) {
+		return new Color(((argb >> 16) & 0xFF) / 255f, ((argb >> 8) & 0xFF) / 255f, (argb & 0xFF) / 255f,
+				((argb >>> 24) & 0xFF) / 255f);
+	}
+}
