+package com.etheller.warsmash.viewer5.handlers.w3x.simulation.leaderboard;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+
+import com.etheller.interpreter.ast.util.CHandle;
+
+/**
+ * Blizzard launcher: a script's leaderboard (CreateLeaderboard and the rest): a titled list of rows, each a label and a
+ * value, most often one per player, that the players it is given to (PlayerSetLeaderboard) see at the top right while
+ * it is displayed. The campaigns count footmen, orbs and runners with them.
+ */
+public class CLeaderboard implements CHandle {
+	private static int nextHandleId = 0x310000;
+	private final int handleId = nextHandleId++;
+	private String label = "";
+	private final List<Item> items = new ArrayList<>();
+	private boolean displayed;
+	private boolean showLabel = true;
+	private boolean showNames = true;
+	private boolean showValues = true;
+	private boolean showIcons = true;
+	private int sizeByItemCount = -1;
+	private int labelColor = 0xFFFFFFFF;
+	private int valueColor = 0xFFFFFFFF;
+	private int version;
+
+	public static final class Item {
+		public int playerIndex = -1;
+		public String label = "";
+		public int value;
+		public boolean showLabel = true;
+		public boolean showValue = true;
+		public boolean showIcon = true;
+		public int labelColor = 0;
+		public int valueColor = 0;
+	}
+
+	@Override
+	public int getHandleId() {
+		return this.handleId;
+	}
+
+	/** Changes count up so the interface knows to redraw. */
+	public int getVersion() {
+		return this.version;
+	}
+
+	private void changed() {
+		this.version++;
+	}
+
+	public String getLabel() {
+		return this.label;
+	}
+
+	public void setLabel(final String label) {
+		this.label = label == null ? "" : label;
+		changed();
+	}
+
+	public boolean isDisplayed() {
+		return this.displayed;
+	}
+
+	public void setDisplayed(final boolean displayed) {
+		this.displayed = displayed;
+		changed();
+	}
+
+	public void setStyle(final boolean showLabel, final boolean showNames, final boolean showValues,
+			final boolean showIcons) {
+		this.showLabel = showLabel;
+		this.showNames = showNames;
+		this.showValues = showValues;
+		this.showIcons = showIcons;
+		changed();
+	}
+
+	public boolean isShowLabel() {
+		return this.showLabel;
+	}
+
+	public boolean isShowNames() {
+		return this.showNames;
+	}
+
+	public boolean isShowValues() {
+		return this.showValues;
+	}
+
+	public void setSizeByItemCount(final int count) {
+		this.sizeByItemCount = count;
+		changed();
+	}
+
+	public int getSizeByItemCount() {
+		return this.sizeByItemCount < 0 ? this.items.size() : this.sizeByItemCount;
+	}
+
+	public void setLabelColor(final int argb) {
+		this.labelColor = argb;
+		changed();
+	}
+
+	public int getLabelColor() {
+		return this.labelColor;
+	}
+
+	public void setValueColor(final int argb) {
+		this.valueColor = argb;
+		changed();
+	}
+
+	public int getValueColor() {
+		return this.valueColor;
+	}
+
+	public List<Item> getItems() {
+		return this.items;
+	}
+
+	public int getItemCount() {
+		return this.items.size();
+	}
+
+	public Item getItem(final int index) {
+		return ((index >= 0) && (index < this.items.size())) ? this.items.get(index) : null;
+	}
+
+	public void addItem(final String label, final int value, final int playerIndex) {
+		final Item item = new Item();
+		item.label = label == null ? "" : label;
+		item.value = value;
+		item.playerIndex = playerIndex;
+		this.items.add(item);
+		changed();
+	}
+
+	public void removeItem(final int index) {
+		if ((index >= 0) && (index < this.items.size())) {
+			this.items.remove(index);
+			changed();
+		}
+	}
+
+	public int getPlayerIndex(final int playerIndex) {
+		for (int i = 0; i < this.items.size(); i++) {
+			if (this.items.get(i).playerIndex == playerIndex) {
+				return i;
+			}
+		}
+		return -1;
+	}
+
+	public void removePlayerItem(final int playerIndex) {
+		removeItem(getPlayerIndex(playerIndex));
+	}
+
+	public void clear() {
+		this.items.clear();
+		changed();
+	}
+
+	public void itemChanged() {
+		changed();
+	}
+
+	public void sortByValue(final boolean ascending) {
+		sort(Comparator.comparingInt(item -> item.value), ascending);
+	}
+
+	public void sortByPlayer(final boolean ascending) {
+		sort(Comparator.comparingInt(item -> item.playerIndex), ascending);
+	}
+
+	public void sortByLabel(final boolean ascending) {
+		sort(Comparator.comparing(item -> item.label), ascending);
+	}
+
+	private void sort(final Comparator<Item> comparator, final boolean ascending) {
+		this.items.sort(ascending ? comparator : comparator.reversed());
+		changed();
+	}
+}
