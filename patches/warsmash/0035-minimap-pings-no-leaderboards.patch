+	// Blizzard launcher: minimap pings (PingMinimap, PingMinimapEx): a pulsing marker at a point for a while.
+	private static final class Ping {
+		final float x, y, red, green, blue;
+		final int endTick;
+
+		Ping(final float x, final float y, final int endTick, final float red, final float green, final float blue) {
+			this.x = x;
+			this.y = y;
+			this.endTick = endTick;
+			this.red = red;
+			this.green = green;
+			this.blue = blue;
+		}
+	}
+
+	private final java.util.List<Ping> pings = new java.util.ArrayList<>();
+
+	public void addPing(final CSimulation game, final float x, final float y, final float duration, final float red,
+			final float green, final float blue) {
+		this.pings.add(new Ping(x, y, game.getGameTurnTick()
+				+ com.etheller.warsmash.viewer5.handlers.w3x.simulation.timers.CTimer.wholeSteps(duration), red, green,
+				blue));
+	}
+
+	public int getPingCount(final CSimulation game) {
+		final int tick = game.getGameTurnTick();
+		this.pings.removeIf(ping -> ping.endTick <= tick);
+		return this.pings.size();
+	}
+
+	private void renderPings(final CSimulation game, final SpriteBatch batch) {
+		final int tick = game.getGameTurnTick();
+		this.pings.removeIf(ping -> ping.endTick <= tick);
+		final long now = System.currentTimeMillis();
+		for (final Ping ping : this.pings) {
+			// A square that grows and fades every second, as the original's ring does.
+			final float phase = (now % 1000) / 1000f;
+			final float size = 6 + (phase * 26);
+			final float px = this.minimapFilledArea.x
+					+ (((ping.x - this.playableMapArea.getX()) / this.playableMapArea.getWidth())
+							* this.minimapFilledArea.width);
+			final float py = this.minimapFilledArea.y
+					+ (((ping.y - this.playableMapArea.getY()) / this.playableMapArea.getHeight())
+							* this.minimapFilledArea.height);
+			batch.setColor(ping.red, ping.green, ping.blue, 1 - (phase * 0.7f));
+			final float half = size / 2;
+			final float t = 2;
+			batch.draw(this.teamColors[0], px - half, py - half, size, t);
+			batch.draw(this.teamColors[0], px - half, (py + half) - t, size, t);
+			batch.draw(this.teamColors[0], px - half, py - half, t, size);
+			batch.draw(this.teamColors[0], (px + half) - t, py - half, t, size);
+			batch.draw(this.teamColors[0], px - 2, py - 2, 4, 4);
+		}
+		batch.setColor(1, 1, 1, 1);
 	}
 
