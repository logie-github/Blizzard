+	/** Blizzard launcher: AddUnitToStock: the shop sells the type, with the stock the script gives. */
+	public void addToStock(final CSimulation game, final War3ID unitTypeId, final int currentStock, final int stockMax) {
+		final CUnitType unitType = game.getUnitData().getUnitType(unitTypeId);
+		if (unitType == null) {
+			return;
+		}
+		SellStockState state = this.unitToSellState.get(unitTypeId);
+		if (state == null) {
+			state = new SellStockState(stockMax,
+					com.etheller.warsmash.viewer5.handlers.w3x.simulation.timers.CTimer.wholeSteps(unitType.getStockReplenishInterval()),
+					Math.max(currentStock, 1));
+			this.unitToSellState.put(unitTypeId, state);
+			if (!this.unitsSold.contains(unitTypeId)) {
+				this.unitsSold.add(unitTypeId);
+			}
+		}
+		state.setStock(currentStock, stockMax);
+	}
+
+	public void removeFromStock(final War3ID unitTypeId) {
+		this.unitToSellState.remove(unitTypeId);
+		this.unitsSold.remove(unitTypeId);
+	}
 }
