+	/**
+	 * Blizzard launcher: a dead hero raised at once beside a structure (the tavern's Awaken), with the given share of
+	 * its life and mana, as the altar's revive does when its time is up.
+	 */
+	public void reviveHeroAt(final CSimulation game, final CUnit structure, final float lifeFactor,
+			final float manaFactor, final float manaStart) {
+		getHeroData().setReviving(false);
+		getHeroData().setAwaitingRevive(false);
+		this.corpse = false;
+		this.boneCorpse = false;
+		this.deathTurnTick = 0;
+		setX(structure.getX());
+		setY(structure.getY());
+		game.getWorldCollision().addUnit(this);
+		setPoint(structure.getX(), structure.getY(), game.getWorldCollision(), game.getRegionManager());
+		setHidden(false);
+		setLife(game, getMaximumLife() * lifeFactor);
+		setMana((getMaximumMana() * manaFactor) + (manaStart * this.unitType.getManaInitial()));
+		nudgeAround(game, structure);
+		game.unitRepositioned(this);
+	}
+
 	public void nudgeAround(final CSimulation simulation, final CUnit structure) {
 		setPointAndCheckUnstuck(structure.getX(), structure.getY(), simulation);
 	}
