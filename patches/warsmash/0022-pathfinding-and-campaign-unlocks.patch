diff --git a/core/src/com/etheller/warsmash/util/CampaignProgress.java b/core/src/com/etheller/warsmash/util/CampaignProgress.java
new file mode 100644
index 0000000..1dc471f
--- /dev/null
+++ b/core/src/com/etheller/warsmash/util/CampaignProgress.java
@@ -0,0 +1,140 @@
+package com.etheller.warsmash.util;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+
+/**
+ * Blizzard launcher: which campaigns, missions and campaign endings a profile has opened, as the original keeps them.
+ * Missions open the next ones themselves when won (SetMissionAvailable, SetCampaignAvailable, SetEdCinematicAvailable,
+ * through Blizzard.j); a campaign's first mission is open with the campaign, the first campaign is always open, and a
+ * won mission that goes straight on to the next map (ChangeLevel) opens that map's mission too. Kept by the host
+ * (MovieHost's store), per profile; in memory where there is no host.
+ */
+public final class CampaignProgress {
+	private static final Set<String> MEMORY = Collections.synchronizedSet(new HashSet<>());
+	private static volatile String profile = "";
+	/** The mission map files of each campaign, in the order the campaign numbers count them. */
+	private static volatile List<List<String>> campaigns = new ArrayList<>();
+
+	private CampaignProgress() {
+	}
+
+	public static void setProfile(final String profileName) {
+		profile = profileName == null ? "" : profileName;
+	}
+
+	public static void setCampaigns(final List<List<String>> missionFilesByCampaign) {
+		campaigns = missionFilesByCampaign;
+	}
+
+	private static boolean marked(final String key) {
+		final MovieHost.Player p = MovieHost.player;
+		return (p != null) ? p.seen(key) : MEMORY.contains(key);
+	}
+
+	private static void mark(final String key) {
+		final MovieHost.Player p = MovieHost.player;
+		if (p != null) {
+			if (!p.seen(key)) {
+				p.markSeen(key);
+			}
+		}
+		else {
+			MEMORY.add(key);
+		}
+	}
+
+	private static String file(final String mapFile) {
+		return mapFile.replace('/', '\\').toLowerCase(Locale.ROOT);
+	}
+
+	private static String campaignKey(final int campaign) {
+		final List<List<String>> list = campaigns;
+		if ((campaign < 0) || (campaign >= list.size()) || list.get(campaign).isEmpty()) {
+			return null;
+		}
+		return file(list.get(campaign).get(0));
+	}
+
+	public static boolean isCampaignAvailable(final int campaign) {
+		if (campaign == 0) {
+			return true;
+		}
+		final String key = campaignKey(campaign);
+		if (key == null) {
+			return false;
+		}
+		if (marked("campaign-open/" + profile + "/" + key)) {
+			return true;
+		}
+		// The previous campaign's ending opened (its last mission won) opens this one too.
+		final String previous = campaignKey(campaign - 1);
+		if ((previous != null) && marked("campaign-ending/" + profile + "/" + previous)) {
+			return true;
+		}
+		final List<String> missions = campaigns.get(campaign);
+		for (int i = 1; i < missions.size(); i++) {
+			if (marked("campaign-mission/" + profile + "/" + file(missions.get(i)))) {
+				return true;
+			}
+		}
+		return false;
+	}
+
+	public static boolean isMissionAvailable(final int campaign, final int mission) {
+		if (mission == 0) {
+			return isCampaignAvailable(campaign);
+		}
+		final List<List<String>> list = campaigns;
+		if ((campaign < 0) || (campaign >= list.size()) || (mission >= list.get(campaign).size())) {
+			return false;
+		}
+		return marked("campaign-mission/" + profile + "/" + file(list.get(campaign).get(mission)));
+	}
+
+	public static boolean isEndingAvailable(final int campaign) {
+		final String key = campaignKey(campaign);
+		return (key != null) && marked("campaign-ending/" + profile + "/" + key);
+	}
+
+	/** SetMissionAvailable(campaign, mission, true). */
+	public static void openMission(final int campaign, final int mission) {
+		final List<List<String>> list = campaigns;
+		if ((campaign >= 0) && (campaign < list.size()) && (mission >= 0) && (mission < list.get(campaign).size())) {
+			mark("campaign-mission/" + profile + "/" + file(list.get(campaign).get(mission)));
+		}
+	}
+
+	/** SetCampaignAvailable(campaign, true). */
+	public static void openCampaign(final int campaign) {
+		final String key = campaignKey(campaign);
+		if (key != null) {
+			mark("campaign-open/" + profile + "/" + key);
+		}
+	}
+
+	/** SetEdCinematicAvailable(campaign, true): the campaign's ending, shown in its list. */
+	public static void openEnding(final int campaign) {
+		final String key = campaignKey(campaign);
+		if (key != null) {
+			mark("campaign-ending/" + profile + "/" + key);
+		}
+	}
+
+	/** ChangeLevel to a campaign map: that mission is open. */
+	public static void openMissionByFile(final String mapFile) {
+		final String wanted = file(mapFile);
+		for (final List<String> missions : campaigns) {
+			for (final String mission : missions) {
+				if (file(mission).equals(wanted)) {
+					mark("campaign-mission/" + profile + "/" + wanted);
+					return;
+				}
+			}
+		}
+	}
+}
