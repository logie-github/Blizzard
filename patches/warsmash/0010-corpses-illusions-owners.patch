+	// ---- Blizzard launcher: what Warsmash Reforged's Mirror Image, Wand of Illusion and Tome of Retraining ask ----
+	private final java.util.Map<War3ID, Integer> learnedLevels = new java.util.LinkedHashMap<>();
+
+	public void copyProperName(final CAbilityHero source) {
+		this.properName = source.properName;
+	}
+
+	/** Gives an illusion the skills its original learned, at their levels, without spending skill points. */
+	public void copyLearnedSkills(final CSimulation game, final CUnit unit, final CAbilityHero source) {
+		for (final java.util.Map.Entry<War3ID, Integer> learned : source.learnedLevels.entrySet()) {
+			final CAbilityType<?> abilityType = game.getAbilityData().getAbilityType(learned.getKey());
+			if (abilityType == null) {
+				continue;
+			}
+			final CAbility copy = abilityType.createAbility(game.getHandleIdAllocator().createId());
+			unit.add(game, copy);
+			this.learnedLevels.put(learned.getKey(), learned.getValue());
+			if ((learned.getValue() > 1) && (copy instanceof CLevelingAbility)) {
+				abilityType.setLevel(game, unit, (CLevelingAbility) copy, learned.getValue());
+			}
+		}
+	}
+
+	/** Gives an illusion its original's level and experience, without level up events or skill points. */
+	public void copyHeroLevel(final CSimulation game, final CUnit unit, final CAbilityHero source) {
+		this.xp = source.xp;
+		this.heroLevel = source.heroLevel;
+		this.skillPoints = 0;
+		calculateDerivatedFields(game, unit);
+		unit.internalPublishHeroStatsChanged();
+	}
+
+	public boolean isRetrainable(final CSimulation game, final CUnit unit) {
+		return !this.learnedLevels.isEmpty();
+	}
+
+	/** Tome of Retraining: every learned skill forgotten and its skill points given back. */
+	public void retrain(final CSimulation game, final CUnit unit) {
+		for (final java.util.Map.Entry<War3ID, Integer> learned : new java.util.ArrayList<>(this.learnedLevels.entrySet())) {
+			final CLevelingAbility ability = unit.getAbility(GetAbilityByRawcodeVisitor.getInstance().reset(learned.getKey()));
+			if (ability != null) {
+				unit.remove(game, ability);
+			}
+			this.skillPoints += learned.getValue();
+		}
+		this.learnedLevels.clear();
+		unit.internalPublishHeroStatsChanged();
+	}
 }
