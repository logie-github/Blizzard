+package com.etheller.warsmash.viewer5.handlers.w3x.simulation.unit;
+
+import java.util.LinkedHashSet;
+import java.util.Set;
+
+import com.etheller.interpreter.ast.scope.GlobalScope;
+import com.etheller.interpreter.ast.scope.TriggerExecutionScope;
+import com.etheller.interpreter.ast.scope.trigger.RemovableTriggerEvent;
+import com.etheller.interpreter.ast.scope.trigger.Trigger;
+import com.etheller.interpreter.ast.scope.trigger.TriggerBooleanExpression;
+import com.etheller.warsmash.parsers.jass.scope.CommonTriggerExecutionScope;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.CSimulation;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.CUnit;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.trigger.JassGameEventsWar3;
+
+/**
+ * TriggerRegisterUnitInRange (Warsmash Reforged's, measured on 1.29): fires once when a unit comes within range of the
+ * centre unit, and again only after it has left; GetTriggerUnit is the unit that came. Blizzard launcher: the engine
+ * had no such event, so campaign triggers waiting on a unit coming near never ran.
+ */
+public final class CUnitInRangeEvent extends RemovableTriggerEvent {
+	private final GlobalScope globalScope;
+	private final CUnit center;
+	private final float range;
+	private final Trigger trigger;
+	private final TriggerBooleanExpression filter;
+	private Set<CUnit> inRange = new LinkedHashSet<>();
+	private Set<CUnit> swap = new LinkedHashSet<>();
+	private final CSimulation simulation;
+
+	public CUnitInRangeEvent(final GlobalScope globalScope, final CSimulation simulation, final CUnit center,
+			final float range, final Trigger trigger, final TriggerBooleanExpression filter) {
+		super(trigger);
+		this.globalScope = globalScope;
+		this.simulation = simulation;
+		this.center = center;
+		this.range = range;
+		this.trigger = trigger;
+		this.filter = filter;
+	}
+
+	@Override
+	public void remove() {
+		this.simulation.removeUnitInRangeEvent(this);
+	}
+
+	public void update(final CSimulation game) {
+		if (this.center.isDead() || this.center.isRemovedFromGame()) {
+			this.inRange.clear();
+			return;
+		}
+		this.swap.clear();
+		game.getWorldCollision().enumUnitsInRange(this.center.getX(), this.center.getY(), this.range, (unit) -> {
+			if ((unit != this.center) && !unit.isDead() && !unit.isHidden()) {
+				this.swap.add(unit);
+			}
+			return false;
+		});
+		for (final CUnit unit : this.swap) {
+			if (!this.inRange.contains(unit)) {
+				final CommonTriggerExecutionScope filterScope = CommonTriggerExecutionScope
+						.filterScope(TriggerExecutionScope.EMPTY, unit);
+				final CommonTriggerExecutionScope scope = CommonTriggerExecutionScope
+						.unitTriggerScope(JassGameEventsWar3.EVENT_UNIT_TARGET_IN_RANGE, this.trigger, unit);
+				this.globalScope.queueTrigger(this.filter, filterScope, this.trigger, scope, scope);
+			}
+		}
+		final Set<CUnit> previous = this.inRange;
+		this.inRange = this.swap;
+		this.swap = previous;
+	}
+}
