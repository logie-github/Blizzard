+				continue;
+			}
+			final com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.generic.CBuff buff = (com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.generic.CBuff) ability;
+			if ((buff instanceof com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.skills.util.CBuffTimedLife) && !timedLife) {
+				continue;
+			}
+			if (buff.isPositive() ? positive : negative) {
+				unit.remove(simulation, buff);
+			}
+		}
+	}
