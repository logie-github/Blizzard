diff --git a/core/src/com/etheller/warsmash/viewer5/handlers/w3x/environment/Terrain.java b/core/src/com/etheller/warsmash/viewer5/handlers/w3x/environment/Terrain.java
index 2a81331..37cd16f 100644
--- a/core/src/com/etheller/warsmash/viewer5/handlers/w3x/environment/Terrain.java
+++ b/core/src/com/etheller/warsmash/viewer5/handlers/w3x/environment/Terrain.java
@@ -1781,4 +1781,49 @@ public class Terrain {
 			this.minShallowColorApplied[i] = this.minShallowColor[i] * rgba[i];
 		}
 	}
+
+	// Blizzard launcher (from Warsmash Reforged): spells that raise or sink the ground change the corners' heights
+	// over a rectangle {x0, y0, x1, y1} of corners by the buffer's world units, and the drawn ground follows.
+	public int[] getTerrainModBufferSize(final float x, final float y, final float width, final float height) {
+		return new int[] { Math.min(this.rows - 1, Math.max(0, get128CellX(x))),
+				Math.min(this.columns - 1, Math.max(0, get128CellY(y))),
+				Math.min(this.rows - 1, Math.max(0, get128CellX(x + width) + 1)),
+				Math.min(this.columns - 1, Math.max(0, get128CellY(y + height) + 1)) };
+	}
+
+	public float getTerrainSpaceX(final float x) {
+		return (x - this.centerOffset[0]) / 128.0f;
+	}
+
+	public float getTerrainSpaceY(final float y) {
+		return (y - this.centerOffset[1]) / 128.0f;
+	}
+
+	public void adjustGround(final int[] rect, final float[] modBuffer) {
+		final int x = rect[0];
+		final int y = rect[1];
+		final int width = (rect[2] - rect[0]) + 1;
+		final int height = (rect[3] - rect[1]) + 1;
+		for (int j = y; j < (y + height); j++) {
+			for (int i = x; i < (x + width); i++) {
+				if ((i < 0) || (j < 0) || (i >= this.columns) || (j >= this.rows)) {
+					continue;
+				}
+				final RenderCorner corner = this.corners[i][j];
+				corner.setGroundHeight(corner.getGroundHeight() + (modBuffer[(i - x) + ((j - y) * width)] / 512));
+			}
+		}
+		updateGroundHeights(new Rectangle(x, y, width, height));
+	}
+
+	public void adjustGround(final float x, final float y, final float amount) {
+		final int column = get128CellX(x);
+		final int row = get128CellY(y);
+		if ((column < 0) || (row < 0) || (column >= this.columns) || (row >= this.rows)) {
+			return;
+		}
+		final RenderCorner corner = this.corners[column][row];
+		corner.setGroundHeight(corner.getGroundHeight() + (amount / 512));
+		updateGroundHeights(new Rectangle(column, row, 1, 1));
+	}
 }
