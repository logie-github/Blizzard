+	/**
+	 * A finger put down on the minimap (Blizzard launcher): true when it is the minimap's, and then nothing else sees it. The first
+	 * one pans the view; another put on the minimap meanwhile does nothing.
+	 */
+	public boolean minimapTouchDown(final int screenX, final int screenY, final int pointer, final int button) {
+		if (!this.userControlEnabled || (button != Input.Buttons.LEFT) || (pointer < 0) || (pointer > 30)) {
+			return false;
+		}
+		screenCoordsVector.set(screenX, screenY);
+		this.uiViewport.unproject(screenCoordsVector);
+		if (!this.meleeUIMinimap.containsMouse(screenCoordsVector.x, screenCoordsVector.y)) {
+			return false;
+		}
+		this.minimapPointers |= (1 << pointer);
+		if (this.minimapPanPointer == -1) {
+			this.minimapPanPointer = pointer;
+			this.minimapPanStartScreen.set(screenX, screenY);
+			this.minimapPanCameraStart.set(this.cameraManager.target);
+			// How far the ground under the middle of the screen moves for a pixel across and up, as the view looks now.
+			final int centerX = (int) (this.war3MapViewer.canvas.getWidth() / 2);
+			final int centerY = (int) (this.war3MapViewer.canvas.getHeight() / 2);
+			final float z = this.cameraManager.target.z;
+			this.war3MapViewer.getClickLocationOnZPlane(this.minimapPanProbeA, centerX, centerY, z);
+			this.war3MapViewer.getClickLocationOnZPlane(this.minimapPanProbeB, centerX + 100, centerY, z);
+			this.minimapPanPerPixelX.set((this.minimapPanProbeB.x - this.minimapPanProbeA.x) / 100f,
+					(this.minimapPanProbeB.y - this.minimapPanProbeA.y) / 100f);
+			this.war3MapViewer.getClickLocationOnZPlane(this.minimapPanProbeB, centerX, centerY + 100, z);
+			this.minimapPanPerPixelY.set((this.minimapPanProbeB.x - this.minimapPanProbeA.x) / 100f,
+					(this.minimapPanProbeB.y - this.minimapPanProbeA.y) / 100f);
+		}
+		return true;
+	}
+
+	/** A minimap finger moving: the panning one moves the view so the ground follows it; true for any of the minimap's fingers. */
+	public boolean minimapTouchDragged(final int screenX, final int screenY, final int pointer) {
+		if ((pointer < 0) || (pointer > 30) || ((this.minimapPointers & (1 << pointer)) == 0)) {
+			return false;
+		}
+		if (pointer == this.minimapPanPointer) {
+			final float across = (screenX - this.minimapPanStartScreen.x) * MINIMAP_PAN_SPEED;
+			// (the screen's y grows downwards, the picking's upwards)
+			final float up = (this.minimapPanStartScreen.y - screenY) * MINIMAP_PAN_SPEED;
+			this.cameraManager.target.x = this.minimapPanCameraStart.x
+					- ((this.minimapPanPerPixelX.x * across) + (this.minimapPanPerPixelY.x * up));
+			this.cameraManager.target.y = this.minimapPanCameraStart.y
+					- ((this.minimapPanPerPixelX.y * across) + (this.minimapPanPerPixelY.y * up));
+		}
+		return true;
+	}
+
+	/** A minimap finger lifted (or its touch cancelled): true when it was the minimap's. */
+	public boolean minimapTouchUp(final int pointer) {
+		if ((pointer < 0) || (pointer > 30) || ((this.minimapPointers & (1 << pointer)) == 0)) {
+			return false;
+		}
+		this.minimapPointers &= ~(1 << pointer);
+		if (pointer == this.minimapPanPointer) {
+			this.minimapPanPointer = -1;
+		}
+		return true;
+	}
