+	/**
+	 * Blizzard launcher: ReviveHero, a dead hero raised by the map's script at a point, with full life and the
+	 * altar's share of mana.
+	 */
+	public void reviveHeroAtPoint(final CSimulation game, final float x, final float y, final boolean doEyecandy) {
+		// Still in the collision tables when the script revives it in its own death event: take it out first.
+		game.getWorldCollision().removeUnit(this);
+		getHeroData().setReviving(false);
+		getHeroData().setAwaitingRevive(false);
+		this.corpse = false;
+		this.boneCorpse = false;
+		this.deathTurnTick = 0;
+		setX(x);
+		setY(y);
+		game.getWorldCollision().addUnit(this);
+		setPoint(x, y, game.getWorldCollision(), game.getRegionManager());
+		setHidden(false);
+		setLife(game, getMaximumLife());
+		final CGameplayConstants gameplayConstants = game.getGameplayConstants();
+		setMana(Math.min(getMaximumMana(), (getMaximumMana() * gameplayConstants.getHeroReviveManaFactor())
+				+ (gameplayConstants.getHeroReviveManaStart() * this.unitType.getManaInitial())));
+		game.unitRepositioned(this);
+		game.heroReviveEvent(this, this);
+	}
