+		if ((renderUnit == null) || (select && (unit.isDead() || unit.isHidden()))) {
+			return;
+		}
+		final List<RenderWidget> newSelection = new ArrayList<>(this.selectedUnits);
+		if (select == newSelection.contains(renderUnit)) {
+			return;
