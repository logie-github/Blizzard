+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.skills.CAbilityPointTargetSpellBase;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.skills.util.CBuffSlow;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.targeting.AbilityTarget;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.types.definitions.impl.AbilityFields;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.types.definitions.impl.AbstractCAbilityTypeDefinition;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.combat.CAttackType;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.orders.OrderIds;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.trigger.enumtypes.CDamageType;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.trigger.enumtypes.CEffectType;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.trigger.enumtypes.CWeaponSoundTypeJass;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.util.SimulationRenderComponent;
+
+/**
+ * Earthquake (AOeq), channeled: after the effect delay (Data A) the ground at the target shakes for the spell's
+ * duration, damaging buildings (Data B per second) and slowing ground units (Data C) inside an area that grows from
+ * the ability's area to its final area (Data D).
+ */
+public class CAbilityEarthquake extends CAbilityPointTargetSpellBase {
+	private static final float INTERVAL = 0.25f;
+
+	private float effectDelay;
+	private float buildingDamagePerSecond;
+	private float slowPercent;
+	private float areaOfEffect;
+	private float finalArea;
+	private War3ID buffId;
+	private War3ID effectId;
+
+	private int startTick;
+	private int endTick;
+	private int nextTick;
+	private SimulationRenderComponent effect;
+	private final Map<CUnit, CBuffSlow> slowed = new HashMap<>();
+	private final Rectangle recycleRect = new Rectangle();
+
+	public CAbilityEarthquake(final int handleId, final War3ID alias) {
+		super(handleId, alias);
+	}
+
+	@Override
+	public int getBaseOrderId() {
+		return OrderIds.earthquake;
+	}
+
+	@Override
+	public void populateData(final GameObject worldEditorAbility, final int level) {
+		this.effectDelay = worldEditorAbility.getFieldAsFloat(AbilityFields.DATA_A + level, 0);
+		this.buildingDamagePerSecond = worldEditorAbility.getFieldAsFloat(AbilityFields.DATA_B + level, 0);
+		this.slowPercent = worldEditorAbility.getFieldAsFloat(AbilityFields.DATA_C + level, 0);
+		this.finalArea = worldEditorAbility.getFieldAsFloat(AbilityFields.DATA_D + level, 0);
+		this.areaOfEffect = worldEditorAbility.getFieldAsFloat(AbilityFields.AREA_OF_EFFECT + level, 0);
+		this.buffId = AbstractCAbilityTypeDefinition.getBuffId(worldEditorAbility, level);
+		this.effectId = AbstractCAbilityTypeDefinition.getEffectId(worldEditorAbility, level);
+	}
+
+	private static int ticks(final float seconds) {
+		return (int) StrictMath.ceil(seconds / WarsmashConstants.SIMULATION_STEP_TIME);
+	}
+
+	@Override
+	public boolean doEffect(final CSimulation simulation, final CUnit caster, final AbilityTarget target) {
+		final int now = simulation.getGameTurnTick();
+		this.startTick = now + ticks(this.effectDelay);
+		this.endTick = this.startTick + ticks(getDuration());
+		this.nextTick = this.startTick;
+		this.slowed.clear();
+		this.effect = simulation.spawnSpellEffectOnPoint(target.getX(), target.getY(), 0, this.effectId,
+				CEffectType.EFFECT, 0);
+		return true;
+	}
+
+	@Override
+	public boolean doChannelTick(final CSimulation simulation, final CUnit caster, final AbilityTarget target) {
+		final int now = simulation.getGameTurnTick();
+		if (now >= this.endTick) {
+			return false;
+		}
+		if (now < this.nextTick) {
+			return true;
+		}
+		this.nextTick = now + ticks(INTERVAL);
+		final float progress = (now - this.startTick) / (float) Math.max(1, this.endTick - this.startTick);
+		final float area = this.areaOfEffect
+				+ ((Math.max(this.finalArea, this.areaOfEffect) - this.areaOfEffect) * progress);
+		final float buildingDamage = this.buildingDamagePerSecond * INTERVAL;
+		final float slowDuration = (this.endTick - now) * WarsmashConstants.SIMULATION_STEP_TIME;
+		final Map<CUnit, CBuffSlow> inside = new HashMap<>();
+		simulation.getWorldCollision().enumUnitsInRect(
+				this.recycleRect.set(target.getX() - area, target.getY() - area, area * 2, area * 2), (unit) -> {
+					if (!unit.isDead() && unit.canReach(target, area)
+							&& unit.canBeTargetedBy(simulation, caster, getTargetsAllowed())) {
+						if (unit.isBuilding()) {
+							unit.damage(simulation, caster, false, true, CAttackType.SPELLS, CDamageType.DEMOLITION,
+									CWeaponSoundTypeJass.WHOKNOWS.name(), buildingDamage);
+						}
+						else {
+							CBuffSlow slow = this.slowed.remove(unit);
+							if ((slow == null) || !unit.getAbilities().contains(slow)) {
+								slow = new CBuffSlow(simulation.getHandleIdAllocator().createId(), this.buffId,
+										slowDuration, 0, this.slowPercent);
+								unit.add(simulation, slow);
+							}
+							inside.put(unit, slow);
+						}
+					}
+					return false;
+				});
+		endSlows(simulation);
+		this.slowed.putAll(inside);
+		return true;
+	}
+
+	/** Takes the slow off every unit that still has it from this earthquake. */
+	private void endSlows(final CSimulation simulation) {
+		for (final Map.Entry<CUnit, CBuffSlow> entry : this.slowed.entrySet()) {
+			if (entry.getKey().getAbilities().contains(entry.getValue())) {
+				entry.getKey().remove(simulation, entry.getValue());
+			}
+		}
+		this.slowed.clear();
+	}
+
+	@Override
+	public void doChannelEnd(final CSimulation game, final CUnit unit, final AbilityTarget target,
+			final boolean interrupted) {
+		endSlows(game);
+		if (this.effect != null) {
+			this.effect.remove();
+			this.effect = null;
+		}
+	}
+
+	@Override
+	public float getUIAreaOfEffect() {
+		return this.areaOfEffect;
+	}
+}
