+	// Blizzard launcher: rescue (the fork's, measured on 1.29). A unit of a player whose controller is "rescuable" is
+	// rescuable by the players that player has ALLIANCE_RESCUABLE towards; SetUnitRescuable turns that on or off for
+	// one unit and one player. The first tick a ground unit of such a player stands within the rescue range, the unit
+	// fires EVENT_UNIT_RESCUED and its owner's EVENT_PLAYER_UNIT_RESCUED; Blizzard.j's RescueUnitBJ (set up by
+	// InitRescuableBehaviorBJ) hands the unit over, and a rescued unit rescues those near it in turn.
+	public static final float DEFAULT_RESCUE_RANGE = 414.5f;
+	private static final int RESCUE_REPEAT_TICKS = (int) (1 / WarsmashConstants.SIMULATION_STEP_TIME);
+	private float rescueRange = DEFAULT_RESCUE_RANGE;
+	private int rescuableByPlayers;
+	private int unrescuableByPlayers;
+	private int lastRescueTick = Integer.MIN_VALUE / 2;
+
+	public void setRescuable(final int byPlayerIndex, final boolean rescuable) {
+		final int bit = 1 << byPlayerIndex;
+		if (rescuable) {
+			this.rescuableByPlayers |= bit;
+			this.unrescuableByPlayers &= ~bit;
+		}
+		else {
+			this.unrescuableByPlayers |= bit;
+			this.rescuableByPlayers &= ~bit;
+		}
+	}
+
+	public void setRescueRange(final float rescueRange) {
+		this.rescueRange = rescueRange;
+	}
+
+	public boolean isRescuableBy(final CSimulation simulation, final int byPlayerIndex) {
+		final int bit = 1 << byPlayerIndex;
+		if ((this.unrescuableByPlayers & bit) != 0) {
+			return false;
+		}
+		if ((this.rescuableByPlayers & bit) != 0) {
+			return true;
+		}
+		final CPlayer owner = simulation.getPlayer(this.playerIndex);
+		return (owner.getController() == com.etheller.warsmash.viewer5.handlers.w3x.simulation.players.CMapControl.RESCUABLE)
+				&& owner.hasAlliance(byPlayerIndex, com.etheller.warsmash.viewer5.handlers.w3x.simulation.players.CAllianceType.RESCUABLE);
+	}
+
+	public void checkRescue(final CSimulation simulation) {
+		if ((this.rescuableByPlayers == 0) && (simulation.getPlayer(this.playerIndex)
+				.getController() != com.etheller.warsmash.viewer5.handlers.w3x.simulation.players.CMapControl.RESCUABLE)) {
+			return;
+		}
+		if (isDead() || isHidden() || ((simulation.getGameTurnTick() - this.lastRescueTick) < RESCUE_REPEAT_TICKS)) {
+			return;
+		}
+		final float range = this.rescueRange;
+		final float x = getX();
+		final float y = getY();
+		final CUnit[] rescuer = { null };
+		simulation.getWorldCollision().enumUnitsInRect(new Rectangle(x - range, y - range, range * 2, range * 2),
+				(enumUnit) -> {
+					if ((enumUnit.getPlayerIndex() != this.playerIndex) && !enumUnit.isDead() && !enumUnit.isHidden()
+							&& !enumUnit.isBuilding() && (enumUnit.getMovementType() != MovementType.FLY)
+							&& (StrictMath.hypot(enumUnit.getX() - x, enumUnit.getY() - y) <= range)
+							&& isRescuableBy(simulation, enumUnit.getPlayerIndex())) {
+						rescuer[0] = enumUnit;
+						return true;
+					}
+					return false;
+				});
+		if (rescuer[0] == null) {
+			return;
+		}
+		this.lastRescueTick = simulation.getGameTurnTick();
+		final CUnit rescuingUnit = rescuer[0];
+		simulation.fireUnitEvents(this, JassGameEventsWar3.EVENT_UNIT_RESCUED, JassGameEventsWar3.EVENT_PLAYER_UNIT_RESCUED,
+				(scope) -> scope.rescued(rescuingUnit));
+	}
