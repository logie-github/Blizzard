+	/** A unit of a player who is neither the local player nor allied to them (a neutral hostile counts). */
+	private boolean isEnemyOfLocalPlayer(final RenderWidget widget) {
+		if (!(widget instanceof RenderUnit)) {
+			return false;
+		}
+		final int owner = ((RenderUnit) widget).getSimulationUnit().getPlayerIndex();
+		final int local = this.war3MapViewer.getLocalPlayerIndex();
+		return (owner != local) && !this.war3MapViewer.simulation.getPlayer(local).hasAlliance(owner,
+				CAllianceType.PASSIVE);
+	}
