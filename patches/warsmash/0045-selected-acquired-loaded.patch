+	/**
+	 * Blizzard launcher: the local player selected a unit: the unit's own "is selected" triggers and the selecting
+	 * player's (the triggering player is the one who selected).
+	 */
+	public void unitSelected(final CUnit unit, final int selectorIndex) {
+		if (unit == null) {
+			return;
+		}
+		final com.etheller.warsmash.viewer5.handlers.w3x.simulation.players.CPlayer selector = getPlayer(selectorIndex);
+		final List<com.etheller.warsmash.viewer5.handlers.w3x.simulation.unit.CWidgetEvent> unitEvents = unit
+				.getEventList(com.etheller.warsmash.viewer5.handlers.w3x.simulation.trigger.JassGameEventsWar3.EVENT_UNIT_SELECTED);
+		if (unitEvents != null) {
+			for (final com.etheller.warsmash.viewer5.handlers.w3x.simulation.unit.CWidgetEvent event : new ArrayList<>(
+					unitEvents)) {
+				event.fire(unit, com.etheller.warsmash.parsers.jass.scope.CommonTriggerExecutionScope.unitEventScope(
+						com.etheller.warsmash.viewer5.handlers.w3x.simulation.trigger.JassGameEventsWar3.EVENT_UNIT_SELECTED,
+						event.getTrigger(), unit, selector));
+			}
+		}
+		selector.fireUnitEvents(
+				com.etheller.warsmash.viewer5.handlers.w3x.simulation.trigger.JassGameEventsWar3.EVENT_PLAYER_UNIT_SELECTED,
+				unit, null);
+	}
