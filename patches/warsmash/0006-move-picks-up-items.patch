+	/**
+	 * Blizzard launcher: Move tapped on an item the unit can carry picks it up (it walks over and takes it), as the
+	 * original's right click on an item does; Move alone only targets units, so the tap was a move to the ground.
+	 */
+	private boolean pickUpItemWithMove(final int screenX, final float worldScreenY, final boolean shiftDown) {
+		if ((this.activeCommandOrderId != OrderIds.move) || (this.draggingItem != null)
+				|| (this.activeCommandUnit == null)) {
+			return false;
+		}
+		final RenderWidget picked = this.war3MapViewer.rayPickUnit(screenX, worldScreenY,
+				widget -> (widget instanceof CItem) && !((CItem) widget).isHidden() && !widget.isDead());
+		if (picked == null) {
+			return false;
+		}
+		final CUnit unit = this.activeCommandUnit.getSimulationUnit();
+		for (final CAbility ability : unit.getAbilities()) {
+			if (!(ability instanceof CAbilityInventory)) {
+				continue;
+			}
+			final CWidgetAbilityTargetCheckReceiver receiver = CWidgetAbilityTargetCheckReceiver.INSTANCE.reset();
+			ability.checkCanTarget(this.war3MapViewer.simulation, unit, OrderIds.getitem,
+					picked.getSimulationWidget(), receiver);
+			if (receiver.getTarget() == null) {
+				continue;
+			}
+			this.unitOrderListener.issueTargetOrder(unit.getHandleId(), ability.getHandleId(), OrderIds.getitem,
+					picked.getSimulationWidget().getHandleId(), shiftDown);
+			if (getSelectedUnit().soundset.yes.playUnitResponse(this.war3MapViewer.worldScene.audioContext,
+					getSelectedUnit())) {
+				portraitTalk(getSelectedUnit().soundset.yes);
+			}
+			this.selectedSoundCount = 0;
+			if (!shiftDown) {
+				this.subMenuOrderIdStack.clear();
+				this.activeCommandUnit = null;
+				this.activeCommand = null;
+				this.activeCommandOrderId = -1;
+				clearAndRepopulateCommandCard();
+			}
+			return true;
+		}
+		return false;
+	}
