+package com.etheller.warsmash.viewer5.handlers.w3x.simulation;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.timers.CTimer;
+
+/**
+ * Blizzard launcher: the ground effects that hurt units standing in them (Death and Decay, Starfall), as Warsmash
+ * Reforged registers them. Reforged's computer units step out of them; this engine only records them for now.
+ */
+public class CHarmfulAreas {
+	public static final class Area {
+		private final CUnit source;
+		private final float x;
+		private final float y;
+		private final float radius;
+		private final int endTick;
+
+		private Area(final CUnit source, final float x, final float y, final float radius, final int endTick) {
+			this.source = source;
+			this.x = x;
+			this.y = y;
+			this.radius = radius;
+			this.endTick = endTick;
+		}
+	}
+
+	private final List<Area> areas = new ArrayList<>();
+
+	public Area add(final CSimulation game, final CUnit source, final float x, final float y, final float radius,
+			final float hurtDelay, final float duration) {
+		return add(game, source, x, y, radius, hurtDelay, duration, false);
+	}
+
+	public Area add(final CSimulation game, final CUnit source, final float x, final float y, final float radius,
+			final float hurtDelay, final float duration, final boolean hurtOnly) {
+		final int tick = game.getGameTurnTick();
+		this.areas.removeIf(area -> area.endTick < tick);
+		final Area area = new Area(source, x, y, radius, tick + CTimer.wholeSteps(duration));
+		this.areas.add(area);
+		return area;
+	}
+
+	public void arm(final CSimulation game, final Area area, final float hurtDelay) {
+	}
+}
