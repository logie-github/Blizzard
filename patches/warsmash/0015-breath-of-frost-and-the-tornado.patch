+package com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.skills.neutral.seawitch;
+
+import com.etheller.warsmash.units.GameObject;
+import com.etheller.warsmash.util.War3ID;
+import com.etheller.warsmash.util.WarsmashConstants;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.CSimulation;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.CUnit;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.skills.CAbilityPassiveSpellBase;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.types.definitions.impl.AbilityFields;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.types.definitions.impl.AbstractCAbilityTypeDefinition;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.targeting.AbilityPointTarget;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.orders.OrderIds;
+
+/**
+ * The Tornado's wandering (Atwa): every duration (2 seconds) it moves to a random point within its cast range of where
+ * it was made. Blizzard launcher, written for this engine.
+ */
+public class CAbilityTornadoWander extends CAbilityPassiveSpellBase {
+	private float homeX = Float.NaN;
+	private float homeY;
+	private int nextTick;
+
+	public CAbilityTornadoWander(final int handleId, final War3ID code, final War3ID alias) {
+		super(handleId, code, alias);
+	}
+
+	@Override
+	public void populateData(final GameObject worldEditorAbility, final int level) {
+	}
+
+	@Override
+	public void onTick(final CSimulation game, final CUnit tornado) {
+		super.onTick(game, tornado);
+		if (Float.isNaN(this.homeX)) {
+			this.homeX = tornado.getX();
+			this.homeY = tornado.getY();
+		}
+		final int tick = game.getGameTurnTick();
+		if (tick < this.nextTick) {
+			return;
+		}
+		final float every = getDuration() > 0 ? getDuration() : 2;
+		this.nextTick = tick + (int) (every / WarsmashConstants.SIMULATION_STEP_TIME);
+		final float range = getCastRange() > 0 ? getCastRange() : 600;
+		final double angle = game.getSeededRandom().nextDouble() * StrictMath.PI * 2;
+		final double distance = game.getSeededRandom().nextDouble() * range;
+		tornado.order(game, OrderIds.move, new AbilityPointTarget((float) (this.homeX + (StrictMath.cos(angle) * distance)),
+				(float) (this.homeY + (StrictMath.sin(angle) * distance))));
+	}
+}
