+package com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.skills.neutral.seawitch;
+
+import com.etheller.warsmash.units.GameObject;
+import com.etheller.warsmash.util.War3ID;
+import com.etheller.warsmash.util.WarsmashConstants;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.CSimulation;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.CUnit;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.skills.CAbilityPassiveSpellBase;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.types.definitions.impl.AbilityFields;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.types.definitions.impl.AbstractCAbilityTypeDefinition;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.combat.CAttackType;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.trigger.enumtypes.CDamageType;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.trigger.enumtypes.CWeaponSoundTypeJass;
+
+/**
+ * The Tornado's damage (Atdg): every second, what it may target within its area takes Data A, within Data B Data C,
+ * within Data D Data E (the nearest band counts). Blizzard launcher, written for this engine.
+ */
+public class CAbilityTornadoDamage extends CAbilityPassiveSpellBase {
+	private float damage;
+	private float mediumRadius;
+	private float mediumDamage;
+	private float smallRadius;
+	private float smallDamage;
+	private int nextTick;
+
+	public CAbilityTornadoDamage(final int handleId, final War3ID code, final War3ID alias) {
+		super(handleId, code, alias);
+	}
+
+	@Override
+	public void populateData(final GameObject worldEditorAbility, final int level) {
+		this.damage = worldEditorAbility.getFieldAsFloat(AbilityFields.DATA_A + level, 0);
+		this.mediumRadius = worldEditorAbility.getFieldAsFloat(AbilityFields.DATA_B + level, 0);
+		this.mediumDamage = worldEditorAbility.getFieldAsFloat(AbilityFields.DATA_C + level, 0);
+		this.smallRadius = worldEditorAbility.getFieldAsFloat(AbilityFields.DATA_D + level, 0);
+		this.smallDamage = worldEditorAbility.getFieldAsFloat(AbilityFields.DATA_E + level, 0);
+	}
+
+	@Override
+	public void onTick(final CSimulation game, final CUnit tornado) {
+		super.onTick(game, tornado);
+		if (game.getGameTurnTick() < this.nextTick) {
+			return;
+		}
+		this.nextTick = game.getGameTurnTick() + (int) (1.0f / WarsmashConstants.SIMULATION_STEP_TIME);
+		game.getWorldCollision().enumUnitsInRange(tornado.getX(), tornado.getY(), getAreaOfEffect(), (unit) -> {
+			if ((unit != tornado) && !unit.isDead() && unit.canBeTargetedBy(game, tornado, getTargetsAllowed())) {
+				final double distance = tornado.distance(unit);
+				float amount = this.damage;
+				if ((this.smallRadius > 0) && (distance <= this.smallRadius)) {
+					amount = this.smallDamage;
+				}
+				else if ((this.mediumRadius > 0) && (distance <= this.mediumRadius)) {
+					amount = this.mediumDamage;
+				}
+				if (amount > 0) {
+					unit.damage(game, tornado, false, true, CAttackType.SPELLS, CDamageType.UNIVERSAL,
+							CWeaponSoundTypeJass.WHOKNOWS.name(), amount);
+				}
+			}
+			return false;
+		});
+	}
+}
