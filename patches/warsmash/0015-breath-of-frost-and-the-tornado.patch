+package com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.skills.neutral.seawitch;
+
+import java.util.HashMap;
+import java.util.Map;
+
+import com.etheller.warsmash.units.GameObject;
+import com.etheller.warsmash.util.War3ID;
+import com.etheller.warsmash.util.WarsmashConstants;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.CSimulation;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.CUnit;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.skills.CAbilityPassiveSpellBase;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.types.definitions.impl.AbilityFields;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.types.definitions.impl.AbstractCAbilityTypeDefinition;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.skills.util.CBuffStun;
+
+/**
+ * The Tornado's spin (Atsp): ground units it may target within its area are caught up and can't act for the spell's
+ * duration (heroes for the hero duration), each at most once every Data B seconds. Drawn as a stun; the lift into
+ * the air is not. Blizzard launcher, written for this engine.
+ */
+public class CAbilityTornadoSpin extends CAbilityPassiveSpellBase {
+	private float minimumHitInterval;
+	private War3ID buffId;
+	private final Map<CUnit, Integer> nextHit = new HashMap<>();
+
+	public CAbilityTornadoSpin(final int handleId, final War3ID code, final War3ID alias) {
+		super(handleId, code, alias);
+	}
+
+	@Override
+	public void populateData(final GameObject worldEditorAbility, final int level) {
+		this.minimumHitInterval = worldEditorAbility.getFieldAsFloat(AbilityFields.DATA_B + level, 0);
+		this.buffId = AbstractCAbilityTypeDefinition.getBuffId(worldEditorAbility, level);
+	}
+
+	@Override
+	public void onTick(final CSimulation game, final CUnit tornado) {
+		super.onTick(game, tornado);
+		final int tick = game.getGameTurnTick();
+		if ((tick % 5) != 0) {
+			return;
+		}
+		this.nextHit.values().removeIf((t) -> t < tick);
+		game.getWorldCollision().enumUnitsInRange(tornado.getX(), tornado.getY(), getAreaOfEffect(), (unit) -> {
+			if ((unit != tornado) && !unit.isDead() && !unit.isBuilding() && !this.nextHit.containsKey(unit)
+					&& unit.canBeTargetedBy(game, tornado, getTargetsAllowed())) {
+				final float duration = getDurationForTarget(unit);
+				unit.add(game, new CBuffStun(game.getHandleIdAllocator().createId(), this.buffId, duration));
+				this.nextHit.put(unit, tick + (int) ((duration + this.minimumHitInterval) / WarsmashConstants.SIMULATION_STEP_TIME));
+			}
+			return false;
+		});
+	}
+}
