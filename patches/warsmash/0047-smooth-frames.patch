--- /dev/null
+++ b/core/src/com/etheller/warsmash/viewer5/handlers/w3x/AssetPredecoder.java
@@ -0,0 +1,67 @@
+package com.etheller.warsmash.viewer5.handlers.w3x;
+
+import java.io.InputStream;
+import java.nio.ByteBuffer;
+
+import org.apache.commons.io.IOUtils;
+
+import com.etheller.warsmash.datasources.DataSource;
+import com.etheller.warsmash.util.ImageUtils;
+import com.etheller.warsmash.viewer5.handlers.mdx.ReplaceableIds;
+import com.hiveworkshop.rms.parsers.mdlx.MdlxModel;
+import com.hiveworkshop.rms.parsers.mdlx.MdlxTexture;
+
+/**
+ * Blizzard launcher: decodes the textures of a model ahead of the load that will need them (it can run on a thread of
+ * its own: nothing here touches the graphics card). Decoding a BLP is most of what loading a model takes.
+ */
+final class AssetPredecoder {
+	private AssetPredecoder() {
+	}
+
+	static byte[] readAll(final DataSource dataSource, final String path) {
+		try {
+			if (!dataSource.has(path)) {
+				return null;
+			}
+			try (InputStream in = dataSource.getResourceAsStream(path)) {
+				return in == null ? null : IOUtils.toByteArray(in);
+			}
+		}
+		catch (final Exception exc) {
+			return null;
+		}
+	}
+
+	static void predecodeModel(final DataSource dataSource, final String modelPath) {
+		try {
+			final byte[] model = readAll(dataSource, modelPath);
+			if (model == null) {
+				return;
+			}
+			final MdlxModel parser = new MdlxModel(ByteBuffer.wrap(model));
+			for (final MdlxTexture texture : parser.getTextures()) {
+				String path = texture.getPath();
+				final int replaceableId = texture.getReplaceableId();
+				if (replaceableId != 0) {
+					final String idString = ((replaceableId == 1) || (replaceableId == 2)) ? ReplaceableIds.getIdString(0)
+							: "";
+					path = "ReplaceableTextures\\" + ReplaceableIds.getPathString(replaceableId) + idString + ".blp";
+				}
+				else if ("".equals(path)) {
+					path = "Textures\\white.blp";
+				}
+				if ((path == null) || !path.toLowerCase().endsWith(".blp")) {
+					continue;
+				}
+				final byte[] bytes = readAll(dataSource, path);
+				if (bytes != null) {
+					ImageUtils.predecode(bytes);
+				}
+			}
+		}
+		catch (final Throwable exc) {
+			// whatever cannot be decoded early is decoded when its model loads, as before
+		}
+	}
+}
