+	// Blizzard launcher: textures decoded ahead of the load that needs them, by the threads that preload a map's unit
+	// types (decoding a BLP is most of the time a model takes to load). Found by what the file holds, and taken out
+	// when used.
+	private static final java.util.concurrent.ConcurrentHashMap<Long, Object[]> PREDECODED = new java.util.concurrent.ConcurrentHashMap<>();
+
+	private static long contentKey(final byte[] bytes) {
+		final java.util.zip.CRC32 crc = new java.util.zip.CRC32();
+		crc.update(bytes, 0, bytes.length);
+		return (crc.getValue() << 32) | bytes.length;
+	}
+
+	/** Decodes a BLP now and keeps the result for the {@link #getPixmap(byte[])} of the same file. */
+	public static void predecode(final byte[] bytes) {
+		final long key = contentKey(bytes);
+		if (PREDECODED.containsKey(key)) {
+			return;
+		}
+		final var data = Blp2.getImageData(Blp2.decode(bytes), 0);
+		PREDECODED.put(key, new Object[] { data.width, data.height, data.data });
+	}
+
+	public static void clearPredecoded() {
+		PREDECODED.clear();
+	}
+
 	public static Pixmap getPixmap(byte[] bytes) throws IOException {
+		if (!PREDECODED.isEmpty()) {
+			final Object[] done = PREDECODED.remove(contentKey(bytes));
+			if (done != null) {
+				final int width = (Integer) done[0];
+				final int height = (Integer) done[1];
+				final var ready = new Pixmap(width, height, Pixmap.Format.RGBA8888);
+				ready.setPixels((ByteBuffer) BufferUtils.createByteBuffer(width * height * 4).put((byte[]) done[2]).flip());
+				return ready;
+			}
+		}
 		var image = Blp2.decode(bytes);
 		var data = Blp2.getImageData(image, 0);
 		var pixmap = new Pixmap(data.width, data.height, Pixmap.Format.RGBA8888);
