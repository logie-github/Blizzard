+	public void preloadUnitTypes() {
+		final long start = System.nanoTime();
+		final java.util.ArrayDeque<War3ID> queue = new java.util.ArrayDeque<>();
+		final Set<War3ID> seen = new HashSet<>();
+		queue.addAll(this.placedUnitTypes);
+		final String[] fields = { "Builds", "Trains", "Upgrade" };
+		while (!queue.isEmpty()) {
+			final War3ID id = queue.poll();
+			if (!seen.add(id)) {
+				continue;
+			}
+			final GameObject row = this.allObjectData.getUnits().get(id);
+			if (row == null) {
+				continue;
+			}
+			for (final String field : fields) {
+				final List<String> ids = row.getFieldAsList(field);
+				if (ids != null) {
+					for (final String next : ids) {
+						final String trimmed = next.trim();
+						if (trimmed.length() == 4) {
+							queue.add(War3ID.fromString(trimmed));
+						}
+					}
+				}
+			}
+		}
+		// What is loaded, in order: each unit type's render data, then the art of the abilities those units have (a spell
+		// cast for the first time loaded its effect models the same way, in the middle of play).
+		final List<String> modelPaths = new java.util.ArrayList<>();
+		final List<Runnable> loads = new java.util.ArrayList<>();
+		for (final War3ID id : seen) {
+			if (this.renderUnitTypeData.peek(id) != null) {
+				continue;
+			}
+			modelPaths.add(this.renderUnitTypeData.getModelPath(id));
+			loads.add(() -> this.renderUnitTypeData.get(id));
+		}
+		final int unitTypeCount = loads.size();
+		final Set<War3ID> abilities = new HashSet<>();
+		abilities.add(War3ID.fromString("Asla"));
+		for (final War3ID id : seen) {
+			final GameObject row = this.allObjectData.getUnits().get(id);
+			if (row == null) {
+				continue;
+			}
+			for (final String field : new String[] { "abilList", "heroAbilList" }) {
+				final List<String> ids = row.getFieldAsList(field);
+				if (ids != null) {
+					for (final String next : ids) {
+						final String trimmed = next.trim();
+						if (trimmed.length() == 4) {
+							abilities.add(War3ID.fromString(trimmed));
+						}
+					}
+				}
+			}
+		}
+		final Set<String> effectModels = new HashSet<>();
+		for (final War3ID ability : abilities) {
+			for (final CEffectType effectType : new CEffectType[] { CEffectType.EFFECT, CEffectType.TARGET,
+					CEffectType.CASTER, CEffectType.SPECIAL, CEffectType.AREA_EFFECT }) {
+				try {
+					final List<EffectAttachmentUI> effects = getEffectAttachmentUIList(ability, effectType);
+					if (effects != null) {
+						for (final EffectAttachmentUI effect : effects) {
+							final String modelPath = effect.getModelPath();
+							if ((modelPath != null) && !modelPath.isEmpty() && effectModels.add(modelPath)) {
+								modelPaths.add(modelPath);
+								loads.add(() -> loadModelMdx(modelPath));
+							}
+						}
+					}
+				}
+				catch (final Exception exc) {
+					// an ability without art
+				}
+			}
+		}
+		// The textures are decoded on other threads a few models ahead of the loading here, which has to be on this
+		// thread (it makes graphics objects); the decoding was most of the time.
+		int loaded = 0;
+		final int threads = Math.max(1, Math.min(6, Runtime.getRuntime().availableProcessors() - 1));
+		final int window = threads * 2;
+		final java.util.concurrent.ExecutorService pool = java.util.concurrent.Executors.newFixedThreadPool(threads,
+				runnable -> {
+					final Thread thread = new Thread(runnable, "unit type preload");
+					thread.setDaemon(true);
+					return thread;
+				});
+		final java.util.List<java.util.concurrent.Future<?>> ahead = new java.util.ArrayList<>();
+		try {
+			int submitted = 0;
+			for (int k = 0; k < loads.size(); k++) {
+				while ((submitted < loads.size()) && (submitted < (k + window))) {
+					final String submit = modelPaths.get(submitted++);
+					ahead.add(pool.submit(() -> {
+						if (submit != null) {
+							AssetPredecoder.predecodeModel(this.dataSource, submit);
+						}
+					}));
+				}
+				try {
+					ahead.get(k).get();
+				}
+				catch (final Exception exc) {
+					// not decoded ahead: decoded when loaded
+				}
+				try {
+					loads.get(k).run();
