+	// A unit shows its health bar for HEALTH_BAR_HOLD_TICKS after it is hurt, then fades over HEALTH_BAR_FADE_TICKS; a
+	// selected unit's bar stays. Green for the local player's units and allies, red for everyone else's.
+	private static final int HEALTH_BAR_HOLD_TICKS = 60;
+	private static final int HEALTH_BAR_FADE_TICKS = 20;
+	private final List<float[]> healthBars = new ArrayList<>();
+	private final Vector3 healthBarPoint = new Vector3();
+
+	private void renderUnitHealthBars(final SpriteBatch batch) {
+		final CSimulation simulation = this.war3MapViewer.simulation;
+		final int tick = simulation.getGameTurnTick();
+		final int localIndex = this.war3MapViewer.getLocalPlayerIndex();
+		final CPlayer localPlayer = simulation.getPlayer(localIndex);
+		final com.etheller.warsmash.viewer5.Camera camera = this.war3MapViewer.worldScene.camera;
+		this.healthBars.clear();
+		for (final CUnit unit : simulation.getUnits()) {
+			if (unit.isDead() || unit.isHidden() || (unit.getMaximumLife() <= 0)) {
+				continue;
+			}
+			final int sinceHurt = (unit.getLastHurtTick() < 0) ? Integer.MAX_VALUE : (tick - unit.getLastHurtTick());
+			float alpha = 0;
+			if (sinceHurt < (HEALTH_BAR_HOLD_TICKS + HEALTH_BAR_FADE_TICKS)) {
+				alpha = (sinceHurt < HEALTH_BAR_HOLD_TICKS) ? 1f
+						: 1f - ((sinceHurt - HEALTH_BAR_HOLD_TICKS) / (float) HEALTH_BAR_FADE_TICKS);
+			}
+			final RenderUnit peer = this.war3MapViewer.getRenderPeer(unit);
+			if (peer == null) {
+				continue;
+			}
+			if ((alpha == 0) && this.selectedUnits.contains(peer)) {
+				alpha = 1f;
+			}
+			if ((alpha == 0) || !unit.isVisible(simulation, localIndex)) {
+				continue;
+			}
+			this.healthBarPoint.set(peer.getX(), peer.getY(), peer.getZ() + peer.getSelectionHeight() + 20);
+			camera.worldToScreen(screenCoordsVector, this.healthBarPoint);
+			final float screenX = screenCoordsVector.x;
+			final float screenY = screenCoordsVector.y;
+			if (!camera.rect.contains(screenX, Gdx.graphics.getHeight() - screenY)) {
+				continue;
+			}
+			// the bar is as wide as the unit looks on the ground: the screen width of its selection scale
+			final float size = Math.max(peer.getSelectionScale(), 40f);
+			this.healthBarPoint.add(size, 0, 0);
+			camera.worldToScreen(screenCoordsVector, this.healthBarPoint);
+			final float dx = Math.abs(screenCoordsVector.x - screenX);
+			this.healthBarPoint.add(-size, size, 0);
+			camera.worldToScreen(screenCoordsVector, this.healthBarPoint);
+			final float widthPixels = (float) Math.hypot(dx, Math.abs(screenCoordsVector.x - screenX));
+			screenCoordsVector.set(screenX, screenY);
+			final Vector2 base = this.uiViewport.unproject(screenCoordsVector);
+			screenCoordsVector.set(screenX + widthPixels, screenY);
+			final Vector2 side = this.uiViewport.unproject(screenCoordsVector);
+			final float width = Math.max(28f, Math.abs(side.x - base.x));
+			final boolean friendly = (unit.getPlayerIndex() == localIndex)
+					|| localPlayer.hasAlliance(unit.getPlayerIndex(), CAllianceType.PASSIVE);
+			this.healthBars.add(new float[] { base.x, base.y, width, unit.getLife() / unit.getMaximumLife(),
+					friendly ? 1 : 0, alpha });
+		}
+		if (this.healthBars.isEmpty()) {
+			return;
+		}
+		batch.end();
+		Gdx.gl.glEnable(GL20.GL_BLEND);
+		Gdx.gl.glBlendFunc(GL20.GL_SRC_ALPHA, GL20.GL_ONE_MINUS_SRC_ALPHA);
+		this.shapeRenderer.setProjectionMatrix(batch.getProjectionMatrix());
+		this.shapeRenderer.begin(ShapeType.Filled);
+		final float height = Math.max(5f, this.uiViewport.getWorldHeight() * 0.0075f);
+		for (final float[] bar : this.healthBars) {
+			final float left = bar[0] - (bar[2] / 2);
+			final float ratio = Math.max(0f, Math.min(1f, bar[3]));
+			this.shapeRenderer.setColor(0, 0, 0, 0.75f * bar[5]);
+			this.shapeRenderer.rect(left - 1, bar[1] - 1, bar[2] + 2, height + 2);
+			this.shapeRenderer.setColor(0.25f, 0.25f, 0.25f, 0.9f * bar[5]);
+			this.shapeRenderer.rect(left, bar[1], bar[2], height);
+			if (bar[4] > 0) {
+				this.shapeRenderer.setColor(0.1f, 0.9f, 0.1f, bar[5]);
+			}
+			else {
+				this.shapeRenderer.setColor(0.95f, 0.1f, 0.1f, bar[5]);
+			}
+			this.shapeRenderer.rect(left, bar[1], bar[2] * ratio, height);
+		}
+		this.shapeRenderer.end();
+		batch.begin();
+	}
+
