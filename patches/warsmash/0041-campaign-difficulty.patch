+	private void setUpCampaignDifficulty() {
+		final UIFrame frame = this.rootFrame.getFrameByName("DifficultySelect", 0);
+		if (!(frame instanceof com.etheller.warsmash.parsers.fdf.frames.PopupMenuFrame)) {
+			return;
+		}
+		final com.etheller.warsmash.parsers.fdf.frames.PopupMenuFrame difficultySelect = (com.etheller.warsmash.parsers.fdf.frames.PopupMenuFrame) frame;
+		final String[] keys = { "EASY", "NORMAL", "HARD" };
+		final CMapDifficulty[] difficulties = { CMapDifficulty.EASY, CMapDifficulty.NORMAL, CMapDifficulty.HARD };
+		final List<com.etheller.warsmash.parsers.fdf.datamodel.MenuItem> items = new ArrayList<>();
+		for (final String key : keys) {
+			items.add(new com.etheller.warsmash.parsers.fdf.datamodel.MenuItem(
+					this.rootFrame.getTemplates().getDecoratedString(key), -2));
+		}
+		((com.etheller.warsmash.parsers.fdf.frames.MenuFrame) difficultySelect.getPopupMenuFrame())
+				.setItems(this.uiViewport, items);
+		final UIFrame titleButton = difficultySelect.getPopupTitleFrame();
+		final StringFrame title = titleButton instanceof GlueTextButtonFrame
+				? (StringFrame) ((GlueTextButtonFrame) titleButton).getButtonText()
+				: titleButton instanceof StringFrame ? (StringFrame) titleButton : null;
+		if (title != null) {
+			this.rootFrame.setDecoratedText(title, keys[this.campaignDifficulty.ordinal()]);
+		}
+		difficultySelect.setMenuClickListener((button, menuItemIndex) -> {
+			if ((menuItemIndex >= 0) && (menuItemIndex < difficulties.length)) {
+				this.campaignDifficulty = difficulties[menuItemIndex];
+				if (title != null) {
+					this.rootFrame.setDecoratedText(title, keys[menuItemIndex]);
+				}
+			}
+		});
+	}
