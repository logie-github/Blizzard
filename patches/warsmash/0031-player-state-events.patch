@@ -0,0 +1,75 @@
+package com.etheller.warsmash.viewer5.handlers.w3x.simulation.players;
+
+import com.etheller.interpreter.ast.scope.GlobalScope;
+import com.etheller.interpreter.ast.scope.trigger.RemovableTriggerEvent;
+import com.etheller.interpreter.ast.scope.trigger.Trigger;
+import com.etheller.interpreter.ast.scope.variableevent.CLimitOp;
+import com.etheller.warsmash.parsers.jass.scope.CommonTriggerExecutionScope;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.CSimulation;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.trigger.JassGameEventsWar3;
+
+/**
+ * Blizzard launcher: TriggerRegisterPlayerStateEvent: the trigger runs each time the player's state (gold, lumber,
+ * food and the rest) comes to meet the limit, checked every step. The campaigns use it to keep their computer players'
+ * gold and lumber topped up ("less than 1000").
+ */
+public class CPlayerStateEvent extends RemovableTriggerEvent {
+	private final GlobalScope globalScope;
+	private final CPlayer player;
+	private final Trigger trigger;
+	private final CPlayerState state;
+	private final CLimitOp op;
+	private final double limit;
+	private boolean met;
+
+	public CPlayerStateEvent(final GlobalScope globalScope, final CPlayer player, final Trigger trigger,
+			final CPlayerState state, final CLimitOp op, final double limit) {
+		super(trigger);
+		this.globalScope = globalScope;
+		this.player = player;
+		this.trigger = trigger;
+		this.state = state;
+		this.op = op;
+		this.limit = limit;
+	}
+
+	public CPlayer getPlayer() {
+		return this.player;
+	}
+
+	@Override
+	public void remove() {
+		this.player.removePlayerStateEvent(this);
+	}
+
+	public void update(final CSimulation simulation) {
+		final double value = this.player.getPlayerState(simulation, this.state);
+		final boolean nowMet;
+		switch (this.op) {
+		case LESS_THAN:
+			nowMet = value < this.limit;
+			break;
+		case LESS_THAN_OR_EQUAL:
+			nowMet = value <= this.limit;
+			break;
+		case EQUAL:
+			nowMet = value == this.limit;
+			break;
+		case GREATER_THAN_OR_EQUAL:
+			nowMet = value >= this.limit;
+			break;
+		case GREATER_THAN:
+			nowMet = value > this.limit;
+			break;
+		default:
+			nowMet = value != this.limit;
+			break;
+		}
+		if (nowMet && !this.met) {
+			final CommonTriggerExecutionScope scope = CommonTriggerExecutionScope.playerStateScope(
+					JassGameEventsWar3.EVENT_PLAYER_STATE_LIMIT, this.trigger, this.player, this.state);
+			this.globalScope.queueTrigger(null, null, this.trigger, scope, scope);
+		}
+		this.met = nowMet;
+	}
+}
