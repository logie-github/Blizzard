+	// A unit that is hit shows the game's health bar (green to red by life for the local player's and allies', red for
+	// enemies') for HEALTH_BAR_HOLD_TICKS (10 seconds) and then fades out over HEALTH_BAR_FADE_TICKS.
+	private static final int HEALTH_BAR_HOLD_TICKS = 200;
+	private static final int HEALTH_BAR_FADE_TICKS = 40;
+
+	private void renderHitHealthBars() {
+		if (!this.userControlEnabled) {
+			return; // a cutscene
+		}
+		final CSimulation simulation = this.war3MapViewer.simulation;
+		final int tick = simulation.getGameTurnTick();
+		final int localIndex = this.war3MapViewer.getLocalPlayerIndex();
+		for (final CUnit unit : simulation.getUnits()) {
+			final int lastHurt = unit.getLastHurtTick();
+			if ((lastHurt < 0) || unit.isDead() || unit.isHidden() || unit.isInvulnerable()
+					|| ((tick - lastHurt) >= (HEALTH_BAR_HOLD_TICKS + HEALTH_BAR_FADE_TICKS))
+					|| (unit.getMaximumLife() <= 0)) {
+				continue;
+			}
+			final RenderUnit peer = this.war3MapViewer.getRenderPeer(unit);
+			if ((peer == null) || !unit.isVisible(simulation, localIndex)) {
+				continue;
+			}
+			final int sinceHurt = tick - lastHurt;
+			final float alpha = (sinceHurt < HEALTH_BAR_HOLD_TICKS) ? 1f
+					: 1f - ((sinceHurt - HEALTH_BAR_HOLD_TICKS) / (float) HEALTH_BAR_FADE_TICKS);
+			positionHealthBar(getHpBar(), peer, alpha);
+		}
+	}
+
