+/**
+ * Blizzard launcher: natives common.j declares that this engine did not have (they did nothing and returned nothing),
+ * taken from Warsmash Reforged (nikoltu/W3AndroidEngine) and adapted to this engine.
+ */
+public final class LauncherNatives {
+	private LauncherNatives() {
+	}
+
+	static <T> T nullable(final List<JassValue> arguments, final int index, final com.etheller.interpreter.ast.value.JassValueVisitor<T> visitor) {
+		return Jass2.nullable(arguments, index, visitor);
+	}
+
+	static int intArg(final List<JassValue> arguments, final int index) {
+		return arguments.get(index).visit(IntegerJassValueVisitor.getInstance());
+	}
+
+	static float realArg(final List<JassValue> arguments, final int index) {
+		return arguments.get(index).visit(RealJassValueVisitor.getInstance()).floatValue();
+	}
+
+	static <T> T inGame(final T widget) {
+		return widget;
+	}
+
+	private static CAbilityHero scriptHeroData(final CUnit unit) {
+		return ((unit == null) || unit.isIllusion()) ? null : unit.getHeroData();
+	}
+
+	/** The order natives that are another one with an argument more, fewer or in another form. */
+	private static void registerOrderVariants(final com.etheller.interpreter.ast.util.JassProgram jassProgramVisitor) {
+		final com.etheller.interpreter.ast.function.JassNativeManager natives = jassProgramVisitor.getJassNativeManager();
+		final com.etheller.interpreter.ast.function.JassFunction pointById = natives.getCreatedNative("IssuePointOrderById");
+		final com.etheller.interpreter.ast.function.JassFunction targetById = natives.getCreatedNative("IssueTargetOrderById");
+		final com.etheller.interpreter.ast.function.JassFunction immediateById = natives.getCreatedNative("IssueImmediateOrderById");
+		final com.etheller.interpreter.ast.function.JassFunction buildById = natives.getCreatedNative("IssueBuildOrderById");
+		// IssuePointOrder(unit, string, x, y)
+		natives.createNative("IssuePointOrder", (arguments, globalScope, triggerScope) -> pointById.call(
+				java.util.Arrays.asList(arguments.get(0), orderOf(arguments.get(1)), arguments.get(2), arguments.get(3)),
+				globalScope, triggerScope));
+		// IssuePointOrderByIdLoc(unit, int, location)
+		natives.createNative("IssuePointOrderByIdLoc", (arguments, globalScope, triggerScope) -> {
+			final AbilityPointTarget loc = nullable(arguments, 2, ObjectJassValueVisitor.<AbilityPointTarget>getInstance());
+			if (loc == null) {
+				return BooleanJassValue.FALSE;
+			}
+			return pointById.call(java.util.Arrays.asList(arguments.get(0), arguments.get(1), RealJassValue.of(loc.x),
+					RealJassValue.of(loc.y)), globalScope, triggerScope);
+		});
+		// IssueBuildOrder(unit, string unitToBuild, x, y)
+		natives.createNative("IssueBuildOrder", (arguments, globalScope, triggerScope) -> buildById.call(
+				java.util.Arrays.asList(arguments.get(0), unitIdOf(arguments.get(1)), arguments.get(2), arguments.get(3)),
+				globalScope, triggerScope));
+		// IssueInstant*: the instant target (the item a hero uses on the way) is not modelled: the plain order.
+		natives.createNative("IssueInstantPointOrder", (arguments, globalScope, triggerScope) -> pointById.call(
+				java.util.Arrays.asList(arguments.get(0), orderOf(arguments.get(1)), arguments.get(2), arguments.get(3)),
+				globalScope, triggerScope));
+		natives.createNative("IssueInstantPointOrderById", (arguments, globalScope, triggerScope) -> pointById.call(
+				arguments.subList(0, 4), globalScope, triggerScope));
+		natives.createNative("IssueInstantTargetOrder", (arguments, globalScope, triggerScope) -> targetById.call(
+				java.util.Arrays.asList(arguments.get(0), orderOf(arguments.get(1)), arguments.get(2)), globalScope,
+				triggerScope));
+		natives.createNative("IssueInstantTargetOrderById", (arguments, globalScope, triggerScope) -> targetById.call(
+				arguments.subList(0, 3), globalScope, triggerScope));
+		// IssueNeutral*(player forWhichPlayer, unit, ...): a player orders a neutral unit (a shop, a mercenary camp).
+		natives.createNative("IssueNeutralImmediateOrder", (arguments, globalScope, triggerScope) -> immediateById.call(
+				java.util.Arrays.asList(arguments.get(1), orderOf(arguments.get(2))), globalScope, triggerScope));
+		natives.createNative("IssueNeutralImmediateOrderById", (arguments, globalScope, triggerScope) -> immediateById
+				.call(arguments.subList(1, 3), globalScope, triggerScope));
+		natives.createNative("IssueNeutralPointOrder", (arguments, globalScope, triggerScope) -> pointById.call(
+				java.util.Arrays.asList(arguments.get(1), orderOf(arguments.get(2)), arguments.get(3), arguments.get(4)),
+				globalScope, triggerScope));
+		natives.createNative("IssueNeutralPointOrderById", (arguments, globalScope, triggerScope) -> pointById.call(
+				arguments.subList(1, 5), globalScope, triggerScope));
+		natives.createNative("IssueNeutralTargetOrder", (arguments, globalScope, triggerScope) -> targetById.call(
+				java.util.Arrays.asList(arguments.get(1), orderOf(arguments.get(2)), arguments.get(3)), globalScope,
+				triggerScope));
+		natives.createNative("IssueNeutralTargetOrderById", (arguments, globalScope, triggerScope) -> targetById.call(
+				arguments.subList(1, 4), globalScope, triggerScope));
+	}
