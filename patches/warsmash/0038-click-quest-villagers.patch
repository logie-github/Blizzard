+	private boolean approachQuestVillager(final CUnit villager) {
+		if (villager.isDead() || villager.isHidden() || !this.war3MapViewer.hasQuestDialogueMarker(villager)) {
+			return false;
+		}
+
+		final CSimulation game = this.war3MapViewer.simulation;
+		CUnit hero = (this.selectedUnit == null) ? null : this.selectedUnit.getSimulationUnit();
+		CAbilityMove move = getQuestApproachAbility(game, hero, villager);
+		if (move == null) {
+			double nearestDistance = Double.POSITIVE_INFINITY;
+			for (final CUnit candidate : game.getUnits()) {
+				final CAbilityMove candidateMove = getQuestApproachAbility(game, candidate, villager);
+				if (candidateMove != null) {
+					final double distance = candidate.distance(villager.getX(), villager.getY());
+					if (distance < nearestDistance) {
+						nearestDistance = distance;
+						hero = candidate;
+						move = candidateMove;
+					}
+				}
+			}
+		}
+		if (move == null) {
+			return false;
+		}
+
+		// The map's normal proximity trigger starts the conversation and advances its quest.
+		this.unitOrderListener.issuePointOrder(hero.getHandleId(), move.getHandleId(), OrderIds.move,
+				villager.getX(), villager.getY(), false);
+		return true;
+	}
+
+	private CAbilityMove getQuestApproachAbility(final CSimulation game, final CUnit unit, final CUnit villager) {
+		if ((unit == null) || (unit == villager) || !unit.isHero()
+				|| (unit.getPlayerIndex() != this.war3MapViewer.getLocalPlayerIndex())
+				|| unit.isDead() || unit.isHidden() || unit.isPaused() || unit.isMovementDisabled()) {
+			return null;
+		}
+		for (final CAbility ability : unit.getAbilities()) {
+			if (ability instanceof CAbilityMove) {
+				final BooleanAbilityActivationReceiver receiver = BooleanAbilityActivationReceiver.INSTANCE;
+				ability.checkCanUse(game, unit, OrderIds.move, receiver);
+				if (receiver.isOk()) {
+					return (CAbilityMove) ability;
+				}
+			}
+		}
+		return null;
+	}
