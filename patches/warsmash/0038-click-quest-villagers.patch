+	public void trackQuestDialogueMarker(final String modelName, final CWidget target, final RenderSpellEffect effect) {
+		if (!(target instanceof CUnit) || (effect == null)) {
+			return;
+		}
+		final String path = modelName.replace('\\', '/');
+		final String fileName = path.substring(path.lastIndexOf('/') + 1);
+		if ("TalkToMe.mdl".equalsIgnoreCase(fileName) || "TalkToMe.mdx".equalsIgnoreCase(fileName)) {
+			effect.setKillWhenDone(false);
+			this.questDialogueMarkers.put(effect, (CUnit) target);
+		}
+	}
+
+	public boolean hasQuestDialogueMarker(final CUnit unit) {
+		return this.questDialogueMarkers.containsValue(unit);
+	}
+
+	public void removeQuestDialogueMarker(final RenderSpellEffect effect) {
+		this.questDialogueMarkers.remove(effect);
+	}
