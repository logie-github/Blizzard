+package com.etheller.warsmash.viewer5.handlers.w3x.simulation.pathing;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+
+import com.badlogic.gdx.math.Vector2;
+import com.etheller.warsmash.viewer5.handlers.w3x.environment.PathingGrid;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.CSimulation;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.CUnit;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.CWorldCollision;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.behaviors.CBehaviorMove;
+
+/**
+ * Blizzard launcher: the path searches of every unit, worked at the same time. Each unit's order has its own search
+ * (exactly the route it would have had alone); the searches are shared out over a worker for each processor core
+ * beyond the game's own, each with search memory of its own, and all work together while the game waits a few
+ * milliseconds. A search that is not done in that time goes on in the next frame, on the same worker. Routes are
+ * handed to their units here, on the game's thread, in the order the searches were asked for.
+ *
+ * Nothing changes the map while the workers read it: the game's thread is waiting for them.
+ */
+public final class CPathfindingPool {
+	private final CPathfindingProcessor[] workers;
+	private final ExecutorService executor;
+
+	public CPathfindingPool(final PathingGrid pathingGrid, final CWorldCollision worldCollision) {
+		final int count = Math.max(2, Math.min(7, Runtime.getRuntime().availableProcessors() - 1));
+		this.workers = new CPathfindingProcessor[count];
+		for (int i = 0; i < count; i++) {
+			this.workers[i] = new CPathfindingProcessor(i, pathingGrid, worldCollision);
+			this.workers[i].deferRoutes(true);
+		}
+		this.executor = Executors.newFixedThreadPool(count, runnable -> {
+			final Thread thread = new Thread(runnable, "path search");
+			thread.setDaemon(true);
+			return thread;
+		});
+	}
+
+	public int getWorkerCount() {
+		return this.workers.length;
+	}
+
+	public void findNaiveSlowPath(final CUnit ignoreIntersectionsWithThisUnit,
+			final CUnit ignoreIntersectionsWithThisSecondUnit, final float startX, final float startY,
+			final Vector2 goal, final PathingGrid.MovementType movementType, final float collisionSize,
+			final boolean allowSmoothing, final CBehaviorMove queueItem) {
+		// the worker with the fewest searches waiting
+		CPathfindingProcessor best = this.workers[0];
+		for (final CPathfindingProcessor worker : this.workers) {
+			if (worker.queuedJobs() < best.queuedJobs()) {
+				best = worker;
+			}
+		}
+		best.findNaiveSlowPath(ignoreIntersectionsWithThisUnit, ignoreIntersectionsWithThisSecondUnit, startX, startY,
+				goal, movementType, collisionSize, allowSmoothing, queueItem);
+	}
+
+	public void removeFromPathfindingQueue(final CBehaviorMove behaviorMove) {
+		for (final CPathfindingProcessor worker : this.workers) {
+			worker.removeFromPathfindingQueue(behaviorMove);
+		}
+	}
+
+	public boolean hasWork() {
+		for (final CPathfindingProcessor worker : this.workers) {
+			if (worker.hasWork()) {
+				return true;
+			}
+		}
+		return false;
+	}
+
+	/** Works the waiting searches for up to the time, all workers together, then hands the finished routes over. */
+	public void run(final CSimulation simulation, final long budgetNanos) {
+		final long deadline = System.nanoTime() + budgetNanos;
+		final List<CPathfindingProcessor> busy = new ArrayList<>();
+		for (final CPathfindingProcessor worker : this.workers) {
+			if (worker.hasWork()) {
+				busy.add(worker);
+			}
+		}
+		if (busy.isEmpty()) {
+			return;
+		}
+		if (busy.size() == 1) {
+			work(busy.get(0), simulation, deadline);
+		}
+		else {
+			final List<Future<?>> running = new ArrayList<>(busy.size());
+			for (final CPathfindingProcessor worker : busy) {
+				running.add(this.executor.submit(() -> work(worker, simulation, deadline)));
+			}
+			for (final Future<?> future : running) {
+				try {
+					future.get();
+				}
+				catch (final Exception exc) {
+					exc.printStackTrace();
+				}
+			}
+		}
+		final List<Object[]> finished = new ArrayList<>();
+		for (final CPathfindingProcessor worker : busy) {
+			finished.addAll(worker.takeDeferredRoutes());
+		}
+		if (finished.isEmpty()) {
+			return;
+		}
+		Collections.sort(finished, (a, b) -> Long.compare(((CPathfindingProcessor.PathfindingJob) a[0]).sequence,
+				((CPathfindingProcessor.PathfindingJob) b[0]).sequence));
+		for (final Object[] done : finished) {
+			@SuppressWarnings("unchecked")
+			final List<Vector2> route = (List<Vector2>) done[1];
+			CPathfindingProcessor.deliverRoute((CPathfindingProcessor.PathfindingJob) done[0], route, simulation);
+		}
+	}
+
+	private static void work(final CPathfindingProcessor worker, final CSimulation simulation, final long deadline) {
+		try {
+			while (worker.update(simulation, deadline)) {
+				if (System.nanoTime() >= deadline) {
+					break;
+				}
+			}
+		}
+		catch (final Throwable exc) {
+			// a search that fails gives its unit an empty route (it goes on as when no route is found) instead of
+			// failing again every frame
+			exc.printStackTrace();
+			worker.failFirstJob();
+		}
+	}
+}
