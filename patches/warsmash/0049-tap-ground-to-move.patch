+
+	/**
+	 * Whether a finger lifted at the point is a tap on empty ground with the local player's units selected: it did not
+	 * go far from where it came down (that was a drag), no command is waiting for a target, no key is held, and no
+	 * unit, item or tree is under it (those are selected, as before).
+	 */
+	private boolean isTapOnEmptyGround(final int screenX, final int screenY, final float worldScreenY) {
+		if ((this.activeCommand != null) || (this.draggingItem != null) || isShiftDown() || isControlDown()) {
+			return false;
+		}
+		final RenderUnit selected = getSelectedUnit();
+		if ((selected == null) || (selected.getSimulationUnit().getPlayerIndex() != this.war3MapViewer
+				.getLocalPlayerIndex()) || selected.getSimulationUnit().isDead()) {
+			return false;
+		}
+		boolean mobile = false;
+		for (final RenderUnit unit : this.selectedUnits) {
+			if ((unit.getSimulationUnit().getPlayerIndex() == this.war3MapViewer.getLocalPlayerIndex())
+					&& !unit.getSimulationUnit().isBuilding()) {
+				mobile = true;
+			}
+		}
+		if (!mobile) {
+			return false;
+		}
+		final float slop = Gdx.graphics.getHeight() * 0.025f;
+		if ((Math.abs(screenX - this.tapStartX) > slop) || (Math.abs(screenY - this.tapStartY) > slop)) {
+			return false;
+		}
+		return (this.war3MapViewer.rayPickUnit(screenX, worldScreenY, this.anyClickableUnitFilter) == null)
+				&& (this.war3MapViewer.rayPickUnit(screenX, worldScreenY, this.anyTargetableUnitFilter) == null);
+	}
+
