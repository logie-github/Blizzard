 		return this.itemIdToItemType.values();
 	}
+
+	/**
+	 * Blizzard launcher (Warsmash Reforged's): the item profile also holds the tech equivalents (TWN1, TWN2, TWN3,
+	 * TALT) that neutral heroes require: each lists, in DependencyOr, the units that count as it.
+	 */
+	public Map<War3ID, List<War3ID>> getTechEquivalents() {
+		final Map<War3ID, List<War3ID>> techEquivalents = new HashMap<>();
+		if (this.itemData instanceof com.etheller.warsmash.units.StandardObjectData.WarcraftData) {
+			final com.etheller.warsmash.units.DataTable profile = ((com.etheller.warsmash.units.StandardObjectData.WarcraftData) this.itemData)
+					.getTable("Profile");
+			if (profile != null) {
+				for (final String key : profile.keySet()) {
+					final com.etheller.warsmash.units.Element element = profile.get(key);
+					if ((key.length() == 4) && (this.itemData.get(key) == null) && (element != null)
+							&& element.hasField("DependencyOr")) {
+						final List<War3ID> unitIds = new ArrayList<>();
+						for (final String id : element.getFieldAsList("DependencyOr")) {
+							if (id.trim().length() == 4) {
+								unitIds.add(War3ID.fromString(id.trim()));
+							}
+						}
+						if (!unitIds.isEmpty()) {
+							techEquivalents.put(War3ID.fromString(key), unitIds);
+						}
+					}
+				}
+			}
+		}
+		return techEquivalents;
+	}
 }
