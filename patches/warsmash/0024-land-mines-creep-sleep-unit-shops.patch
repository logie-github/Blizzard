+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.types.definitions.impl.AbilityFields;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.combat.CTargetType;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.timers.CTimer;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.unit.StateModBuff;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.unit.StateModBuffType;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.util.BooleanAbilityTargetCheckReceiver;
+
+/**
+ * Blizzard launcher: Mine (Amin, the Goblin Land Mine). The mine fades out of sight after the invisibility transition
+ * time (Data B) and, once armed after the activation delay (Data A), blows itself up when an enemy ground unit comes
+ * within its cast range; the unit's Death Damage (Amnx) does the harm.
+ */
+public class CAbilityLandMine extends CAbilityPassiveSpellBase {
+	private static final EnumSet<CTargetType> TRIGGERED_BY = EnumSet.of(CTargetType.GROUND, CTargetType.ENEMIES);
+
+	private float activationDelay;
+	private float invisibilityTime;
+	private final StateModBuff invisibility = new StateModBuff(StateModBuffType.INVISIBLE, 1);
+	private int startTick = -1;
+	private boolean hidden;
+	private boolean done;
+
+	public CAbilityLandMine(final int handleId, final War3ID alias) {
+		super(handleId, alias, alias);
+	}
+
+	@Override
+	public void populateData(final GameObject worldEditorAbility, final int level) {
+		this.activationDelay = worldEditorAbility.getFieldAsFloat(AbilityFields.DATA_A + level, 0);
+		this.invisibilityTime = worldEditorAbility.getFieldAsFloat(AbilityFields.DATA_B + level, 0);
+	}
+
+	@Override
+	public void onAdd(final CSimulation game, final CUnit unit) {
+		this.startTick = game.getGameTurnTick();
+	}
+
+	@Override
+	public void onRemove(final CSimulation game, final CUnit unit) {
+		if (this.hidden) {
+			this.hidden = false;
+			unit.removeStateModBuff(this.invisibility);
+			unit.computeUnitState(game, StateModBuffType.INVISIBLE);
+		}
+	}
+
+	@Override
+	public void onTick(final CSimulation game, final CUnit unit) {
+		if (this.done || unit.isDead() || isDisabled()) {
+			return;
+		}
+		final int tick = game.getGameTurnTick();
+		if (this.startTick < 0) {
+			this.startTick = tick;
+		}
+		if (!this.hidden && (tick >= (this.startTick + CTimer.wholeSteps(this.invisibilityTime)))) {
+			this.hidden = true;
+			unit.addStateModBuff(this.invisibility);
+			unit.computeUnitState(game, StateModBuffType.INVISIBLE);
+		}
+		if (tick < (this.startTick + CTimer.wholeSteps(this.activationDelay))) {
+			return;
+		}
+		final boolean[] found = { false };
+		game.getWorldCollision().enumUnitsInRange(unit.getX(), unit.getY(), getCastRange(), (enumUnit) -> {
+			if ((enumUnit != unit) && !enumUnit.isDead() && !enumUnit.isHidden()
+					&& enumUnit.canBeTargetedBy(game, unit, false, TRIGGERED_BY,
+							BooleanAbilityTargetCheckReceiver.<CWidget>getInstance().reset())) {
+				found[0] = true;
+				return true;
+			}
+			return false;
+		});
+		if (found[0]) {
+			this.done = true;
+			unit.kill(game);
+		}
+	}
+}
