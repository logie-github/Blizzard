+package com.etheller.warsmash.parsers.jass.ai;
+
+import com.etheller.warsmash.util.War3ID;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.CUnit;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.CUnitType;
+
+/**
+ * A structure a computer player's worker was sent to build that has not been laid down yet. Until it is, the
+ * structure already counts for the AI scripts so they do not order it again.
+ */
+public class AIBuildJob {
+	private final CUnit worker;
+	private final CUnitType type;
+	private final float x;
+	private final float y;
+	private final int town;
+	private final int issuedTick;
+
+	public AIBuildJob(final CUnit worker, final CUnitType type, final float x, final float y, final int town,
+			final int issuedTick) {
+		this.worker = worker;
+		this.type = type;
+		this.x = x;
+		this.y = y;
+		this.town = town;
+		this.issuedTick = issuedTick;
+	}
+
+	public CUnit getWorker() {
+		return this.worker;
+	}
+
+	public CUnitType getType() {
+		return this.type;
+	}
+
+	public War3ID getTypeId() {
+		return this.type.getTypeId();
+	}
+
+	public float getX() {
+		return this.x;
+	}
+
+	public float getY() {
+		return this.y;
+	}
+
+	public int getTown() {
+		return this.town;
+	}
+
+	public int getIssuedTick() {
+		return this.issuedTick;
+	}
+}
diff --git a/core/src/com/etheller/warsmash/parsers/jass/ai/AICaptain.java b/core/src/com/etheller/warsmash/parsers/jass/ai/AICaptain.java
new file mode 100644
index 0000000..39bf322
--- /dev/null
+++ b/core/src/com/etheller/warsmash/parsers/jass/ai/AICaptain.java
@@ -0,0 +1,149 @@
+package com.etheller.warsmash.parsers.jass.ai;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.CUnit;
+
+/**
+ * One of the two groups a computer player commands: the attack captain leads the waves the script forms with
+ * InitAssault/AddAssault, the defense captain holds every other fighter at home.
+ */
+public class AICaptain {
+	private final List<CUnit> members = new ArrayList<>();
+	private final List<CUnit> previousMembers = new ArrayList<>();
+	private final Map<CUnit, Integer> orderedGeneration = new HashMap<>();
+	private boolean full = true;
+	private float homeX;
+	private float homeY;
+	private boolean homeSet;
+	private CUnit goalUnit;
+	private float goalX;
+	private float goalY;
+	private boolean hasGoal;
+	private boolean retreating;
+	private int generation;
+
+	public List<CUnit> getMembers() {
+		return this.members;
+	}
+
+	public List<CUnit> getPreviousMembers() {
+		return this.previousMembers;
+	}
+
+	public void beginAssault() {
+		this.previousMembers.clear();
+		this.previousMembers.addAll(this.members);
+		this.members.clear();
+		this.full = true;
+	}
+
+	public void addRequestResult(final boolean satisfied) {
+		this.full &= satisfied;
+	}
+
+	public boolean isRequestsFull() {
+		return this.full;
+	}
+
+	public float getHomeX() {
+		return this.homeX;
+	}
+
+	public float getHomeY() {
+		return this.homeY;
+	}
+
+	public boolean isHomeSet() {
+		return this.homeSet;
+	}
+
+	public void setHome(final float x, final float y) {
+		this.homeX = x;
+		this.homeY = y;
+		this.homeSet = true;
+	}
+
+	public CUnit getGoalUnit() {
+		return this.goalUnit;
+	}
+
+	public float getGoalX() {
+		return this.goalUnit != null ? this.goalUnit.getX() : this.goalX;
+	}
+
+	public float getGoalY() {
+		return this.goalUnit != null ? this.goalUnit.getY() : this.goalY;
+	}
+
+	public boolean hasGoal() {
+		return this.hasGoal;
+	}
+
+	public void setGoal(final CUnit unit, final float x, final float y) {
+		if (!this.hasGoal || (this.goalUnit != unit) || (unit == null && ((x != this.goalX) || (y != this.goalY)))) {
+			this.generation++;
+		}
+		this.goalUnit = unit;
+		this.goalX = x;
+		this.goalY = y;
+		this.hasGoal = true;
+		this.retreating = false;
+	}
+
+	public void clearGoal() {
+		if (this.hasGoal) {
+			this.generation++;
+		}
+		this.goalUnit = null;
+		this.hasGoal = false;
+	}
+
+	public int getGeneration() {
+		return this.generation;
+	}
+
+	public boolean isRetreating() {
+		return this.retreating;
+	}
+
+	public void setRetreating(final boolean retreating) {
+		this.retreating = retreating;
+	}
+
+	public boolean needsOrder(final CUnit unit) {
+		final Integer ordered = this.orderedGeneration.get(unit);
+		return (ordered == null) || (ordered != this.generation);
+	}
+
+	public void markOrdered(final CUnit unit) {
+		this.orderedGeneration.put(unit, this.generation);
+	}
+
+	public void clearOrders() {
+		this.orderedGeneration.clear();
+	}
+
+	public void forgetOrders() {
+		this.orderedGeneration.keySet().retainAll(this.members);
+	}
+
+	public float getCenterX() {
+		float sum = 0;
+		for (final CUnit unit : this.members) {
+			sum += unit.getX();
+		}
+		return this.members.isEmpty() ? this.homeX : sum / this.members.size();
+	}
+
+	public float getCenterY() {
+		float sum = 0;
+		for (final CUnit unit : this.members) {
+			sum += unit.getY();
+		}
+		return this.members.isEmpty() ? this.homeY : sum / this.members.size();
+	}
+}
diff --git a/core/src/com/etheller/warsmash/parsers/jass/ai/AIConstruction.java b/core/src/com/etheller/warsmash/parsers/jass/ai/AIConstruction.java
new file mode 100644
index 0000000..b1b677a
--- /dev/null
+++ b/core/src/com/etheller/warsmash/parsers/jass/ai/AIConstruction.java
@@ -0,0 +1,285 @@
+package com.etheller.warsmash.parsers.jass.ai;
+
+import static com.etheller.warsmash.parsers.jass.ai.AIUnits.distance;
+import static com.etheller.warsmash.parsers.jass.ai.AIUnits.distanceToSegment;
+
+import java.util.Iterator;
+
+import com.badlogic.gdx.graphics.Pixmap;
+import com.etheller.warsmash.viewer5.handlers.w3x.environment.PathingGrid;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.CUnit;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.CUnitClassification;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.CUnitType;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.build.AbstractCAbilityBuild;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.targeting.AbilityPointTarget;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.orders.COrder;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.timers.CTimer;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.unit.BuildOnBuildingIntersector;
+
+/**
+ * Structures the computer player builds: choosing the worker, finding the place in a town and following the worker
+ * until the structure is laid down.
+ */
+final class AIConstruction {
+	private static final float BUILDING_GAP = 96f;
+	private static final int BUILD_JOB_TIMEOUT_TICKS = CTimer.wholeSteps(90);
+	private static final int BUILD_JOB_GRACE_TICKS = CTimer.wholeSteps(2);
+
+	private AIConstruction() {
+	}
+
+	/**
+	 * @param type null for any worker that can build
+	 * @param byDistance whether the nearest worker wins, or the first in the order units are claimed in
+	 */
+	static CUnit findBuilder(final AIController ai, final CUnitType type, final float x, final float y,
+			final int preferredTown, final boolean byDistance) {
+		CUnit best = null;
+		float bestScore = Float.MAX_VALUE;
+		for (final CUnit unit : AIUnits.inClaimOrder(ai.simulation)) {
+			if (!ai.isOurs(unit) || unit.isHidden() || ai.isBuildJobWorker(unit) || AIUnits.isBuilding(unit)
+					|| ai.attackCaptain.getMembers().contains(unit)) {
+				continue;
+			}
+			final AbstractCAbilityBuild build = AIUnits.getBuildAbility(unit);
+			if ((build == null) || ((type != null) && !build.getStructuresBuilt().contains(type.getTypeId()))) {
+				continue;
+			}
+			float score = byDistance ? distance(x, y, unit.getX(), unit.getY()) : 0;
+			final int[] job = ai.harvestJobs.get(unit);
+			if (job == null) {
+				score -= 4000;
+			}
+			else if (job[0] == AIHarvest.WOOD) {
+				score -= 2000;
+			}
+			if ((preferredTown != -1) && (AITowns.townOf(ai, unit.getX(), unit.getY()) != preferredTown)) {
+				score += 3000;
+			}
+			if (score < bestScore) {
+				bestScore = score;
+				best = unit;
+			}
+		}
+		return best;
+	}
+
+	static boolean buildStructures(final AIController ai, final int qty, final CUnitType type, final int townId) {
+		if (!AIProduction.requirementsMet(ai, type)) {
+			return false;
+		}
+		// Measured: one builder at a time; until it has laid its structure down, another structure is refused.
+		if (AIProduction.canAfford(ai, type) && hasBuilderOnTheWay(ai)) {
+			return false;
+		}
+		int started = 0;
+		for (int i = 0; i < qty; i++) {
+			if (!AIProduction.canAfford(ai, type)) {
+				// Measured: short of money it is still true, with nothing started.
+				return true;
+			}
+			AITown town = AITowns.getTown(ai, townId == -1 ? 0 : townId);
+			if (type.isCanBeBuiltOnThem() && (townId == -1)) {
+				town = AITowns.townNeedingOverlay(ai);
+			}
+			if (town == null) {
+				break;
+			}
+			final CUnit builder = findBuilder(ai, type, town.getCenterX(), town.getCenterY(), town.getId(), false);
+			if (builder == null) {
+				break;
+			}
+			final AbilityPointTarget location;
+			if (type.isCanBeBuiltOnThem() || (type.getClassifications().contains(CUnitClassification.TOWNHALL)
+					&& !AITowns.townHasHall(ai, town.getId()))) {
+				location = findTownStructureLocation(ai, type, builder, town);
+			}
+			else {
+				location = findBuildLocation(ai, type, builder, town);
+			}
+			if ((location == null) || !orderBuild(ai, builder, type, location, town.getId())) {
+				break;
+			}
+			started++;
+		}
+		return started > 0;
+	}
+
+	static boolean orderBuild(final AIController ai, final CUnit builder, final CUnitType type,
+			final AbilityPointTarget location, final int town) {
+		if (!builder.order(ai.simulation, type.getTypeId().getValue(), location)) {
+			return false;
+		}
+		ai.harvestJobs.remove(builder);
+		ai.buildJobs.add(
+				new AIBuildJob(builder, type, location.x, location.y, town, ai.simulation.getGameTurnTick()));
+		ai.countCache.clear();
+		return true;
+	}
+
+	static boolean isLaidDown(final AIController ai, final AIBuildJob job) {
+		for (final CUnit unit : ai.simulation.getUnits()) {
+			if (ai.isOurs(unit) && unit.getTypeId().equals(job.getTypeId())
+					&& (distance(unit.getX(), unit.getY(), job.getX(), job.getY()) < 64)) {
+				return true;
+			}
+		}
+		return false;
+	}
+
+	private static boolean hasBuilderOnTheWay(final AIController ai) {
+		updateBuildJobs(ai);
+		return !ai.buildJobs.isEmpty();
+	}
+
+	static boolean canBeBuiltByUs(final AIController ai, final CUnitType type) {
+		for (final CUnit unit : ai.simulation.getUnits()) {
+			if (ai.isOurs(unit)) {
+				final AbstractCAbilityBuild build = AIUnits.getBuildAbility(unit);
+				if ((build != null) && build.getStructuresBuilt().contains(type.getTypeId())) {
+					return true;
+				}
+			}
+		}
+		return false;
+	}
+
+	static void updateBuildJobs(final AIController ai) {
+		final int tick = ai.simulation.getGameTurnTick();
+		for (final Iterator<AIBuildJob> iterator = ai.buildJobs.iterator(); iterator.hasNext();) {
+			final AIBuildJob job = iterator.next();
+			final CUnit worker = job.getWorker();
+			boolean finished = worker.isDead() || isLaidDown(ai, job)
+					|| ((tick - job.getIssuedTick()) > BUILD_JOB_TIMEOUT_TICKS);
+			if (!finished && ((tick - job.getIssuedTick()) > BUILD_JOB_GRACE_TICKS)) {
+				final COrder order = worker.getCurrentOrder();
+				finished = (order == null) || (order.getOrderId() != job.getTypeId().getValue());
+				finished &= !AIUnits.isBuilding(worker);
+			}
+			if (finished) {
+				iterator.remove();
+			}
+		}
+	}
+
+	private static int halfWidth(final CUnitType type) {
+		final Pixmap map = type.getBuildingPathingPixelMap();
+		return map == null ? 64 : (map.getWidth() * 16);
+	}
+
+	private static int halfHeight(final CUnitType type) {
+		final Pixmap map = type.getBuildingPathingPixelMap();
+		return map == null ? 64 : (map.getHeight() * 16);
+	}
+
+	private static boolean isObstructed(final AIController ai, final CUnitType type, final CUnit builder,
+			final float x, final float y) {
+		return AbstractCAbilityBuild.isBuildLocationObstructed(ai.simulation, type, type.getBuildingPathingPixelMap(),
+				type.isCanBeBuiltOnThem(), x, y, builder, BuildOnBuildingIntersector.INSTANCE.reset(x, y));
+	}
+
+	private static boolean overlapsBuildJob(final AIController ai, final CUnitType type, final float x,
+			final float y) {
+		for (final AIBuildJob job : ai.buildJobs) {
+			if ((Math.abs(job.getX() - x) < (halfWidth(type) + halfWidth(job.getType()) + 64))
+					&& (Math.abs(job.getY() - y) < (halfHeight(type) + halfHeight(job.getType()) + 64))) {
+				return true;
+			}
+		}
+		return false;
+	}
+
+	/**
+	 * Haunted mines go on the gold mine, town halls at a mining distance from it; the start town's hall goes back
+	 * to the start location.
+	 */
+	static AbilityPointTarget findTownStructureLocation(final AIController ai, final CUnitType type,
+			final CUnit builder, final AITown town) {
+		if (type.isCanBeBuiltOnThem()) {
+			return town.getMine() == null ? null : new AbilityPointTarget(town.getMine().getX(), town.getMine().getY());
+		}
+		if (town.getId() == 0) {
+			final AbilityPointTarget start = new AbilityPointTarget(town.getX(), town.getY());
+			AbstractCAbilityBuild.roundTargetPoint(start, type);
+			if (!isObstructed(ai, type, builder, start.x, start.y)) {
+				return start;
+			}
+		}
+		final CUnit mine = town.getMine();
+		if (mine == null) {
+			return null;
+		}
+		final float minRadius = halfWidth(mine.getUnitType()) + halfWidth(type) + 160;
+		final float awayAngle = (float) StrictMath.atan2(mapCenterY(ai) - mine.getY(), mapCenterX(ai) - mine.getX());
+		return searchLocation(ai, type, builder, mine.getX(), mine.getY(), minRadius, minRadius + 384, awayAngle,
+				null);
+	}
+
+	private static float mapCenterX(final AIController ai) {
+		final PathingGrid grid = ai.simulation.getPathingGrid();
+		return (grid.getWorldX(0) + grid.getWorldX(grid.getWidth() - 1)) / 2;
+	}
+
+	private static float mapCenterY(final AIController ai) {
+		final PathingGrid grid = ai.simulation.getPathingGrid();
+		return (grid.getWorldY(0) + grid.getWorldY(grid.getHeight() - 1)) / 2;
+	}
+
+	private static AbilityPointTarget findBuildLocation(final AIController ai, final CUnitType type,
+			final CUnit builder, final AITown town) {
+		final float cx = town.getCenterX();
+		final float cy = town.getCenterY();
+		final CUnit mine = town.getMine();
+		float preferredAngle = (float) StrictMath.atan2(mapCenterY(ai) - cy, mapCenterX(ai) - cx);
+		if (mine != null) {
+			preferredAngle = (float) StrictMath.atan2(cy - mine.getY(), cx - mine.getX());
+		}
+		final float minRadius = Math.max(256f, 160f + halfWidth(type) + 128f);
+		return searchLocation(ai, type, builder, cx, cy, minRadius, 1800f, preferredAngle, mine);
+	}
+
+	/**
+	 * Rings outward from the center, starting each ring at the preferred angle, for the first spot that is free
+	 * with a cell of room around it, keeps clear of the gold mine and of the path between mine and hall, and is
+	 * not taken by another worker's pending building.
+	 */
+	private static AbilityPointTarget searchLocation(final AIController ai, final CUnitType type,
+			final CUnit builder, final float cx, final float cy, final float minRadius, final float maxRadius,
+			final float preferredAngle, final CUnit avoidMine) {
+		final AbilityPointTarget point = new AbilityPointTarget(0, 0);
+		final float size = Math.max(halfWidth(type), halfHeight(type));
+		for (float radius = minRadius; radius <= maxRadius; radius += 64f) {
+			final int steps = Math.max(8, (int) ((2 * Math.PI * radius) / 96f));
+			for (int step = 0; step < steps; step++) {
+				final int side = ((step & 1) == 0) ? 1 : -1;
+				final double angle = preferredAngle + (side * ((step + 1) / 2) * ((2 * Math.PI) / steps));
+				point.x = cx + (float) (StrictMath.cos(angle) * radius);
+				point.y = cy + (float) (StrictMath.sin(angle) * radius);
+				AbstractCAbilityBuild.roundTargetPoint(point, type);
+				if (avoidMine != null) {
+					final float mineDistance = distance(point.x, point.y, avoidMine.getX(), avoidMine.getY());
+					if ((mineDistance < (size + 320f))
+							|| (distanceToSegment(point.x, point.y, cx, cy, avoidMine.getX(), avoidMine.getY()) < (size
+									+ 160f))) {
+						continue;
+					}
+				}
+				if (ai.attackCaptain.isHomeSet() && (distance(point.x, point.y, ai.attackCaptain.getHomeX(),
+						ai.attackCaptain.getHomeY()) < (size + 400f))) {
+					continue;
+				}
+				if (overlapsBuildJob(ai, type, point.x, point.y) || isObstructed(ai, type, builder, point.x, point.y)) {
+					continue;
+				}
+				if (!type.isCanBeBuiltOnThem() && (isObstructed(ai, type, builder, point.x + BUILDING_GAP, point.y)
+						|| isObstructed(ai, type, builder, point.x - BUILDING_GAP, point.y)
+						|| isObstructed(ai, type, builder, point.x, point.y + BUILDING_GAP)
+						|| isObstructed(ai, type, builder, point.x, point.y - BUILDING_GAP))) {
+					continue;
+				}
+				return new AbilityPointTarget(point.x, point.y);
+			}
+		}
+		return null;
+	}
+}
diff --git a/core/src/com/etheller/warsmash/parsers/jass/ai/AIController.java b/core/src/com/etheller/warsmash/parsers/jass/ai/AIController.java
new file mode 100644
index 0000000..53d25fa
--- /dev/null
+++ b/core/src/com/etheller/warsmash/parsers/jass/ai/AIController.java
@@ -0,0 +1,713 @@
+package com.etheller.warsmash.parsers.jass.ai;
+
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.Deque;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+import com.etheller.interpreter.ast.scope.GlobalScope;
+import com.etheller.interpreter.ast.value.CodeJassValue;
+import com.etheller.warsmash.util.War3ID;
+import com.etheller.warsmash.viewer5.handlers.w3x.environment.PathingGrid;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.CDestructable;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.CSimulation;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.CUnit;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.players.CAllianceType;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.players.CMapControl;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.players.CPlayer;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.trigger.enumtypes.CPlayerSlotState;
+
+/**
+ * The engine side of a computer player, what Warcraft III keeps behind the common.ai natives: towns and their
+ * gold mines, the harvest assignment, production and building placement, hero skills, the attack and defense
+ * captains and the map knowledge (creep camps, expansions, enemy bases) the race scripts ask for.
+ * <p>
+ * All of the player's AI state is kept here, where saved games find it; the work is done by the stateless helpers
+ * of this package.
+ */
+public class AIController {
+	public static final int ATTACK_CAPTAIN = 1;
+	public static final int DEFENSE_CAPTAIN = 2;
+	private static final int MEGA_TARGET_INTERVAL = 200;
+
+	final CSimulation simulation;
+	final GlobalScope globalScope;
+	final int playerIndex;
+	final CPlayer player;
+
+	final List<AITown> towns = new ArrayList<>();
+	AITown pendingExpansion;
+	final List<AIBuildJob> buildJobs = new ArrayList<>();
+	final List<int[]> harvestRequests = new ArrayList<>();
+	final Map<CUnit, int[]> harvestJobs = new LinkedHashMap<>();
+	boolean harvestPassPending;
+	int harvestCallTick;
+	final Set<CUnit> harvestUnsent = new LinkedHashSet<>();
+	CUnit harvestStarter;
+	boolean harvestStarterChosen;
+	final Map<Integer, List<CDestructable>> townTrees = new HashMap<>();
+	final Map<Integer, Integer> townTreesTick = new HashMap<>();
+	final AICaptain attackCaptain = new AICaptain();
+	final AICaptain defenseCaptain = new AICaptain();
+	final Set<CUnit> injured = new LinkedHashSet<>();
+	final Map<CUnit, float[]> lastPositions = new LinkedHashMap<>();
+	final List<AIGuardPost> guardPosts = new ArrayList<>();
+	final List<AIReplacement> replacements = new ArrayList<>();
+	final Map<CUnit, float[]> guardPositions = new LinkedHashMap<>();
+	boolean unitsSeen;
+	boolean gatheringStopped;
+	final List<AIZepWave> zepWaves = new ArrayList<>();
+	boolean stagePointSet;
+	float stageX;
+	float stageY;
+	int stagePassedGeneration = -1;
+	int stageArrivedGeneration = -1;
+	int stageArrivedTick;
+	final Set<CUnit> unreachable = new LinkedHashSet<>();
+	final Map<CUnit, CUnit> orderedTargets = new LinkedHashMap<>();
+	final Set<CUnit> gatherOrdered = new LinkedHashSet<>();
+	private final Deque<int[]> commands = new ArrayDeque<>();
+	final Map<War3ID, int[]> countCache = new HashMap<>();
+	int countCacheTick = -1;
+	private CUnit allianceTarget;
+	CUnit enemyBase;
+	CodeJassValue heroLevelsFunction;
+	CUnit levelingHero;
+	int levelingHeroLevel;
+	CUnit threat;
+	int retreatTick;
+	int fightGeneration = -1;
+	int goalProgressGeneration = -1;
+	float bestGoalDistance;
+	int goalProgressTick;
+	int ticks;
+
+	private boolean campaign;
+	boolean targetHeroes;
+	boolean peonsRepair;
+	boolean heroesFlee;
+	boolean unitsFlee;
+	boolean groupsFlee;
+	boolean ignoreInjured;
+	boolean heroesTakeItems;
+	boolean newHeroes = true;
+	boolean groupTimedLife = true;
+	private boolean watchMegaTargets;
+	private boolean slowChopping;
+	private CUnit megaTarget;
+	final Set<CUnit> ignoredUnits = new LinkedHashSet<>();
+	final Set<CUnit> ignoredHeroes = new LinkedHashSet<>();
+	int replacementCount = 3;
+	boolean amphibious;
+	AILand land;
+
+	static final class AIGuardPost {
+		final War3ID typeId;
+		final float x;
+		final float y;
+		CUnit unit;
+
+		private AIGuardPost(final War3ID typeId, final float x, final float y) {
+			this.typeId = typeId;
+			this.x = x;
+			this.y = y;
+		}
+	}
+
+	/**
+	 * A unit the player had when the AI started, trained anew and sent back to its place when it dies.
+	 */
+	static final class AIReplacement {
+		final War3ID typeId;
+		final float x;
+		final float y;
+		CUnit unit;
+		int used;
+		boolean pending;
+
+		AIReplacement(final CUnit unit) {
+			this.typeId = unit.getTypeId();
+			this.x = unit.getX();
+			this.y = unit.getY();
+			this.unit = unit;
+		}
+	}
+
+	static final class AIZepWave {
+		final CUnit zeppelin;
+		final List<CUnit> cargo = new ArrayList<>();
+		final float x;
+		final float y;
+		boolean flying;
+
+		AIZepWave(final CUnit zeppelin, final float x, final float y) {
+			this.zeppelin = zeppelin;
+			this.x = x;
+			this.y = y;
+		}
+	}
+
+	public AIController(final CSimulation simulation, final GlobalScope globalScope, final int playerIndex) {
+		this.simulation = simulation;
+		this.globalScope = globalScope;
+		this.playerIndex = playerIndex;
+		this.player = simulation.getPlayer(playerIndex);
+	}
+
+	public CPlayer getPlayer() {
+		return this.player;
+	}
+
+	public void update() {
+		this.ticks++;
+		if (this.towns.isEmpty()) {
+			AITowns.initTowns(this);
+		}
+		if ((this.ticks % 10) == 0) {
+			AIConstruction.updateBuildJobs(this);
+			AIProduction.updateHeroSkills(this);
+			AIDefense.placeNewUnits(this);
+			AIZeppelins.updateZepWaves(this);
+			AIAttack.updateCaptains(this);
+			if (this.heroesTakeItems) {
+				AIDefense.takeItems(this);
+			}
+		}
+		if (this.watchMegaTargets && ((this.ticks % MEGA_TARGET_INTERVAL) == (MEGA_TARGET_INTERVAL - 10))) {
+			this.megaTarget = AIMapKnowledge.getMegaTarget(this);
+		}
+		if ((this.ticks % 20) == 5) {
+			AITowns.refreshTowns(this);
+			AIHarvest.assignHarvesters(this);
+		}
+	}
+
+	public void setCampaign(final boolean campaign) {
+		this.campaign = campaign;
+	}
+
+	public void setTargetHeroes(final boolean targetHeroes) {
+		this.targetHeroes = targetHeroes;
+	}
+
+	public void setPeonsRepair(final boolean peonsRepair) {
+		this.peonsRepair = peonsRepair;
+	}
+
+	public void setHeroesFlee(final boolean heroesFlee) {
+		this.heroesFlee = heroesFlee;
+	}
+
+	public void setUnitsFlee(final boolean unitsFlee) {
+		this.unitsFlee = unitsFlee;
+	}
+
+	public void setGroupsFlee(final boolean groupsFlee) {
+		this.groupsFlee = groupsFlee;
+	}
+
+	public void setIgnoreInjured(final boolean ignoreInjured) {
+		this.ignoreInjured = ignoreInjured;
+	}
+
+	public void setHeroesTakeItems(final boolean heroesTakeItems) {
+		this.heroesTakeItems = heroesTakeItems;
+	}
+
+	public void setSlowChopping(final boolean slowChopping) {
+		this.slowChopping = slowChopping;
+	}
+
+	/**
+	 * Measured: with slow chopping each load a worker brings home is a tenth of its size, at least one, for gold as
+	 * well as lumber; the trips take as long as ever.
+	 */
+	public int scaleHarvestedAmount(final int amount) {
+		return this.slowChopping ? Math.max(1, amount / 10) : amount;
+	}
+
+	public void setWatchMegaTargets(final boolean watchMegaTargets) {
+		this.watchMegaTargets = watchMegaTargets;
+		if (!watchMegaTargets) {
+			this.megaTarget = null;
+		}
+	}
+
+	public void setGroupTimedLife(final boolean groupTimedLife) {
