+	private static List<CUnit> orderGroup(final AIController ai, final List<CUnit> members, final int orderId,
+			final float x, final float y) {
+		final List<CUnit> taken = new ArrayList<>();
+		// Blizzard launcher: each unit goes for its place on rings around the point (Reforged's CGroupMove formation
+		// is not in this engine).
+		for (int i = 0; i < members.size(); i++) {
+			final CUnit unit = members.get(i);
+			final double ring = StrictMath.sqrt(i) * 64;
+			final double angle = i * 2.399963;
+			final float slotX = (float) (x + (StrictMath.cos(angle) * ring));
+			final float slotY = (float) (y + (StrictMath.sin(angle) * ring));
+			if (unit.order(ai.simulation, orderId, new AbilityPointTarget(slotX, slotY))) {
+				taken.add(unit);
