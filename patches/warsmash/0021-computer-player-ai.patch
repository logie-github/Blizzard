+package com.etheller.warsmash.parsers.jass.ai;
+
+import static com.etheller.warsmash.parsers.jass.ai.AIUnits.distance;
+
+import java.util.List;
+import java.util.Map;
+
+import com.etheller.warsmash.parsers.jass.ai.AIController.AIGuardPost;
+import com.etheller.warsmash.parsers.jass.ai.AIController.AIReplacement;
+import com.etheller.warsmash.util.War3ID;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.CItem;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.CUnit;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.CAbility;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.skills.util.CBuffTimedLife;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.targeting.AbilityPointTarget;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.targeting.AbilityTarget;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.inventory.CAbilityInventory;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.behaviors.CBehaviorAttack;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.behaviors.inventory.CBehaviorGetItem;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.orders.OrderIds;
+
+/**
+ * Units that stay home: guard posts and guard positions, the defense captain and the threats to our towns.
+ */
+final class AIDefense {
+	private static final float THREAT_RADIUS = 1300f;
+	private static final float GUARD_RETURN_DISTANCE = 100f;
+	private static final float HOME_ITEM_RANGE = 1000f;
+	private static final float PATH_ITEM_RANGE = 400f;
+
+	private AIDefense() {
+	}
+
+	private static AIGuardPost nearestFreePost(final AIController ai, final CUnit unit) {
+		AIGuardPost best = null;
+		float bestDistance = Float.MAX_VALUE;
+		for (final AIGuardPost post : ai.guardPosts) {
+			if (post.typeId.equals(unit.getTypeId()) && ((post.unit == null) || post.unit.isDead())) {
+				final float d = distance(unit.getX(), unit.getY(), post.x, post.y);
+				if (d < bestDistance) {
+					bestDistance = d;
+					best = post;
+				}
+			}
+		}
+		return best;
+	}
+
+	private static boolean isTimedLife(final CUnit unit) {
+		for (final CAbility ability : unit.getAbilities()) {
+			if (ability instanceof CBuffTimedLife) {
+				return true;
+			}
+		}
+		return false;
+	}
+
+	static void leavePost(final AIController ai, final CUnit unit) {
+		for (final AIGuardPost post : ai.guardPosts) {
+			if (post.unit == unit) {
+				post.unit = null;
+			}
+		}
+	}
+
+	/**
+	 * Measured: units the player has when the AI starts keep their place as their guard position. Later ones do the
+	 * same until the script has called StopGathering (InitAI does); after that they go at once to a free guard post
+	 * of their type, nearest first, and the rest join the defense captain at its home.
+	 */
+	static void placeNewUnits(final AIController ai) {
+		ai.guardPositions.keySet().removeIf((unit) -> unit.isDead());
+		updateReplacements(ai);
+		// Units made in the step the AI starts are not in getUnits yet but still count as existing before it.
+		for (final CUnit unit : ai.unitsSeen ? ai.simulation.getUnits() : ai.simulation.getUnitsIncludingNew()) {
+			if (!ai.isGuardCandidate(unit) || ai.guardPositions.containsKey(unit)) {
+				continue;
+			}
+			ai.guardPositions.put(unit, new float[] { unit.getX(), unit.getY() });
+			if (!ai.unitsSeen && (unit.getHeroData() != null)) {
+				ai.ignoredHeroes.add(unit);
+			}
+			if (!ai.unitsSeen && (unit.getHeroData() == null)) {
+				ai.replacements.add(new AIReplacement(unit));
+			}
+			if (ai.unitsSeen && takeReplacement(ai, unit)) {
+				continue;
+			}
+			if (!ai.unitsSeen || !ai.gatheringStopped || ai.attackCaptain.getMembers().contains(unit)) {
+				continue;
+			}
+			if (isTimedLife(unit)) {
+				// Measured: a summoned unit that appears later joins the attack group on its way, or, without
+				// GroupTimedLife, stays where it is and counts as ignored.
+				if (!ai.groupTimedLife) {
+					ai.ignoredUnits.add(unit);
+					continue;
+				}
+				if (ai.attackCaptain.hasGoal()) {
+					ai.attackCaptain.getMembers().add(unit);
+					continue;
+				}
+			}
+			final AIGuardPost post = nearestFreePost(ai, unit);
+			if (post != null) {
+				post.unit = unit;
+				ai.guardPositions.put(unit, new float[] { post.x, post.y });
+				unit.order(ai.simulation, OrderIds.attack, new AbilityPointTarget(post.x, post.y));
+			}
+			else if (ai.isArmyUnit(unit)) {
+				joinDefense(ai, unit);
+			}
+		}
+		ai.unitsSeen = true;
+		produceReplacements(ai);
+	}
+
+	/**
+	 * Measured: a unit the player had when the AI started is trained again as soon as it dies, as many times as the
+	 * replacement count allows (three unless the script says otherwise), and the new one walks to its place.
+	 * Structures are not rebuilt this way.
+	 */
+	private static void updateReplacements(final AIController ai) {
+		for (final AIReplacement replacement : ai.replacements) {
+			if (!replacement.pending && (replacement.unit != null) && replacement.unit.isDead()) {
+				replacement.unit = null;
+				if (replacement.used < ai.replacementCount) {
+					replacement.used++;
+					replacement.pending = true;
+				}
+			}
+		}
+	}
+
+	private static void produceReplacements(final AIController ai) {
+		for (final AIReplacement replacement : ai.replacements) {
+			if (replacement.pending && !isInProduction(ai, replacement.typeId)) {
+				AIProduction.setProduce(ai, 1, replacement.typeId.getValue(), -1);
+			}
+		}
+	}
+
+	private static boolean isInProduction(final AIController ai, final War3ID typeId) {
+		return AIProduction.countUnits(ai, ai.playerIndex, typeId, false, -1) > AIProduction.countUnits(ai,
+				ai.playerIndex, typeId, true, -1);
+	}
+
+	private static boolean takeReplacement(final AIController ai, final CUnit unit) {
+		for (final AIReplacement replacement : ai.replacements) {
+			if (replacement.pending && replacement.typeId.equals(unit.getTypeId())) {
+				replacement.pending = false;
+				replacement.unit = unit;
+				ai.guardPositions.put(unit, new float[] { replacement.x, replacement.y });
+				unit.order(ai.simulation, OrderIds.attack, new AbilityPointTarget(replacement.x, replacement.y));
+				return true;
+			}
+		}
+		return false;
+	}
+
+	/**
+	 * Measured: every unit outside the captains that has wandered off walks back to its guard position, attack-moving,
+	 * even if a script had ordered it away; fighting units finish first.
+	 */
+	static void returnGuardPosts(final AIController ai) {
+		for (final Map.Entry<CUnit, float[]> entry : ai.guardPositions.entrySet()) {
+			final CUnit unit = entry.getKey();
+			final float[] position = entry.getValue();
+			if (unit.isDead() || unit.isHidden() || unit.isGuardPositionRemoved() || ai.attackCaptain.getMembers().contains(unit)
+					|| ai.defenseCaptain.getMembers().contains(unit)
+					|| (unit.getCurrentBehavior() instanceof CBehaviorAttack)
+					|| (distance(unit.getX(), unit.getY(), position[0], position[1]) < GUARD_RETURN_DISTANCE)) {
+				continue;
+			}
+			unit.order(ai.simulation, OrderIds.attack, new AbilityPointTarget(position[0], position[1]));
+		}
+	}
+
+	/**
+	 * Measured: a defender leaves its guard post or place for the defense home of that moment; a later SetCaptainHome
+	 * does not move it.
+	 */
+	private static void joinDefense(final AIController ai, final CUnit unit) {
+		leavePost(ai, unit);
+		ai.defenseCaptain.getMembers().add(unit);
+		final float x = ai.defenseCaptain.getHomeX();
+		final float y = ai.defenseCaptain.getHomeY();
+		ai.guardPositions.put(unit, new float[] { x, y });
+		unit.order(ai.simulation, OrderIds.AImove, new AbilityPointTarget(x, y));
+	}
+
+	/**
+	 * Measured: AddDefenders claims units at once, also ones the player had from the start, and is false without one.
+	 */
+	static boolean addDefenders(final AIController ai, final int qty, final int typeIdValue) {
+		final War3ID typeId = new War3ID(typeIdValue);
+		final List<CUnit> members = ai.defenseCaptain.getMembers();
+		int got = 0;
+		for (final CUnit unit : members) {
+			if (!unit.isDead() && unit.getTypeId().equals(typeId)) {
+				got++;
+			}
+		}
+		for (final CUnit unit : AIUnits.inClaimOrder(ai.simulation)) {
+			if (got >= qty) {
+				break;
+			}
+			if (unit.getTypeId().equals(typeId) && ai.isArmyUnit(unit) && !unit.isConstructing()
+					&& !members.contains(unit) && !ai.attackCaptain.getMembers().contains(unit)) {
+				joinDefense(ai, unit);
+				got++;
+			}
+		}
+		return got >= qty;
+	}
+
+	/**
+	 * Measured: any visible hostile unit near a town is a threat, creeps too, idle or fighting our allies; paused
+	 * units are not. Fights further out are left alone.
+	 */
+	private static CUnit findThreat(final AIController ai) {
+		CUnit best = null;
+		float bestDistance = Float.MAX_VALUE;
+		for (final AITown town : ai.towns) {
+			if (town.getHall() == null) {
+				continue;
+			}
+			final float x = town.getCenterX();
+			final float y = town.getCenterY();
+			final CUnit[] found = new CUnit[1];
+			final float[] foundDistance = { THREAT_RADIUS };
+			ai.simulation.getWorldCollision().enumUnitsInRange(x, y, THREAT_RADIUS, (unit) -> {
+				if (ai.isEnemy(unit) && !unit.isPaused() && unit.isVisible(ai.simulation, ai.playerIndex)) {
+					final float d = distance(x, y, unit.getX(), unit.getY());
+					if (d < foundDistance[0]) {
+						foundDistance[0] = d;
+						found[0] = unit;
+					}
+				}
+				return false;
+			});
+			if ((found[0] != null) && (foundDistance[0] < bestDistance)) {
+				bestDistance = foundDistance[0];
+				best = found[0];
+			}
+		}
+		return best;
+	}
+
+	static void updateDefense(final AIController ai) {
+		ai.threat = findThreat(ai);
+		final boolean attackIdle = !ai.attackCaptain.hasGoal() && !ai.attackCaptain.isRetreating();
+		final List<CUnit> defenders = ai.defenseCaptain.getMembers();
+		defenders.removeIf((unit) -> !ai.isArmyUnit(unit));
+		if (ai.threat != null) {
+			// Measured: the defenders attack-move halfway from their home to the threat, so they take on what comes
+			// within reach there and leave idle creeps further out alone. Ones still on their way to the defense
+			// home go to that point with the AI move instead and attack-move once they stand.
+			final AbilityPointTarget target = new AbilityPointTarget(
+					(ai.defenseCaptain.getHomeX() + ai.threat.getX()) / 2,
+					(ai.defenseCaptain.getHomeY() + ai.threat.getY()) / 2);
+			for (final CUnit unit : defenders) {
+				if (AIUnits.isAIMoving(unit)) {
+					redirectAIMove(ai, unit, target);
+				}
+				else if (!(unit.getCurrentBehavior() instanceof CBehaviorAttack)) {
+					unit.order(ai.simulation, OrderIds.attack, target);
+				}
+			}
+			if (attackIdle) {
+				for (final CUnit unit : ai.attackCaptain.getMembers()) {
+					if (!(unit.getCurrentBehavior() instanceof CBehaviorAttack)) {
+						unit.order(ai.simulation, OrderIds.attack, target);
+					}
+				}
+			}
+			return;
+		}
+		for (final CUnit unit : defenders) {
+			final float[] place = ai.guardPositions.get(unit);
+			if ((place != null) && AIUnits.isIdle(unit)
+					&& (distance(unit.getX(), unit.getY(), place[0], place[1]) > GUARD_RETURN_DISTANCE)) {
+				// Measured: back home with the AI move, walking past enemies.
+				unit.order(ai.simulation, OrderIds.AImove, new AbilityPointTarget(place[0], place[1]));
+			}
+		}
+	}
+
+	private static void redirectAIMove(final AIController ai, final CUnit unit, final AbilityPointTarget target) {
+		final AbilityTarget current = unit.getCurrentOrder().getTarget(ai.simulation);
+		if ((current == null) || (distance(current.getX(), current.getY(), target.x, target.y) > 1f)) {
+			unit.order(ai.simulation, OrderIds.AImove, target);
+		}
+	}
+
+	/**
+	 * Measured: with SetHeroesTakeItems a hero at home fetches the items lying around its place, up to about a
+	 * thousand away, and on the march picks up those close to its way; without it items are left alone.
+	 */
+	static void takeItems(final AIController ai) {
+		for (final CUnit hero : ai.simulation.getUnits()) {
+			if (!ai.isOurs(hero) || hero.isHidden() || (hero.getHeroData() == null)
+					|| (hero.getCurrentBehavior() instanceof CBehaviorAttack)
+					|| (hero.getCurrentBehavior() instanceof CBehaviorGetItem) || !hasFreeSlot(hero)) {
+				continue;
+			}
+			final boolean marching = ai.attackCaptain.getMembers().contains(hero) && ai.attackCaptain.hasGoal();
+			final float[] place = ai.guardPositions.get(hero);
+			final float x = marching || (place == null) ? hero.getX() : place[0];
+			final float y = marching || (place == null) ? hero.getY() : place[1];
+			final float range = marching ? PATH_ITEM_RANGE : HOME_ITEM_RANGE;
+			CItem best = null;
+			float bestDistance = range;
+			for (final CItem item : ai.simulation.getItems()) {
+				if (item.isDead() || item.isHidden() || (item.getContainedUnit() != null)) {
+					continue;
+				}
+				final float d = distance(x, y, item.getX(), item.getY());
+				if (d < bestDistance) {
+					bestDistance = d;
+					best = item;
+				}
+			}
+			if (best != null) {
+				hero.order(ai.simulation, OrderIds.getitem, best);
+			}
+		}
+	}
+
+	private static boolean hasFreeSlot(final CUnit hero) {
+		final CAbilityInventory inventory = hero.getInventoryData();
+		if (inventory == null) {
+			return false;
+		}
+		for (int i = 0; i < inventory.getItemCapacity(); i++) {
+			if (inventory.getItemInSlot(i) == null) {
+				return true;
+			}
+		}
+		return false;
+	}
+}
diff --git a/core/src/com/etheller/warsmash/parsers/jass/ai/AIHarvest.java b/core/src/com/etheller/warsmash/parsers/jass/ai/AIHarvest.java
new file mode 100644
index 0000000..5a95cb8
--- /dev/null
+++ b/core/src/com/etheller/warsmash/parsers/jass/ai/AIHarvest.java
@@ -0,0 +1,365 @@
+package com.etheller.warsmash.parsers.jass.ai;
+
+import static com.etheller.warsmash.parsers.jass.ai.AIUnits.canHarvestGold;
+import static com.etheller.warsmash.parsers.jass.ai.AIUnits.canHarvestLumber;
+import static com.etheller.warsmash.parsers.jass.ai.AIUnits.distance;
+import static com.etheller.warsmash.parsers.jass.ai.AIUnits.isBuilding;
+import static com.etheller.warsmash.parsers.jass.ai.AIUnits.isIdle;
+import static com.etheller.warsmash.parsers.jass.ai.AIUnits.isWorkerType;
+import static com.etheller.warsmash.parsers.jass.ai.AIUnits.minesFromOverlay;
+
+import java.util.ArrayList;
+import java.util.Iterator;
+import java.util.List;
+import java.util.Map;
+
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.CDestructable;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.CUnit;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.CUnitClassification;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.CWidget;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.harvest.CAbilityHarvest;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.harvest.CAbilityWispHarvest;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.behaviors.harvest.CBehaviorHarvest;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.behaviors.harvest.CBehaviorReturnResources;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.combat.CTargetType;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.orders.OrderIdUtils;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.orders.OrderIds;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.timers.CTimer;
+
+/**
+ * The computer player's workers: the gold and lumber jobs the scripts ask for, per town, and the repairs.
+ */
+final class AIHarvest {
+	static final int GOLD = 0;
+	static final int WOOD = 1;
+	private static final int TREE_CACHE_TICKS = CTimer.wholeSteps(20);
+	private static final int SETTLE_TICKS = 5;
+
+	private AIHarvest() {
+	}
+
+	static void harvest(final AIController ai, final int resource, final int town, final int peons) {
+		ai.harvestPassPending = true;
+		ai.harvestCallTick = ai.ticks;
+		if (peons > 0) {
+			ai.harvestRequests.add(new int[] { resource, town, peons });
+		}
+	}
+
+	private static boolean canDo(final AIController ai, final CUnit worker, final int resource, final int town) {
+		if (resource == WOOD) {
+			return canHarvestLumber(worker);
+		}
+		if (!canHarvestGold(worker)) {
+			return false;
+		}
+		final AITown aiTown = AITowns.getTown(ai, town);
+		if ((aiTown == null) || (aiTown.getMine() == null) || (aiTown.getGold() <= 0)) {
+			return false;
+		}
+		if (minesFromOverlay(worker)) {
+			return AITowns.ownsOverlay(ai, aiTown) || (worker.getFirstAbilityOfType(CAbilityWispHarvest.class) != null);
+		}
+		return aiTown.getOverlay() == null;
+	}
+
+	/**
+	 * Measured: the jobs are dealt out only when the script changes its requests. A lowered request takes the job
+	 * from the last workers who got it, but they go on with their work. A request still short takes idle workers
+	 * first, then free workers already at that resource, then free workers at the other one; of those, one carrying
+	 * a load stops and waits for the next change of requests, which sends it off. Workers inside a
+	 * mine are passed over, and so is the worker that was already mining when the script started. Idle workers left
+	 * without a job then mine gold.
+	 */
+	static void assignHarvesters(final AIController ai) {
+		final List<CUnit> workers = new ArrayList<>();
+		for (final CUnit unit : ai.simulation.getUnits()) {
+			if (ai.isOurs(unit) && !unit.isGuardPositionRemoved() && !ai.isBuildJobWorker(unit)
+					&& !ai.attackCaptain.getMembers().contains(unit) && (canHarvestGold(unit) || canHarvestLumber(unit))) {
+				workers.add(unit);
+			}
+		}
+		ai.harvestJobs.keySet().retainAll(workers);
+		ai.harvestUnsent.retainAll(ai.harvestJobs.keySet());
+		// A script sets its requests over several calls that may run in different ticks; they are dealt once it is
+		// done.
+		if (ai.harvestPassPending && ((ai.ticks - ai.harvestCallTick) >= SETTLE_TICKS)) {
+			ai.harvestPassPending = false;
+			if (!ai.harvestStarterChosen) {
+				ai.harvestStarterChosen = true;
+				for (final CUnit worker : workers) {
+					if (currentResource(worker) == GOLD) {
+						ai.harvestStarter = worker;
+						break;
+					}
+				}
+			}
+			dealJobs(ai, workers);
+			for (final CUnit worker : workers) {
+				if (!ai.harvestJobs.containsKey(worker) && !worker.isHidden() && isFree(worker)
+						&& isWorkerType(worker)) {
+					final int town = canDo(ai, worker, GOLD, 0) ? 0 : Math.max(AITowns.townWithMine(ai), 0);
+					if (canDo(ai, worker, GOLD, town)) {
+						orderHarvest(ai, worker, GOLD, town);
+					}
+				}
+			}
+		}
+		// Orders the town cannot carry out yet (no trees or mine known) are given again until the worker sets off.
+		for (final Iterator<CUnit> iterator = ai.harvestUnsent.iterator(); iterator.hasNext();) {
+			final CUnit worker = iterator.next();
+			if (!isIdle(worker)) {
+				iterator.remove();
+			}
+			else if (!worker.isHidden()) {
+				final int[] job = ai.harvestJobs.get(worker);
+				orderHarvest(ai, worker, job[0], job[1]);
+			}
+		}
+		if (ai.peonsRepair) {
+			assignRepairs(ai, workers);
+		}
+	}
+
+	private static void dealJobs(final AIController ai, final List<CUnit> workers) {
+		final List<int[]> requests = new ArrayList<>();
+		for (final int[] request : ai.harvestRequests) {
+			int[] merged = null;
+			for (final int[] existing : requests) {
+				if ((existing[0] == request[0]) && (existing[1] == request[1])) {
+					merged = existing;
+				}
+			}
+			if (merged == null) {
+				requests.add(new int[] { request[0], request[1], request[2] });
+			}
+			else {
+				merged[2] += request[2];
+			}
+		}
+		final List<CUnit> holders = new ArrayList<>(ai.harvestJobs.keySet());
+		for (int i = holders.size() - 1; i >= 0; i--) {
+			final CUnit worker = holders.get(i);
+			final int[] job = ai.harvestJobs.get(worker);
+			int wanted = 0;
+			for (final int[] request : requests) {
+				if ((request[0] == job[0]) && (request[1] == job[1])) {
+					wanted = request[2];
+				}
+			}
+			if (countJobs(ai, job[0], job[1]) > wanted) {
+				ai.harvestJobs.remove(worker);
+			}
+		}
+		for (final Map.Entry<CUnit, int[]> entry : ai.harvestJobs.entrySet()) {
+			final CUnit worker = entry.getKey();
+			if (!worker.isHidden() && isFree(worker)) {
+				ai.harvestUnsent.add(worker);
+				orderHarvest(ai, worker, entry.getValue()[0], entry.getValue()[1]);
+			}
+		}
+		for (final int[] request : requests) {
+			final int resource = request[0];
+			final int town = request[1];
+			for (int stage = 0; stage < 3; stage++) {
+				for (final CUnit worker : workers) {
+					if (countJobs(ai, resource, town) >= request[2]) {
+						break;
+					}
+					if (ai.harvestJobs.containsKey(worker) || (worker == ai.harvestStarter) || worker.isHidden()
+							|| isBuilding(worker) || !canDo(ai, worker, resource, town)) {
+						continue;
+					}
+					final boolean idle = isFree(worker);
+					if (stage == 0) {
+						if (idle) {
+							ai.harvestJobs.put(worker, new int[] { resource, town });
+							ai.harvestUnsent.add(worker);
+							orderHarvest(ai, worker, resource, town);
+						}
+						continue;
+					}
+					if (idle) {
+						continue;
+					}
+					final int doing = currentResource(worker);
+					if ((stage == 1) && (doing == resource)) {
+						ai.harvestJobs.put(worker, new int[] { resource, town });
+					}
+					else if ((stage == 2) && (doing != -1) && (doing != resource)) {
+						ai.harvestJobs.put(worker, new int[] { resource, town });
+						final CAbilityHarvest harvest = worker.getFirstAbilityOfType(CAbilityHarvest.class);
+						if (harvest.getCarriedResourceAmount() > 0) {
+							worker.order(ai.simulation, OrderIds.stop, null);
+						}
+						else {
+							ai.harvestUnsent.add(worker);
+							orderHarvest(ai, worker, resource, town);
+						}
+					}
+				}
+			}
+		}
+	}
+
+	/**
+	 * Idle, or a worker busy with something other than gathering, like the walk of a freshly made one.
+	 */
+	private static boolean isFree(final CUnit worker) {
+		return isIdle(worker) || (isWorkerType(worker) && (currentResource(worker) == -1) && !isBuilding(worker)
+				&& !(worker.getCurrentBehavior() instanceof CBehaviorHarvest)
+				&& !(worker.getCurrentBehavior() instanceof CBehaviorReturnResources));
+	}
+
+	private static int countJobs(final AIController ai, final int resource, final int town) {
+		int count = 0;
+		for (final int[] job : ai.harvestJobs.values()) {
+			if ((job[0] == resource) && (job[1] == town)) {
+				count++;
+			}
+		}
+		return count;
+	}
+
+	private static int currentResource(final CUnit worker) {
+		final CAbilityHarvest harvest = worker.getFirstAbilityOfType(CAbilityHarvest.class);
+		if (harvest == null) {
+			return -1;
+		}
+		final CWidget target = harvest.getLastHarvestTarget();
+		if (target instanceof CDestructable) {
+			return WOOD;
+		}
+		return target instanceof CUnit ? GOLD : -1;
+	}
+
+	private static void orderHarvest(final AIController ai, final CUnit worker, final int resource,
+			final int townId) {
+		final AITown town = AITowns.getTown(ai, townId);
+		if (town == null) {
+			return;
+		}
+		if (resource == GOLD) {
+			if (minesFromOverlay(worker)) {
+				if (AITowns.ownsOverlay(ai, town)) {
+					orderHarvestTarget(ai, worker, town.getOverlay());
+				}
+				else if ((town.getOverlay() == null) && (town.getMine() != null)) {
+					entangle(ai, town);
+				}
+			}
+			else if (town.getMine() != null) {
+				orderHarvestTarget(ai, worker, town.getMine());
+			}
+			return;
+		}
+		final List<CDestructable> trees = getTrees(ai, town);
+		int tries = 0;
+		for (final Iterator<CDestructable> iterator = trees.iterator(); iterator.hasNext() && (tries < 6);) {
+			final CDestructable tree = iterator.next();
+			if (tree.isDead()) {
+				iterator.remove();
+				continue;
+			}
+			tries++;
+			if (orderHarvestTarget(ai, worker, tree)) {
+				return;
+			}
+		}
+	}
+
+	/**
+	 * A worker that carries resources only takes the return order, so it returns them first and goes on to the
+	 * target from there.
+	 */
+	private static boolean orderHarvestTarget(final AIController ai, final CUnit worker, final CWidget target) {
+		if (worker.order(ai.simulation, OrderIds.harvest, target)) {
+			return true;
+		}
+		// Blizzard launcher: in this engine acolytes and wisps take their own orders, not "harvest"; then a right-click.
+		if ((worker.getFirstAbilityOfType(com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.harvest.CAbilityAcolyteHarvest.class) != null)
+				&& worker.order(ai.simulation, OrderIds.acolyteharvest, target)) {
+			return true;
+		}
+		if ((worker.getFirstAbilityOfType(CAbilityWispHarvest.class) != null)
+				&& worker.order(ai.simulation, OrderIds.wispharvest, target)) {
+			return true;
+		}
+		if (worker.order(ai.simulation, OrderIds.smart, target)) {
+			return true;
+		}
+		final CAbilityHarvest harvest = worker.getFirstAbilityOfType(CAbilityHarvest.class);
+		if ((harvest == null) || (harvest.getCarriedResourceAmount() <= 0)) {
+			return false;
+		}
+		harvest.setLastHarvestTarget(target);
+		return worker.order(ai.simulation, OrderIds.returnresources, null);
+	}
+
+	private static void entangle(final AIController ai, final AITown town) {
+		final int entangleOrder = OrderIdUtils.getOrderId("entangleinstant");
+		for (final CUnit unit : ai.simulation.getUnits()) {
+			if (ai.isOurs(unit) && AIUnits.isReady(unit)
+					&& unit.getClassifications().contains(CUnitClassification.TOWNHALL)
+					&& (distance(unit.getX(), unit.getY(), town.getMine().getX(), town.getMine().getY()) < 1200)) {
+				unit.order(ai.simulation, entangleOrder, town.getMine());
+				return;
+			}
+		}
+	}
+
+	private static List<CDestructable> getTrees(final AIController ai, final AITown town) {
+		final Integer cachedTick = ai.townTreesTick.get(town.getId());
+		List<CDestructable> trees = ai.townTrees.get(town.getId());
+		if ((trees == null) || (cachedTick == null) || ((ai.ticks - cachedTick) > TREE_CACHE_TICKS)
+				|| trees.isEmpty()) {
+			trees = new ArrayList<>();
+			final float cx = town.getCenterX();
+			final float cy = town.getCenterY();
+			for (final CDestructable destructable : ai.simulation.getDestructables()) {
+				if (!destructable.isDead() && destructable.getDestType().getTargetedAs().contains(CTargetType.TREE)
+						&& (distance(cx, cy, destructable.getX(), destructable.getY()) < 2500)) {
+					trees.add(destructable);
+				}
+			}
+			trees.sort((a, b) -> Float.compare(distance(cx, cy, a.getX(), a.getY()),
+					distance(cx, cy, b.getX(), b.getY())));
+			ai.townTrees.put(town.getId(), trees);
+			ai.townTreesTick.put(town.getId(), ai.ticks);
+		}
+		return trees;
+	}
+
+	private static void assignRepairs(final AIController ai, final List<CUnit> workers) {
+		if (ai.threat != null) {
+			return;
+		}
+		for (final CUnit worker : workers) {
+			if (isBuilding(worker) && !ai.isBuildJobWorker(worker)) {
+				return;
+			}
+		}
+		for (final CUnit unit : ai.simulation.getUnits()) {
+			if (!ai.isOurs(unit) || !unit.isBuilding() || unit.isConstructing() || unit.isUpgrading()
+					|| (unit.getLife() > (unit.getMaxLife() * 0.6f))) {
+				continue;
+			}
+			CUnit best = null;
+			float bestDistance = 1500f;
+			for (final CUnit worker : workers) {
+				final int[] job = ai.harvestJobs.get(worker);
+				if (worker.isHidden() || (job == null) || (job[0] != WOOD)) {
+					continue;
+				}
+				final float d = distance(worker.getX(), worker.getY(), unit.getX(), unit.getY());
+				if (d < bestDistance) {
+					bestDistance = d;
+					best = worker;
+				}
+			}
+			if ((best != null) && best.order(ai.simulation, AIUnits.repairOrderId(best), unit)) {
+				return;
+			}
+		}
+	}
+}
diff --git a/core/src/com/etheller/warsmash/parsers/jass/ai/AILand.java b/core/src/com/etheller/warsmash/parsers/jass/ai/AILand.java
new file mode 100644
index 0000000..11bc76a
--- /dev/null
+++ b/core/src/com/etheller/warsmash/parsers/jass/ai/AILand.java
@@ -0,0 +1,98 @@
+package com.etheller.warsmash.parsers.jass.ai;
+
+import java.util.Arrays;
+
+import com.etheller.warsmash.viewer5.handlers.w3x.environment.PathingGrid;
+import com.etheller.warsmash.viewer5.handlers.w3x.environment.PathingGrid.PathingFlags;
+
+/**
+ * The land masses of the map as the computer player plans routes for amphibious units it has not been told to take
+ * through water: walkable cells that are not water, shallow water included.
+ */
+final class AILand {
+	private static final int NONE = -1;
+
+	private final PathingGrid grid;
+	private final int width;
+	private final int height;
+	private final int[] masses;
+
+	private AILand(final PathingGrid grid) {
+		this.grid = grid;
+		this.width = grid.getWidth();
+		this.height = grid.getHeight();
+		this.masses = new int[this.width * this.height];
+		Arrays.fill(this.masses, NONE);
+		final int[] queue = new int[this.masses.length];
+		int next = 0;
+		for (int start = 0; start < this.masses.length; start++) {
+			if ((this.masses[start] != NONE) || !isLand(start)) {
+				continue;
+			}
+			final int mass = next++;
+			int head = 0;
+			int tail = 0;
+			queue[tail++] = start;
+			this.masses[start] = mass;
+			while (head < tail) {
+				final int cell = queue[head++];
+				final int x = cell % this.width;
+				final int y = cell / this.width;
+				for (int step = 0; step < 4; step++) {
+					final int nx = x + ((step == 0) ? 1 : (step == 1) ? -1 : 0);
+					final int ny = y + ((step == 2) ? 1 : (step == 3) ? -1 : 0);
+					if ((nx < 0) || (ny < 0) || (nx >= this.width) || (ny >= this.height)) {
+						continue;
+					}
+					final int neighbor = (ny * this.width) + nx;
+					if ((this.masses[neighbor] == NONE) && isLand(neighbor)) {
+						this.masses[neighbor] = mass;
+						queue[tail++] = neighbor;
+					}
+				}
+			}
+		}
+	}
+
+	static AILand of(final AIController ai) {
+		if ((ai.land == null) || (ai.land.grid != ai.simulation.getPathingGrid())) {
+			ai.land = new AILand(ai.simulation.getPathingGrid());
+		}
+		return ai.land;
+	}
+
+	private boolean isLand(final int cell) {
+		final short pathing = this.grid.getTerrainPathing(this.grid.getWorldX(cell % this.width),
+				this.grid.getWorldY(cell / this.width));
+		return !PathingFlags.isPathingFlag(pathing, PathingFlags.UNWALKABLE)
+				&& PathingFlags.isPathingFlag(pathing, PathingFlags.UNSWIMABLE);
+	}
+
+	/**
+	 * @return the land mass of the nearest land cell within the radius, or -1
+	 */
+	int massNear(final float x, final float y, final float radius) {
+		final int cx = this.grid.getCellX(x);
+		final int cy = this.grid.getCellY(y);
+		final int cells = (int) Math.ceil(radius / 32f);
+		int best = NONE;
+		int bestDistance = Integer.MAX_VALUE;
+		for (int dy = -cells; dy <= cells; dy++) {
+			for (int dx = -cells; dx <= cells; dx++) {
+				final int nx = cx + dx;
+				final int ny = cy + dy;
+				final int d = (dx * dx) + (dy * dy);
+				if ((nx < 0) || (ny < 0) || (nx >= this.width) || (ny >= this.height) || (d >= bestDistance)
+						|| (d > (cells * cells))) {
+					continue;
+				}
+				final int mass = this.masses[(ny * this.width) + nx];
+				if (mass != NONE) {
+					best = mass;
+					bestDistance = d;
+				}
+			}
+		}
+		return best;
+	}
+}
diff --git a/core/src/com/etheller/warsmash/parsers/jass/ai/AIMapKnowledge.java b/core/src/com/etheller/warsmash/parsers/jass/ai/AIMapKnowledge.java
new file mode 100644
index 0000000..e43a977
--- /dev/null
+++ b/core/src/com/etheller/warsmash/parsers/jass/ai/AIMapKnowledge.java
@@ -0,0 +1,222 @@
+package com.etheller.warsmash.parsers.jass.ai;
+
+import static com.etheller.warsmash.parsers.jass.ai.AIUnits.distance;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+import com.etheller.warsmash.viewer5.handlers.w3x.environment.PathingGrid;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.CUnit;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.CUnitClassification;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.hero.CAbilityHero;
+
+/**
+ * What the computer player knows of the map beyond its own towns: creep camps, the opponents' bases and expansions,
+ * and how strong the opponents' armies are.
+ */
+final class AIMapKnowledge {
+	private static final float CAMP_LINK_DISTANCE = 600f;
+
+	private AIMapKnowledge() {
+	}
+
+	static CUnit getCreepCamp(final AIController ai, final int minLevel, final int maxLevel, final boolean flyersOk) {
+		final List<CUnit> creeps = new ArrayList<>();
+		for (final CUnit unit : ai.simulation.getUnits()) {
+			if (!unit.isDead() && !unit.isHidden() && ai.simulation.isNeutralAggressive(unit.getPlayerIndex())
+					&& !unit.isBuilding()) {
+				creeps.add(unit);
+			}
+		}
+		final float homeX = ai.attackCaptain.getHomeX();
+		final float homeY = ai.attackCaptain.getHomeY();
+		final Set<CUnit> visited = new HashSet<>();
+		CUnit best = null;
+		float bestDistance = Float.MAX_VALUE;
+		for (final CUnit seed : creeps) {
+			if (visited.contains(seed)) {
+				continue;
+			}
+			final List<CUnit> camp = new ArrayList<>();
+			camp.add(seed);
+			visited.add(seed);
+			for (int i = 0; i < camp.size(); i++) {
+				final CUnit member = camp.get(i);
+				for (final CUnit other : creeps) {
+					if (!visited.contains(other) && (distance(member.getX(), member.getY(), other.getX(),
+							other.getY()) < CAMP_LINK_DISTANCE)) {
+						visited.add(other);
+						camp.add(other);
+					}
+				}
+			}
+			int level = 0;
+			boolean flyers = false;
+			CUnit strongest = null;
+			float x = 0;
+			float y = 0;
+			for (final CUnit member : camp) {
+				level += member.getUnitType().getLevel();
+				flyers |= member.getUnitType().getMovementType() == PathingGrid.MovementType.FLY;
+				if ((strongest == null) || (member.getUnitType().getLevel() > strongest.getUnitType().getLevel())) {
+					strongest = member;
+				}
+				x += member.getX();
+				y += member.getY();
+			}
+			x /= camp.size();
+			y /= camp.size();
+			boolean reachable = true;
+			for (final CUnit member : camp) {
+				reachable &= !ai.unreachable.contains(member);
+			}
+			if ((level < minLevel) || (level > maxLevel) || (flyers && !flyersOk) || !reachable
+					|| nearEnemyBase(ai, x, y)) {
+				continue;
+			}
+			final float d = distance(homeX, homeY, x, y);
+			if (d < bestDistance) {
+				bestDistance = d;
+				best = strongest;
+			}
+		}
+		return best;
+	}
+
+	private static boolean nearEnemyBase(final AIController ai, final float x, final float y) {
+		for (final CUnit unit : ai.simulation.getUnits()) {
+			if (!unit.isDead() && unit.isBuilding() && ai.isOpponent(unit.getPlayerIndex())
+					&& (distance(x, y, unit.getX(), unit.getY()) < 1500)) {
+				return true;
+			}
+		}
+		return false;
+	}
+
+	static boolean creepsOnMap(final AIController ai) {
+		for (final CUnit unit : ai.simulation.getUnits()) {
+			if (!unit.isDead() && ai.simulation.isNeutralAggressive(unit.getPlayerIndex())) {
+				return true;
+			}
+		}
+		return false;
+	}
+
+	static CUnit getEnemyBase(final AIController ai) {
+		if ((ai.enemyBase == null) || ai.enemyBase.isDead()) {
+			ai.enemyBase = findEnemyBase(ai, -1);
+		}
+		return ai.enemyBase;
+	}
+
+	/**
+	 * @param onlyPlayer -1 for the nearest opponent
+	 * @return the town hall nearest to that opponent's start location, else any of its buildings
+	 */
+	static CUnit findEnemyBase(final AIController ai, final int onlyPlayer) {
+		final AITown home = AITowns.getTown(ai, 0);
+		final float[] start = ai.player.getStartLocation();
+		final float hx = home == null ? start[0] : home.getX();
+		final float hy = home == null ? start[1] : home.getY();
+		CUnit best = null;
+		float bestScore = Float.MAX_VALUE;
+		for (final CUnit unit : ai.simulation.getUnits()) {
+			if (unit.isDead() || !unit.isBuilding() || !ai.isOpponent(unit.getPlayerIndex())
+					|| ((onlyPlayer != -1) && (unit.getPlayerIndex() != onlyPlayer))) {
+				continue;
+			}
+			final float[] enemyStart = ai.simulation.getPlayer(unit.getPlayerIndex()).getStartLocation();
+			float score = distance(hx, hy, enemyStart[0], enemyStart[1])
+					+ distance(unit.getX(), unit.getY(), enemyStart[0], enemyStart[1]);
+			if (!unit.getClassifications().contains(CUnitClassification.TOWNHALL)) {
+				score += 3000;
+			}
+			if (score < bestScore) {
+				bestScore = score;
+				best = unit;
+			}
+		}
+		return best;
+	}
+
+	static CUnit getEnemyExpansion(final AIController ai) {
+		final AITown home = AITowns.getTown(ai, 0);
+		if (home == null) {
+			return null;
+		}
+		CUnit best = null;
+		float bestDistance = Float.MAX_VALUE;
+		for (final CUnit unit : ai.simulation.getUnits()) {
+			if (unit.isDead() || !ai.isOpponent(unit.getPlayerIndex())
+					|| !(unit.getClassifications().contains(CUnitClassification.TOWNHALL)
+							|| (unit.getOverlayedGoldMineData() != null))) {
+				continue;
+			}
+			final float[] enemyStart = ai.simulation.getPlayer(unit.getPlayerIndex()).getStartLocation();
+			if (distance(unit.getX(), unit.getY(), enemyStart[0], enemyStart[1]) < 1500) {
+				continue;
+			}
+			final float d = distance(home.getX(), home.getY(), unit.getX(), unit.getY());
+			if (d < bestDistance) {
+				bestDistance = d;
+				best = unit;
+			}
+		}
+		return best;
+	}
+
+	private static int armyPower(final AIController ai, final int ownerIndex) {
+		int power = 0;
+		for (final CUnit unit : ai.simulation.getUnits()) {
+			if ((unit.getPlayerIndex() == ownerIndex) && !unit.isDead() && !unit.isBuilding()
+					&& !AIUnits.isWorkerType(unit)) {
+				final CAbilityHero heroData = unit.getHeroData();
+				power += heroData != null ? heroData.getHeroLevel() * 2 : unit.getUnitType().getLevel();
+			}
+		}
+		return power;
+	}
+
+	/**
+	 * Measured: zero for campaign and melee scripts alike, with the opponent's army unseen, in sight, beside our base,
+	 * with a hero and with creeps around.
+	 */
+	static int getEnemyPower(final AIController ai) {
+		return 0;
+	}
+
+	/**
+	 * An opponent whose army is far weaker than ours is worth an all-out attack on its main base.
+	 */
+	static CUnit getMegaTarget(final AIController ai) {
+		final int ours = armyPower(ai, ai.playerIndex);
+		if (ours < 20) {
+			return null;
+		}
+		for (int i = 0; i < ai.simulation.getPlayers().size(); i++) {
+			if (ai.isOpponent(i) && ((armyPower(ai, i) * 3) <= ours)) {
+				final CUnit base = findEnemyBase(ai, i);
+				if (base != null) {
+					return base;
+				}
+			}
+		}
+		return null;
+	}
+
+	static boolean isTowered(final AIController ai, final CUnit target) {
+		if (target == null) {
+			return false;
+		}
+		for (final CUnit unit : ai.simulation.getUnits()) {
+			if (!unit.isDead() && unit.isBuilding() && !unit.isConstructing()
+					&& ai.isEnemyPlayer(unit.getPlayerIndex()) && !unit.getUnitType().getAttacks().isEmpty()
+					&& (distance(unit.getX(), unit.getY(), target.getX(), target.getY()) < 1000)) {
+				return true;
+			}
+		}
+		return false;
+	}
+}
diff --git a/core/src/com/etheller/warsmash/parsers/jass/ai/AIProduction.java b/core/src/com/etheller/warsmash/parsers/jass/ai/AIProduction.java
new file mode 100644
index 0000000..c273544
--- /dev/null
+++ b/core/src/com/etheller/warsmash/parsers/jass/ai/AIProduction.java
@@ -0,0 +1,398 @@
+package com.etheller.warsmash.parsers.jass.ai;
+
+import static com.etheller.warsmash.parsers.jass.ai.AIUnits.isReady;
+import static com.etheller.warsmash.parsers.jass.ai.AIUnits.queueLength;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import com.etheller.interpreter.ast.execution.JassThread;
+import com.etheller.interpreter.ast.scope.TriggerExecutionScope;
+import com.etheller.interpreter.ast.value.IntegerJassValue;
+import com.etheller.interpreter.ast.value.JassValue;
+import com.etheller.interpreter.ast.value.visitor.IntegerJassValueVisitor;
+import com.etheller.warsmash.util.War3ID;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.CUnit;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.CUnit.QueueItemType;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.CUnitType;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.CUpgradeType;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.hero.CAbilityHero;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.queue.CAbilityQueue;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.queue.CAbilityReviveHero;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.abilities.upgrade.CAbilityUpgrade;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.orders.OrderIdUtils;
+import com.etheller.warsmash.viewer5.handlers.w3x.simulation.players.CPlayer;
+
+/**
+ * What the computer player has and makes: unit counts as the AI sees them, training units and heroes, research,
+ * structure upgrades, hero skills and the unit transformations the scripts order.
+ */
+final class AIProduction {
+	// Measured on 1.29: the AI only trains on an idle producer; SetProduce is false while all of them are busy, which
+	// holds back the rest of the build priorities.
+	private static final int MAX_QUEUED_PER_PRODUCER = 1;
+
+	private AIProduction() {
+	}
+
+	static int getUnitCount(final AIController ai, final int typeId, final boolean done) {
+		if (ai.countCacheTick != ai.simulation.getGameTurnTick()) {
+			ai.countCacheTick = ai.simulation.getGameTurnTick();
+			ai.countCache.clear();
+		}
+		final War3ID id = new War3ID(typeId);
+		int[] counts = ai.countCache.get(id);
+		if (counts == null) {
+			counts = new int[] { countUnits(ai, ai.playerIndex, id, false, -1),
+					countUnits(ai, ai.playerIndex, id, true, -1) };
+			ai.countCache.put(id, counts);
+		}
+		return done ? counts[1] : counts[0];
+	}
+
+	/**
+	 * Counts units of a type like the AI sees them: a structure being upgraded counts as its new type until done,
+	 * queued units and heroes being revived count as not done, and so do the structures our workers are on
+	 * their way to build.
+	 */
+	static int countUnits(final AIController ai, final int ownerIndex, final War3ID id, final boolean done,
+			final int town) {
+		int count = 0;
+		for (final CUnit unit : ai.simulation.getUnits()) {
+			if ((unit.getPlayerIndex() != ownerIndex) || unit.isDead()) {
+				continue;
+			}
+			if ((town != -1) && (AITowns.townOf(ai, unit.getX(), unit.getY()) != town)) {
+				continue;
+			}
+			if (unit.isUpgrading()) {
+				if (done ? id.equals(unit.getTypeId()) : id.equals(unit.getUpgradeIdType())) {
+					count++;
+				}
+			}
+			else if (id.equals(unit.getTypeId()) && (!done || !unit.isConstructing())) {
+				count++;
+			}
+			if (!done) {
+				final War3ID[] queue = unit.getBuildQueue();
+				final QueueItemType[] types = unit.getBuildQueueTypes();
+				for (int i = 0; i < queue.length; i++) {
+					if (queue[i] == null) {
+						continue;
+					}
+					if ((types[i] == QueueItemType.UNIT) && id.equals(queue[i])) {
+						count++;
+					}
+					else if (types[i] == QueueItemType.HERO_REVIVE) {
+						final CUnit hero = ai.simulation.getUnit(queue[i].getValue());
+						if ((hero != null) && id.equals(hero.getTypeId())) {
+							count++;
+						}
+					}
+				}
+			}
+		}
+		if (!done && (ownerIndex == ai.playerIndex)) {
+			for (final AIBuildJob job : ai.buildJobs) {
+				if (id.equals(job.getTypeId()) && ((town == -1) || (job.getTown() == town))
+						&& !AIConstruction.isLaidDown(ai, job)) {
+					count++;
+				}
+			}
+		}
+		return count;
+	}
+
+	static boolean requirementsMet(final AIController ai, final CUnitType type) {
+		final CPlayer player = ai.player;
+		if (!player.isTechtreeAllowedByMax(type.getTypeId())) {
+			return false;
+		}
+		if (!AIUnits.requirementsUnlocked(player, type.getRequirements())) {
+			return false;
+		}
+		if (type.isHero()) {
+			if (!player.isHeroCountAllowedByMax(ai.simulation)) {
+				return false;
+			}
+			if (!AIUnits.requirementsUnlocked(player,
+					type.getRequirementsTier(player.getHeroCount(ai.simulation, true)))) {
+				return false;
+			}
+		}
+		return true;
+	}
+
+	static boolean canAfford(final AIController ai, final CUnitType type) {
+		return (ai.player.getGold() >= type.getGoldCost()) && (ai.player.getLumber() >= type.getLumberCost());
+	}
+
+	static boolean setProduce(final AIController ai, final int qty, final int typeIdValue, final int town) {
+		final War3ID typeId = new War3ID(typeIdValue);
+		final CUnitType type = ai.simulation.getUnitData().getUnitType(typeId);
+		if ((type == null) || (qty <= 0)) {
+			return false;
+		}
+		if (type.isHero()) {
+			return produceHero(ai, type);
+		}
+		if (AIConstruction.canBeBuiltByUs(ai, type)) {
+			return AIConstruction.buildStructures(ai, qty, type, town);
+		}
+		final List<CUnit> bases = new ArrayList<>();
+		final List<CUnit> producers = new ArrayList<>();
+		boolean anyBase = false;
+		for (final CUnit unit : AIUnits.inClaimOrder(ai.simulation)) {
+			if (!ai.isOurs(unit) || ((town != -1) && (AITowns.townOf(ai, unit.getX(), unit.getY()) != town))) {
+				continue;
+			}
+			final CAbilityUpgrade upgrade = unit.getFirstAbilityOfType(CAbilityUpgrade.class);
+			if ((upgrade != null) && upgrade.getUpgradesTo().contains(typeId)) {
+				anyBase = true;
+				if (isReady(unit)) {
+					bases.add(unit);
+				}
+			}
+			final CAbilityQueue queue = unit.getFirstAbilityOfType(CAbilityQueue.class);
+			if ((queue != null) && queue.getUnitsTrained().contains(typeId) && isReady(unit)) {
+				producers.add(unit);
+			}
+		}
+		if (anyBase) {
+			if (!requirementsMet(ai, type)) {
+				return false;
+			}
+			int started = 0;
+			for (final CUnit base : bases) {
+				if (started >= qty) {
+					break;
+				}
+				if ((base.getBuildQueue()[0] == null) && base.order(ai.simulation, typeIdValue, null)) {
+					started++;
+				}
+			}
+			return started > 0;
+		}
+		if (producers.isEmpty() || !requirementsMet(ai, type)) {
+			return false;
+		}
+		if (!canAfford(ai, type)) {
+			// Measured: short of money it is true while a producer is idle, and nothing is queued.
+			for (final CUnit producer : producers) {
+				if (queueLength(producer) < MAX_QUEUED_PER_PRODUCER) {
+					return true;
+				}
+			}
+			return false;
+		}
+		return train(ai, producers, typeIdValue, qty) > 0;
+	}
+
+	private static int train(final AIController ai, final List<CUnit> producers, final int typeIdValue,
+			final int qty) {
+		int started = 0;
+		for (int i = 0; i < qty; i++) {
+			CUnit best = null;
+			int bestQueue = MAX_QUEUED_PER_PRODUCER;
+			for (final CUnit producer : producers) {
+				final int length = queueLength(producer);
+				if (length < bestQueue) {
+					bestQueue = length;
+					best = producer;
+				}
+			}
+			if ((best == null) || !best.order(ai.simulation, typeIdValue, null)) {
+				break;
+			}
+			started++;
+		}
+		if (started > 0) {
+			ai.countCache.clear();
+		}
+		return started;
+	}
+
+	private static boolean produceHero(final AIController ai, final CUnitType type) {
+		CUnit altar = null;
+		CUnit deadHero = null;
+		final List<CUnit> producers = new ArrayList<>();
+		for (final CUnit unit : ai.simulation.getUnits()) {
+			if (unit.getPlayerIndex() != ai.playerIndex) {
+				continue;
+			}
+			if (unit.isDead()) {
+				final CAbilityHero heroData = unit.getHeroData();
+				if ((heroData != null) && unit.getTypeId().equals(type.getTypeId()) && heroData.isAwaitingRevive()
+						&& !heroData.isReviving()) {
+					deadHero = unit;
+				}
+				continue;
+			}
+			if (!isReady(unit)) {
+				continue;
+			}
+			if ((altar == null) && (unit.getFirstAbilityOfType(CAbilityReviveHero.class) != null)
+					&& (queueLength(unit) < MAX_QUEUED_PER_PRODUCER)) {
+				altar = unit;
+			}
+			final CAbilityQueue queue = unit.getFirstAbilityOfType(CAbilityQueue.class);
+			if ((queue != null) && queue.getUnitsTrained().contains(type.getTypeId())) {
+				producers.add(unit);
+			}
+		}
+		if (deadHero != null) {
+			if (altar == null) {
+				return false;
+			}
+			altar.order(ai.simulation, deadHero.getHandleId(), null);
+			return true;
+		}
+		if (!ai.newHeroes || producers.isEmpty() || !requirementsMet(ai, type)) {
+			return false;
+		}
+		return train(ai, producers, type.getTypeId().getValue(), 1) > 0;
+	}
+
+	static int getUpgradeLevel(final AIController ai, final int typeId) {
+		final War3ID id = new War3ID(typeId);
+		return ai.player.getTechtreeUnlocked(id) + ai.player.getTechtreeInProgress(id);
+	}
+
+	static int getUpgradeGoldCost(final AIController ai, final int typeId) {
+		final War3ID id = new War3ID(typeId);
+		final CUpgradeType upgrade = ai.simulation.getUpgradeData().getType(id);
+		return upgrade == null ? 0 : upgrade.getGoldCost(ai.player.getTechtreeUnlocked(id));
+	}
+
+	static int getUpgradeWoodCost(final AIController ai, final int typeId) {
+		final War3ID id = new War3ID(typeId);
+		final CUpgradeType upgrade = ai.simulation.getUpgradeData().getType(id);
+		return upgrade == null ? 0 : upgrade.getLumberCost(ai.player.getTechtreeUnlocked(id));
+	}
+
+	static boolean setUpgrade(final AIController ai, final int typeId) {
+		final War3ID id = new War3ID(typeId);
+		final CUpgradeType upgrade = ai.simulation.getUpgradeData().getType(id);
+		if (upgrade == null) {
+			return false;
+		}
+		if (ai.player.getTechtreeInProgress(id) > 0) {
+			return true;
+		}
+		final CUpgradeType.UpgradeLevel level = upgrade.getLevel(ai.player.getTechtreeUnlocked(id));
+		if ((level == null) || !AIUnits.requirementsUnlocked(ai.player, level.getRequirements())) {
+			return false;
+		}
+		CUnit best = null;
+		for (final CUnit unit : ai.simulation.getUnits()) {
+			if (ai.isOurs(unit) && isReady(unit)) {
+				final CAbilityQueue queue = unit.getFirstAbilityOfType(CAbilityQueue.class);
+				if ((queue != null) && queue.getResearchesAvailable().contains(id)
+						&& ((best == null) || (queueLength(unit) < queueLength(best)))) {
+					best = unit;
+				}
+			}
+		}
+		if ((best == null) || (queueLength(best) >= MAX_QUEUED_PER_PRODUCER)) {
+			return false;
+		}
+		return best.order(ai.simulation, typeId, null);
+	}
+
+	static void updateHeroSkills(final AIController ai) {
+		if (ai.heroLevelsFunction == null) {
+			return;
+		}
+		for (final CUnit unit : ai.simulation.getUnits()) {
+			if (!ai.isOurs(unit)) {
+				continue;
+			}
+			final CAbilityHero heroData = unit.getHeroData();
+			if (heroData == null) {
+				continue;
+			}
+			for (int guard = 0; (guard < 4) && (heroData.getSkillPoints() > 0); guard++) {
+				final int before = heroData.getSkillPoints();
+				ai.levelingHero = unit;
+				ai.levelingHeroLevel = Math.max(1, (heroData.getHeroLevel() - before) + 1);
+				int skill = 0;
+				try {
+					final JassThread thread = ai.globalScope.createThreadCapturingReturnValue(ai.heroLevelsFunction,
+							TriggerExecutionScope.EMPTY);
+					final JassValue value = ai.globalScope.runThreadUntilCompletionAndReadReturnValue(thread,
+							"SetHeroLevels", IntegerJassValue.ZERO);
+					if (value != null) {
+						skill = value.visit(IntegerJassValueVisitor.getInstance());
+					}
+				}
+				finally {
+					ai.levelingHero = null;
+				}
+				if (skill != 0) {
+					heroData.selectHeroSkill(ai.simulation, unit, new War3ID(skill));
+				}
+				if (heroData.getSkillPoints() == before) {
+					for (final War3ID other : unit.getUnitType().getHeroAbilityList()) {
+						heroData.selectHeroSkill(ai.simulation, unit, other);
+						if (heroData.getSkillPoints() != before) {
+							break;
+						}
+					}
+				}
+				if (heroData.getSkillPoints() == before) {
+					break;
+				}
+			}
+		}
+	}
+
+	static boolean mergeUnits(final AIController ai, final int qty, final int typeA, final int typeB,
+			final int result) {
+		if (getUnitCount(ai, result, false) >= qty) {
+			return true;
+		}
+		final War3ID a = new War3ID(typeA);
+		final War3ID b = new War3ID(typeB);
+		CUnit first = null;
+		CUnit second = null;
+		for (final CUnit unit : ai.simulation.getUnits()) {
+			if (ai.isArmyUnit(unit) && AIUnits.isIdle(unit) && !ai.attackCaptain.getMembers().contains(unit)) {
+				if ((first == null) && unit.getTypeId().equals(a)) {
+					first = unit;
+				}
+				else if ((second == null) && unit.getTypeId().equals(b)) {
+					second = unit;
+				}
+			}
+		}
+		if ((first == null) || (second == null)) {
+			return false;
+		}
+		return second.order(ai.simulation, OrderIdUtils.getOrderId("coupletarget"), first)
+				|| first.order(ai.simulation, OrderIdUtils.getOrderId("coupletarget"), second);
+	}
+
+	static boolean convertUnits(final AIController ai, final int qty, final int typeIdValue) {
+		final War3ID typeId = new War3ID(typeIdValue);
+		int converted = 0;
+		for (final CUnit unit : ai.simulation.getUnits()) {
+			if ((converted < qty) && ai.isArmyUnit(unit) && unit.getTypeId().equals(typeId)
+					&& unit.order(ai.simulation, OrderIdUtils.getOrderId("sphinxform"), null)) {
+				converted++;
+			}
+		}
+		return converted > 0;
+	}
+
+	static void unsummon(final AIController ai, final CUnit building) {
+		if ((building == null) || !ai.isOurs(building)) {
+			return;
+		}
+		final int unsummonOrder = OrderIdUtils.getOrderId("unsummon");
+		for (final CUnit unit : ai.simulation.getUnits()) {
+			if (ai.isOurs(unit) && !unit.isHidden() && unit.order(ai.simulation, unsummonOrder, building)) {
+				return;
+			}
+		}
+	}
+}
