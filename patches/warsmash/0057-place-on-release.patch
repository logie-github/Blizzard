+	/** A finger is down on the ground while a building is being placed: the order is given when it is lifted. */
+	private boolean buildPlacePending;
+
 	@Override
 	public boolean touchDown(final int screenX, final int screenY, final float worldScreenY, final int button) {
+		this.buildPlacePending = false;
+		if (this.userControlEnabled && (button == Input.Buttons.LEFT) && (this.activeCommand instanceof AbstractCAbilityBuild)
+				&& (this.draggingItem == null)) {
+			screenCoordsVector.set(screenX, screenY);
+			this.uiViewport.unproject(screenCoordsVector);
+			if (!this.meleeUIMinimap.containsMouse(screenCoordsVector.x, screenCoordsVector.y)
+					&& !(this.rootFrame.getFrameChildUnderMouse(screenCoordsVector.x,
+							screenCoordsVector.y) instanceof ClickableFrame)) {
+				// The footprint follows the finger; the building is placed where it is lifted.
+				previousTouchScreenX = screenX;
+				previousTouchScreenY = screenY;
+				previousWorldY = worldScreenY;
+				this.allowDrag = false;
+				this.buildPlacePending = true;
+				return true;
+			}
+		}
+		return touchDownNow(screenX, screenY, worldScreenY, button);
+	}
+
+	private boolean touchDownNow(final int screenX, final int screenY, final float worldScreenY, final int button) {
 		previousTouchScreenX = screenX;
 		previousTouchScreenY = screenY;
 		previousWorldY = worldScreenY;
